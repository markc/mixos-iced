[Unit]
Description=MixOS compositor on VT%i
Wants=noded@%i.service
Requires=seatd@%i.service
After=noded@%i.service seatd@%i.service
BindsTo=seatd@%i.service
PartOf=session@%i.target
Requires=session-dbus@%i.service
After=session-dbus@%i.service

[Service]
Type=simple
User=mixos
SupplementaryGroups=seat
EnvironmentFile=/etc/mixos/session/%i.env
UnsetEnvironment=DBUS_STARTER_ADDRESS DBUS_STARTER_BUS_TYPE DBUS_SYSTEM_BUS_ADDRESS
# The final, bus-owned file overrides even a profile-supplied host address.
EnvironmentFile=/run/mixos/session/%i/dbus/environment
Environment=LIBSEAT_BACKEND=seatd MIXOS_CONTAIN_CHILDREN=1
RuntimeDirectory=mixos/session/%i/desktop
RuntimeDirectoryMode=0700
ExecStart=/opt/mixos/bin/compd kms-live --socket ${WAYLAND_DISPLAY} --scale ${MIXOS_OUTPUT_SCALE} --config-file ${MIXOS_COMPD_CONFIG} --bus-service comp --scene-service shell
TTYPath=/dev/tty%i
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
Delegate=yes
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=1
