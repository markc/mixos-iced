-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Real offline installers and native apps lookup, with no distro icon tree.
$repo=dirname(dirname(dirname(dirname(realpath($0)))))
$mix=realpath("/proc/self/exe")
$tmp=trim(run_argv_must(["mktemp","-d","/tmp/mixos-desktop-icons.XXXXXXXX"]))
$share=$tmp+"/share"
export XDG_DATA_DIRS=$share
export XDG_DATA_HOME=$tmp+"/data"
$apps=require("../scripts/lib/apps.mix")
$models=require($repo+"/share/scenes/lib/models.mix")
fn check($condition,$message)
  if not $condition then raise("DESKTOP_ICONS",$message) end
end
try
  print(run_argv_must([$mix,$repo+"/tools/material_icons.mix","--check"]))
  print(run_argv_must([$mix,$repo+"/share/icons/install.mix","--root",$share]))
  print(run_argv_must([$mix,$repo+"/share/brand/install.mix","--root",$share]))
  print(run_argv_must([$mix,$repo+"/share/icons/install.mix","--root",$share,"--verify"]))
  $probe=$tmp+"/theme.mix"
  write_file($probe,"$a=require("+json_encode($repo+"/services/compd/scripts/lib/apps.mix")+")\nprint($a.default_theme())\n")
  check(trim(run_argv_must([$mix,$probe],{env:{HOME:$tmp}})) == "mixos","installed theme is selected without a host desktop")
  mkdir($tmp+"/.config")
  write_file($tmp+"/.config/kdeglobals","[Icons]\nTheme=user-theme\n")
  check(trim(run_argv_must([$mix,$probe],{env:{HOME:$tmp}})) == "user-theme","explicit existing theme preference is preserved")
  $ctx={icon_dirs:[$share+"/icons"],pixmaps:$tmp+"/pixmaps",cache:{}}
  for each $size in [20,28,32,48,128]
    for each $name in ["dev.mixos","notification-active-symbolic","notification-inactive-symbolic","audio-volume-muted-symbolic","audio-volume-high-symbolic","audio-volume-medium-symbolic","audio-volume-low-symbolic","network-wireless-signal-excellent-symbolic","network-wired-activated-symbolic","network-offline-symbolic","user-desktop-symbolic"]
      $hit=$apps.resolve_icon($ctx,$name,$size,1,"mixos")
      $ctx=$hit.ctx
      check($hit.hit != nil and ends_with($hit.hit.path,$name+".svg"),"real icon lookup at "+to_string($size)+": "+$name)
      check(contains(read_file($hit.hit.path),"<svg"),"lookup supplies SVG bytes")
    end
  end
  for each $app in ["term","ced","dopus","cap","scene-editor","busviewer"]
    $entry=ini_parse(read_file($repo+"/apps/"+$app+"/assets/dev.mixos."+$app+".desktop"))["Desktop Entry"]
    $hit=$apps.resolve_icon($ctx,$entry.Icon,32,1,"mixos")
    check($hit.hit != nil and ends_with($hit.hit.path,"-symbolic.svg"),"declared app icon resolves: "+$app)
  end
  for each $name in $models.PANEL_THEMED_ICONS
    if not starts_with($name,"start-here") then
      check($apps.resolve_icon($ctx,$name+"-symbolic",22,1,"mixos").hit != nil,"every published status name has a shipped symbolic icon: "+$name)
    end
  end
  -- Thinner sets are additive: distinct files, same names and shared mark.
  for each $weight in [300,200]
    $theme="mixos-"+to_string($weight)
    for each $pair in [{name:"dev.mixos.term-symbolic",source:"terminal"},{name:"dev.mixos.ced-symbolic",source:"edit_note"},{name:"dev.mixos.dopus-symbolic",source:"folder_open"},{name:"dev.mixos.cap-symbolic",source:"screenshot_monitor"},{name:"dev.mixos.scene-editor-symbolic",source:"desktop_windows"},{name:"dev.mixos.busviewer-symbolic",source:"settings_ethernet"},{name:"audio-volume-high-symbolic",source:"volume_up"}]
      $regular=$apps.resolve_icon($ctx,$pair.name,32,1,"mixos").hit.path
      $light=$apps.resolve_icon($ctx,$pair.name,32,1,$theme).hit.path
      check($regular != $light,"weights coexist at separate paths: "+$pair.name)
      check(hash_file($regular,"sha256") == hash_file($repo+"/share/icons/material/"+$pair.source+".svg","sha256"),"original 400 bytes are retained")
      check(hash_file($light,"sha256") == hash_file($repo+"/share/icons/material/"+to_string($weight)+"/"+$pair.source+".svg","sha256"),"lookup selects the thinner source")
      check(hash_file($regular,"sha256") != hash_file($light,"sha256"),"variants have different geometry")
    end
    for each $name in $models.PANEL_THEMED_ICONS
      if not starts_with($name,"start-here") then
        check(contains($apps.resolve_icon($ctx,$name+"-symbolic",22,1,$theme).hit.path,"/icons/"+$theme+"/"),"all status names resolve in the thinner theme")
      end
    end
  end
  $mark=$apps.resolve_icon($ctx,"dev.mixos",28,1,"mixos").hit.path
  for each $theme in ["mixos-300","mixos-200"]
    check($apps.resolve_icon($ctx,"dev.mixos",28,1,$theme).hit.path == $mark,"all weights share the unchanged cyclops")
  end
  check(hash_file($mark,"sha256") == hash_file($repo+"/share/brand/cyclops/cyclops.svg","sha256"),"launcher is the canonical cyclops vector")
  check(not ends_with(basename($mark),"-symbolic.svg"),"the cyclops is full colour, never a tinted symbolic")
  $model=$models.panel({windows:[],ws_count:1,ws_current:1},{themed:{"dev.mixos":$mark,"start-here-kde":"/old-kde.svg"}},0)
  check($model.launcher.has_icon and $model.launcher.icon == $mark,"the cyclops takes precedence over an existing KDE launcher")
  $old_index="[Icon Theme]\nName=Existing\nDirectories=48x48/apps\n\n[48x48/apps]\nSize=48\nType=Fixed\nContext=Applications\n"
  write_file($share+"/icons/hicolor/index.theme",$old_index)
  print(run_argv_must([$mix,$repo+"/share/brand/install.mix","--root",$share]))
  check(read_file($share+"/icons/hicolor/index.theme") == $old_index,"existing hicolor metadata is preserved")
  $uncached={icon_dirs:[$share+"/icons"],pixmaps:$tmp+"/pixmaps",cache:{}}
  check($apps.resolve_icon($uncached,"dev.mixos",28,1,"mixos").hit.path == $share+"/icons/mixos/symbolic/apps/dev.mixos.svg","the cyclops resolves even when existing hicolor omits symbolic/apps")
  -- Verify failure before publishing anything from a corrupted source bundle.
  print(run_argv_must(["cp","-a",$repo+"/share/icons",$tmp+"/corrupt"]))
  append_file($tmp+"/corrupt/material/volume_up.svg"," ")
  $bad=run_argv([$mix,$tmp+"/corrupt/install.mix","--root",$tmp+"/bad"],{stderr:"stdout"})
  check(not $bad.ok and contains($bad.stdout,"ICON_HASH") and not is_dir($tmp+"/bad/icons"),"corrupted bundle fails before installation")
  print("PASS offline Material/cyclops installers, scaled lookup, app entries, brand precedence and corruption refusal")
finally
  remove_dir($tmp)
end
