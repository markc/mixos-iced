[Unit]
Description=Native ABP broker for MixOS session %i
PartOf=session@%i.target
Requires=session-dbus@%i.service
After=session-dbus@%i.service

[Service]
Type=simple
User=mixos
EnvironmentFile=/etc/mixos/session/%i.env
UnsetEnvironment=DBUS_STARTER_ADDRESS DBUS_STARTER_BUS_TYPE DBUS_SYSTEM_BUS_ADDRESS
# The final, bus-owned file overrides even a profile-supplied host address.
EnvironmentFile=/run/mixos/session/%i/dbus/environment
RuntimeDirectory=mixos/session/%i/noded
RuntimeDirectoryMode=0711
ExecStart=/opt/mixos/bin/noded serve --no-monitor --no-log
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=1
