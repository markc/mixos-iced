[Unit]
Description=Native ABP broker for MixOS session %i
PartOf=session@%i.target

[Service]
Type=simple
User=mixos
EnvironmentFile=/etc/mixos/session/%i.env
UnsetEnvironment=DBUS_SESSION_BUS_ADDRESS DBUS_STARTER_ADDRESS DBUS_STARTER_BUS_TYPE DBUS_SYSTEM_BUS_ADDRESS
RuntimeDirectory=mixos/session/%i/noded
RuntimeDirectoryMode=0711
ExecStart=/opt/mixos/bin/noded serve --no-monitor --no-log
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=1
