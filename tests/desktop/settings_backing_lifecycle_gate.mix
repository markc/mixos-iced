-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Explicit owned render-only hardware gate; does not acquire a VT or seat.
if len(args()) != 4 then raise("ARGS","REPO FIXTURE_BINARY RENDER_NODE FRESH_ARTIFACT_DIRECTORY") end
$repo=args()[0]; $binary=args()[1]; $node=args()[2]; $directory=args()[3]
if not is_file($binary) then raise("BACKING_FIXTURE","Built renderer-owning fixture missing") end
$binary_hash=hash_file($binary,"sha256")
$result=run_argv_must([$binary,$node,$directory],{timeout:45,max_output:1000000})
$passed=json_parse(read_file($directory .. "/passed.json"))
if not $passed.actual_shared_gles_wgpu_backings or $passed.native_presentation_claimed or $passed.phases != 9 then
  raise("BACKING_FIXTURE","Actual shared-device lifecycle proof missing")
end
$receipts=[]
for each $label in ["depth-two-first","depth-two-swap","growth-three-preserves","depth-three-swap",
    "shrink-two-preserves","shrink-one-preserves","depth-one-fresh","resize-first-fresh","ensure-first-fresh"]
  $record=json_parse(read_file($directory .. "/" .. $label .. ".json"))
  $raw=$directory .. "/" .. $label .. ".rgba"
  if $record.phase != $label or not $record.same_observer or $record.pending then
    raise("BACKING_FIXTURE","Published backing pair unavailable: " .. $label)
  end
  $receipts=concat($receipts,[merge($record,{raw_sha256:hash_file($raw,"sha256")})])
end
write_file($directory .. "/acceptance.json",json_encode({
  source:trim(run_argv_must(["git","-C",$repo,"rev-parse","HEAD"])),
  source_tree:trim(run_argv_must(["git","-C",$repo,"rev-parse","HEAD^{tree}"])),
  binary_sha256:$binary_hash,requested_render_node:$node,adapter:read_file($directory .. "/adapter.txt"),
  phases:$receipts,stdout:$result,contract:"actual shared GLES/wgpu backing lifecycle; no native presentation or latency claim"}))
print(json_encode({passed:true,artifacts:$directory,binary_sha256:$binary_hash,phases:len($receipts)}))
