-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- One real owned broker/session, six simultaneous native apps plus Quoin.
-- Four exact acceptance frame/layout stamps; Ced/Scene Editor/Quoin capture
-- palette/boundary evidence remains explicitly different. No KMS claim.
if len(args()) < 2 or len(args()) > 3 then raise("ARGS","REPO BUILD_BIN_DIR [--output-scale]") end
if len(args()) == 3 and args()[2] != "--output-scale" then raise("ARGS","Unknown option") end
$repo=args()[0]; $bin=args()[1]; $mix=$bin .. "/mix"
export MIXOS_TEST_MIX=$mix
export COMPD_KEEP_RUN="1"
$n=require("nested_host_lib.mix")
$h=require("settings_host_lib.mix")
$f=require("settings_fixture_lib.mix")
$recovery=require("settings_recovery_lib.mix")
$product=require("settings_apps_lib.mix")
$pty=require("pty_host_lib.mix")
$pixels=require("capture_lib.mix")
$all=require("settings_all_apps_lib.mix")
$output_scale=require("settings_output_scale_lib.mix")
$binding={instance:"fixture",profile:"default"}
$R={run:nil,bus:nil,session:nil,children:[],owners:[],ok:false,serial:0,ced_tab:nil,ced_state:nil,scene_state:nil,rounds:[]}
$scale_receipts=[]
fn check($condition,$message) return $all.check($condition,$message) end
for each $name in ["mix","noded","settingsd","compd","editd","term","ced","busviewer","cap","dopus","scene-editor","testkit-screenshot","testkit-input-probe"]
  check(is_file($bin .. "/" .. $name),"Missing candidate " .. $name)
end
$pty.check_support()
fn rpc($service,$verb,$body)
  return $h.rpc($mix,$R.bus,$R.run.path,$service,$verb,$body)
end
fn comp($verb,$body) return rpc($R.session.service,$verb,$body) end
fn shell($verb,$body) return rpc("shell",$verb,$body) end
fn own($pid,$privileged)
  $R.children=concat($R.children,[{pid:$pid,privileged_launcher:$privileged}])
  return $pid
end
fn ready($service,$verb,$pid)
  $deadline=time()+15
  while time() < $deadline
    check(process_alive($pid),"Owned " .. $service .. " exited")
    $r=$h.call($mix,$R.bus,$R.run.path,$service,$verb,{})
    if $r.rc == 0 then return $r.result end
    sleep(0.05)
  end
  raise("READY",$service .. " did not register")
end
fn env_for($home)
  for each $dir in ["config","state","cache","data"]
    mkdir($home .. "/" .. $dir,{parents:true})
  end
  return merge($h.bus_env($R.bus,$R.run.path),{HOME:$home,MIXOS_APP_HOME:$home,
    XDG_CONFIG_HOME:$home .. "/config",XDG_STATE_HOME:$home .. "/state",
    XDG_CACHE_HOME:$home .. "/cache",XDG_DATA_HOME:$home .. "/data",
    XDG_DATA_DIRS:$R.run.path .. "/core",MIXOS_SHARE:$R.run.path .. "/core",
    MIXOS_SETTINGS_INSTANCE:"fixture",MIXOS_SETTINGS_PROFILE:"default",
    LIBGL_ALWAYS_SOFTWARE:"1",TERM_NOTIFY:"0",WGPU_BACKEND:"gl",
    SCENES_SERVICE:"scenes",SCENE_HOST:"shell"})
end
fn apply($changes,$label)
  $old=rpc("settingsd","settings.get",{binding:$binding}).snapshot
  $issued=time()
  $accepted=rpc("settingsd","settings.apply",{binding:$binding,expected_incarnation:$old.incarnation,
    expected_revision:$old.revision,operation_id:"all-apps-" .. $label,changes:$changes,reset:[]})
  $snapshot=rpc("settingsd","settings.get",{binding:$binding}).snapshot
  check($snapshot.incarnation == $old.incarnation and $snapshot.revision != $old.revision,"Batch did not advance authority")
  return {snapshot:$snapshot,issued:$issued,accept_reply_observed:time(),reply:$accepted}
end
fn launch($name,$label,$fixture)
  $R.serial=$R.serial+1
  $home=$R.run.path .. "/home-" .. $name .. "-" .. $label
  $ctx={mix:$mix,bus:$R.bus,bus_root:$R.run.path,root:$R.run.path .. "/owner-" .. $name .. "-" .. $label,
    service:if $name == "term" then "term" else $name .. "-" .. $label end}
  mkdir($ctx.root,{parents:true})
  $identity={run:"all-apps-" .. to_string(pid()),instance:$R.serial}
  $extra=env_for($home)
  if $fixture then $extra=merge($extra,{MIXOS_ACCEPTANCE_RUN:$identity.run,MIXOS_ACCEPTANCE_INSTANCE:to_string($identity.instance)}) end
  $env=$n.client_env($R.session,$extra)
  $argv=if $name == "term" then $pty.launch_argv($bin,$env)
    elif $name == "ced" then [$bin .. "/ced","--service",$ctx.service,$R.run.path .. "/document.txt"]
    elif $name == "dopus" then [$bin .. "/dopus","--service",$ctx.service,"--noded-url",$R.bus.url,"--",$R.run.path .. "/left",$R.run.path .. "/right"]
    elif $name == "cap" then [$bin .. "/cap","--service",$ctx.service,"--comp",$R.session.service,$R.run.path .. "/source.png"]
    elif $name == "scene-editor" then [$bin .. "/scene-editor","--service",$ctx.service,"--comp",$R.session.service,"mixos-scene-editor:installed/calendar"]
    else [$bin .. "/busviewer","--service",$ctx.service,"--comp",$R.session.service] end
  $launcher=own(spawn($argv,{env:$env,stdout:{file:$ctx.root .. "/app.log"},stderr:"stdout",detach:true}),$name == "term")
  comp("comp.window.wait",{match:{app_id:"dev.mixos." .. $name},until:"mapped",timeout_ms:15000})
  $deadline=time()+10; $row=nil
  while time() < $deadline
    $rows=filter(comp("comp.windows.list",{}).windows,fn($w)=$w.app_id == "dev.mixos." .. $name and ($name == "term" or $w.pid == $launcher))
    if len($rows) == 1 then
      $row=comp("comp.window.wait",{match:{id:$rows[0].id,generation:$rows[0].generation},until:"presented",timeout_ms:5000}).window
      if $row != nil then break end
    end
    sleep(0.05)
  end
  check($row != nil and $row.pid != nil and ($name == "term" or $row.pid == $launcher),"Wrong actual launched owner")
  if $name == "term" then own($row.pid,false) end
  $app={name:$name,pid:$row.pid,launcher:$launcher,window:{id:$row.id,generation:$row.generation},
    context:$ctx,identity:$identity,settings_context:"app:" .. $name,fixture:$fixture,work_root:$R.run.path,
    version:toml_parse(read_file($repo .. "/apps/" .. $name .. "/Cargo.toml")).package.version,
    desktop:{mix:$mix,bus:$R.bus,root:$R.run.path,service:$R.session.service}}
  $R.owners=concat($R.owners,[$app])
  return $app
end
fn owner($name)
  return filter($R.owners,fn($o)=$o.name == $name)[0]
end
fn descriptions($batch,$label)
  $receipts=[]
  for each $app in $R.owners
    $description=$all.current($app.context,$app.pid,$batch.snapshot,$binding,$app.settings_context,15)
    write_file($app.context.root .. "/description-" .. $label .. ".json",json_encode($description))
    $all.canonical($description,$app,$batch.snapshot,$binding,$manifest,$manifest_digest)
    $observed=time()
    $receipts=concat($receipts,[{name:$app.name,pid:$app.pid,service:$app.context.service,
      current:$description.settings.current,applied:$description.settings.applied,
      resources:$description.resources,observation_upper_bound_ms:($observed-$batch.issued)*1000,
      latency_kind:"authority call issued to sequential current/applied observation upper bound"}])
  end
  check(time()-$batch.issued < 180,"Shared authority observation exceeded bounded 180-second phase")
  return $receipts
end
fn simultaneously_alive()
  $windows=comp("comp.windows.list",{}).windows
  for each $app in $R.owners
    check(process_alive($app.pid),"Concurrent owner exited: " .. $app.name)
    if $app.name != "quoin" then
      check(len(filter($windows,fn($w)=$w.id == $app.window.id and $w.generation == $app.window.generation and $w.pid == $app.pid)) == 1,"Concurrent window replaced: " .. $app.name)
    end
  end
  return $windows
end
fn observe_frames($label)
  $receipts=[]
  for each $app in $R.owners
    if $app.fixture then
      comp("comp.window.focus",$app.window)
      $description=$f.rpc($app.context,"app.describe",{})
      $frame=$recovery.observe($app.context,$app.identity,$description,$label)
      $receipts=concat($receipts,[{name:$app.name,pid:$app.pid,kind:"exact native target/stamp presentation and actual root layout",frame:$frame}])
    end
  end
  return $receipts
end
fn capture_palette($app,$snapshot,$label,$width,$sample_x)
  -- A known real magenta client is raised first, then the owned client. Its
  -- pixels just outside the new width fence this stage's configure/buffer.
  comp("comp.window.focus",$background_window)
  comp("comp.window.focus",$app.window)
  comp("comp.window.place",merge($app.window,{x:0,y:0,width:$width,height:600}))
  check(comp("comp.window.wait",{match:$app.window,until:"size",width:$width,height:600,timeout_ms:5000}).window != nil,"Client width did not commit")
  $path=$app.context.root .. "/palette-" .. $label .. ".ppm"
  $wanted=$snapshot.effective[$app.settings_context].design.pairs.base.rendered_surface
  $deadline=time()+8
  $receipt=nil
  while time() < $deadline
    run_argv_must([$bin .. "/testkit-screenshot",$path],{timeout:10,env:$n.client_env($R.session,{})})
    $image=$pixels.ppm($path)
    $inside=$pixels.pixel($image,$width-2,400)
    $outside=$pixels.pixel($image,$width+2,400)
    $sample=$pixels.pixel($image,$sample_x,400)
    $matches=abs($outside[0]-255) <= 3 and $outside[1] <= 3 and abs($outside[2]-255) <= 3
    for $channel=0 to 2
      if abs($inside[$channel]-$pixels.srgb($wanted[$channel])) > 8 or abs($sample[$channel]-$pixels.srgb($wanted[$channel])) > 8 then $matches=false end
    end
    if $matches then $receipt={kind:"native palette plus distinct configure/buffer boundary",path:$path,width:$width,palette:$sample,inside:$inside,outside:$outside}; break end
    sleep(0.05)
  end
  check($receipt != nil,"Native palette/boundary did not settle: " .. $app.name)
  check(deep_eq($f.rpc($app.context,"app.describe",{}).settings.applied,$h.identity($snapshot)),"Authority changed during native capture")
  write_file($app.context.root .. "/palette-" .. $label .. ".json",json_encode($receipt))
  return $receipt
end
fn quoin_capture($snapshot,$label,$scene)
  $layout=shell("shell.scene.layout",{scene:$scene})
  check($layout.visible and $layout.nodes.go != nil,"Actual Quoin button missing")
  $token=nil
  for each $candidate in $snapshot.effective.desktop.design.buttons
    if $candidate.variant == "primary" and $candidate.size == "md" and $candidate.interaction == "resting" and not $candidate.focus_visible then $token=$candidate end
  end
  check($token != nil and $token.pair.surface[3] == 1,"No opaque primary token")
  $path=$R.run.path .. "/quoin-" .. $label .. ".ppm"
  $deadline=time()+8; $receipt=nil
  while time() < $deadline
    $layout=shell("shell.scene.layout",{scene:$scene})
    run_argv_must([$bin .. "/testkit-screenshot",$path],{timeout:10,env:$n.client_env($R.session,{})})
    $image=$pixels.ppm($path)
    $go=$layout.nodes.go
    $sample=$pixels.pixel($image,$layout.surface.x+$go.x+8,$layout.surface.y+$go.y+8)
    $matches=true
    for $channel=0 to 2
      if abs($sample[$channel]-$pixels.srgb($token.pair.surface[$channel])) > 8 then $matches=false end
    end
    if $matches then $receipt={kind:"actual Quoin layout and native primary palette",layout:$layout,path:$path,palette:$sample}; break end
    sleep(0.05)
  end
  check($receipt != nil,"Quoin palette did not match common authority")
  check(deep_eq(shell("app.describe",{}).settings.applied,$h.identity($snapshot)),"Quoin changed during capture")
  return $receipt
end
fn scene_document($name,$citizen)
  return "---\nscene: 1\nname: " .. $name .. "\ncitizen: " .. $citizen .. "\nwindow: {\"kind\":\"edge\",\"edge\":\"bottom\",\"h\":72}\n---\n```mix\nroot: {widget: \"row\", padding: 4, fill: true, children: [\"go\"]}\ngo: {widget: \"button\", label: \"Go\", tone: \"primary\", width: 160, on_click: \"go\"}\n```\n"
end
fn retained($label)
  for each $app in $R.owners
    if $app.fixture and $app.product != nil then $product.product_retained($app,$app.product,$label) end
  end
  $ced=owner("ced")
  $after=$f.rpc($ced.context,"ced.state",{tab:$R.ced_tab,text:true})
  check($R.ced_state.buffer == $after.buffer and $R.ced_state.rev == $after.rev and
    $R.ced_state.text == $after.text and deep_eq($R.ced_state.selection,$after.selection),"Ced text/caret changed")
  $editor=owner("scene-editor")
  $after=$f.rpc($editor.context,"scene-editor.info",{})
  check(deep_eq($R.scene_state.selection,$after.selection) and $after.ui.dialog == "confirm" and
    deep_eq($R.scene_state.ui.confirmation,$after.ui.confirmation),"True Scene Editor selection/confirmation changed")
  write_file($R.run.path .. "/product-special-" .. $label .. ".json",json_encode({ced:$f.rpc($ced.context,"ced.state",{tab:$R.ced_tab,text:true}),scene_editor:$after}))
end
try
  $R.run=$n.new_run("/var/tmp/settings-all-apps")
  $root=$R.run.path
  mkdir($root .. "/core",{parents:true})
  run_argv_must([$mix,$repo .. "/share/assets/install.mix","--root",$root .. "/core/assets","--manifest",$repo .. "/share/assets/core.conf.mix"],{timeout:300,max_output:2000000})
  run_argv_must([$mix,$repo .. "/share/assets/install.mix","--root",$root .. "/core/assets","--manifest",$repo .. "/share/assets/core.conf.mix","--verify"],{timeout:30})
  $manifest=load_data($repo .. "/share/assets/core.conf.mix")
  $manifest_digest=hash_file($root .. "/core/assets/current/manifest.conf.mix","blake3")
  check($manifest_digest == hash_file($repo .. "/share/assets/core.conf.mix","blake3"),"Installed core manifest differs")
  $R.bus=$n.private_bus({dir:$root,name:"settings-all-apps",noded:$bin .. "/noded"})
  run_argv_must([$bin .. "/settingsd","seed","--allow-create","--instance","fixture","--root",$root .. "/profile"],{timeout:30})
  $authority=own(spawn([$bin .. "/settingsd","serve","--instance","fixture","--root",$root .. "/profile"],{env:env_for($root .. "/authority-home"),stdout:{file:$root .. "/settingsd.log"},stderr:"stdout",detach:true}),false)
  ready("settingsd","settings.describe",$authority)
  $light=apply({"appearance.mode":"light","ui.text_scale":1.0,"ui.density":1.0,"shell.panels.bottom":{edge:"bottom",mode:"overlay",thickness:72}},"initial-light")
  mkdir($root .. "/cfg",{parents:true})
  write_file($root .. "/cfg/settings.json",read_file($repo .. "/tests/desktop/smoke-settings.json"))
  write_file($root .. "/cfg/preferences.json",json_encode({scene_host:true,scene_service:"all-apps-fallback",decorations_ssd:false}))
  $R.session=$n.start({bin:$bin .. "/compd",tag:"all-apps",run:$R.run,config:$root .. "/cfg/settings.json",
    host_renderer:"pixman",software:true,scale:1,max_secs:900,env:env_for($root .. "/compositor-home")})
  check($n.wait_ready($R.session,30),"Owned compositor did not register")
  ready("shell","shell.info",$R.session.comp_pid)
  check(shell("shell.info",{}).service == "shell","Real Quoin host failed canonical registration")
  comp("comp.props.set",{path:"input.host.passthrough",value:false})
  $outputs=comp("comp.props.get",{path:"outputs"})
  check(len(keys($outputs)) == 1,"Expected one owned output")
  $output=$outputs[keys($outputs)[0]]
  check($output.width >= 1100 and $output.height >= 700,"Palette boundary proof needs 1100x700 output")
  $R.owners=concat($R.owners,[{name:"quoin",pid:$R.session.comp_pid,settings_context:"desktop",fixture:false,
    version:toml_parse(read_file($repo .. "/services/compd/Cargo.toml")).package.version,
    context:{mix:$mix,bus:$R.bus,bus_root:$root,root:$root,service:"shell"}}])
  $edit=own(spawn([$bin .. "/editd","serve"],{env:env_for($root .. "/edit-home"),stdout:{file:$root .. "/editd.log"},stderr:"stdout",detach:true}),false)
  ready("edit","edit.ping",$edit)
  mkdir($root .. "/scenes",{parents:true})
  $scenes=own(spawn([$mix,"--serve",$repo .. "/services/compd/scripts/scenes.mix","--name","scenes"],
    {env:merge(env_for($root .. "/scenes-home"),{SCENES_DIR:$root .. "/scenes",SCENES_TEMPLATES:$repo .. "/share/scenes",SCENES_LIB:$repo .. "/share/scenes/lib",SCENE_HOST:"shell",SCENES_FIRST_RUN:"0",SCENES_EDITOR_APP:"1",SCENE_EDITOR_SERVICE:"scene-editor-main"}),stdout:{file:$root .. "/scenes.log"},stderr:"stdout",detach:true}),false)
  ready("scenes","scenes.list",$scenes)
  check(rpc("scenes","scenes.install",{template:"calendar",enable:false}).installed,"Real calendar did not install")
  write_file($root .. "/controls.mix","on go\n append_file(" .. json_encode($root .. "/controls-events.jsonl") .. ",json_encode($event.args) .. \"\\n\")\n reply(\"ok\")\nend\n")
  write_file($root .. "/controls-events.jsonl","")
  $citizen=own(spawn([$mix,"--serve",$root .. "/controls.mix","--name","all-apps-controls"],{env:env_for($root .. "/controls-home"),stdout:{file:$root .. "/controls.log"},stderr:"stdout",detach:true}),false)
  ready("all-apps-controls","HELP",$citizen)
  shell("shell.scene.load",{source:scene_document("all-apps-control","all-apps-controls")})
  $deadline=time()+10
  $panel=nil
  while time() < $deadline
    $panel=shell("shell.panel.state",{edge:"bottom"})
    if $panel.mode == "pinned" and $panel.settings != nil and $panel.settings.presented_px == 72 then break end
    $panel=nil
    sleep(0.05)
  end
  check($panel != nil,"Settings-owned bottom panel did not become pinned")
  shell("shell.panel.page.set",{edge:"bottom",id:"scene-all-apps-control"})
  for each $dir in ["left","right"] mkdir($root .. "/" .. $dir,{parents:true}) end
  write_file($root .. "/left/owned-file.txt","simultaneous native file\n")
  write_file($root .. "/document.txt","simultaneous native Ced text\n")
  copy($repo .. "/share/brand/favicons/white-on-black/icon-512.png",$root .. "/source.png")
  for each $name in ["term","busviewer","cap","dopus","ced","scene-editor"]
    $app=launch($name,"main",contains(["term","busviewer","cap","dopus"],$name))
    $all.current($app.context,$app.pid,$light.snapshot,$binding,$app.settings_context,15)
    if $app.fixture then
      $state=$product.prepare_product($app)
      $updated=merge($app,{product:$state})
      $R.owners=map($R.owners,fn($o)=if $o.pid == $app.pid then $updated else $o end)
    end
  end
  $ced=owner("ced")
  $tabs=$f.rpc($ced.context,"ced.tabs",{}).tabs
  check(len($tabs) == 1,"Ced document not opened exactly once")
  $R.ced_tab=$tabs[0].tab
  $f.rpc($ced.context,"ced.wait",{tab:$R.ced_tab,phase:"live",timeout_ms:10000})
  $f.rpc($ced.context,"ced.select",{tab:$R.ced_tab,anchor:5,head:5})
  $R.ced_state=$f.rpc($ced.context,"ced.state",{tab:$R.ced_tab,text:true})
  $editor=owner("scene-editor")
  $f.rpc($editor.context,"scene-editor.show",{view:"installed",scene:"calendar"})
  $deadline=time()+15; $selected=nil
  while time() < $deadline
    $selected=$f.rpc($editor.context,"scene-editor.info",{})
    if not $selected.busy and $selected.snapshot != nil and $selected.snapshot.host_problem == nil and $selected.selection.scene == "calendar" and $selected.selection.view == "installed" then break end
    $selected=nil; sleep(0.05)
  end
  check($selected != nil,"True Scene Editor calendar selection unavailable")
  comp("comp.window.focus",$editor.window)
  for each $key in ["F10","Right","Right","End","Return"] comp("comp.input.key",{seat:"human",window:$editor.window,key:$key}) end
  $deadline=time()+5; $confirm=nil
  while time() < $deadline
    $confirm=$f.rpc($editor.context,"scene-editor.info",{})
    if $confirm.ui.dialog == "confirm" and $confirm.ui.confirmation != nil then break end
    $confirm=nil; sleep(0.05)
  end
  check($confirm != nil and $confirm.ui.confirmation.action.action == "remove" and $confirm.ui.confirmation.selection.scene == "calendar","Actual frozen remove confirmation missing")
  $R.scene_state=$confirm
  $probe=own(spawn([$bin .. "/testkit-input-probe","--app-id","dev.mixos.AllAppsBoundary","--size",to_string($output.width) .. "x" .. to_string($output.height-72),"--seconds","900","--colour","ff00ff"],{env:$n.client_env($R.session,{}),stdout:{file:$root .. "/boundary.log"},stderr:"stdout",detach:true}),false)
  $row=comp("comp.window.wait",{match:{app_id:"dev.mixos.AllAppsBoundary"},until:"presented",timeout_ms:5000}).window
  $background_window={id:$row.id,generation:$row.generation}
  comp("comp.window.place",merge($background_window,{x:0,y:0,width:$output.width,height:$output.height-72}))
  $batches=[$light]
  for each $round in [{label:"light",changes:nil},{label:"dark-scaled",changes:{"appearance.mode":"dark","ui.text_scale":1.25,"ui.density":1.2}},{label:"light-dense",changes:{"appearance.mode":"light","ui.text_scale":1.1,"ui.density":0.9}}]
    $batch=if $round.changes == nil then $light else apply($round.changes,$round.label) end
    $descriptions=descriptions($batch,$round.label)
    simultaneously_alive()
    retained($round.label)
    $frames=observe_frames($round.label)
    $width=1000+len($R.rounds)*2
    $ced_palette=capture_palette($ced,$batch.snapshot,$round.label,$width,200)
    $editor_palette=capture_palette($editor,$batch.snapshot,$round.label,$width+1,5)
    $quoin_palette=quoin_capture($batch.snapshot,$round.label,"all-apps-control")
    $R.rounds=concat($R.rounds,[{label:$round.label,identity:$h.identity($batch.snapshot),owners:$descriptions,frames:$frames,
      ced:$ced_palette,scene_editor:$editor_palette,quoin:$quoin_palette,
      observation_upper_bound_ms:(time()-$batch.issued)*1000,latency_kind:"sequential observation and capture upper bound; no percentiles"}])
  end
  -- A newly created app/control resolves the changed authority while all
  -- original citizens remain alive and retain their genuine product state.
  if len(args()) == 3 then
    check(is_file($bin .. "/testkit-ssd-client"),"Missing actual fractional protocol observer")
    $scale_log=$root .. "/scale-observer.log"
    $scale_pid=own(spawn([$bin .. "/testkit-ssd-client","--report-scale","--mode","none","--size","200x100"],
      {env:$n.client_env($R.session,{}),stdout:{file:$scale_log},stderr:"stdout",detach:true}),false)
    $scale_row=comp("comp.window.wait",{match:{app_id:"testkit-ssd-client"},until:"presented",timeout_ms:5000}).window
    check($scale_row.pid == $scale_pid,"Fractional observer window belongs to another client")
    $scale_window={id:$scale_row.id,generation:$scale_row.generation}
    comp("comp.window.place",merge($scale_window,{x:600,y:20,width:200,height:100}))
    $scale_observer={pid:$scale_pid,window:$scale_window,log:$scale_log}
    $scale_context={mix:$mix,bus:$R.bus,root:$root,service:$R.session.service,binding:$binding,event_wait:$repo .. "/tests/desktop/settings_output_scale_event_wait.mix"}
    $scale_receipts=$output_scale.phase($scale_context,$R.session,$bin,$ced,$R.ced_tab,$background_window,$scale_observer)
    simultaneously_alive()
    retained("output-scale-restored")
  end
  $late=launch("busviewer","late",true)
  $changed=rpc("settingsd","settings.get",{binding:$binding}).snapshot
  $late_description=$all.current($late.context,$late.pid,$changed,$binding,$late.settings_context,15)
  write_file($late.context.root .. "/description-late.json",json_encode($late_description))
  $all.canonical($late_description,$late,$changed,$binding,$manifest,$manifest_digest)
  comp("comp.window.focus",$late.window)
  $late_frame=$recovery.observe($late.context,$late.identity,$late_description,"late")
  $late_citizen=own(spawn([$mix,"--serve",$root .. "/controls.mix","--name","all-apps-late-controls"],{env:env_for($root .. "/late-controls-home"),stdout:{file:$root .. "/late-controls.log"},stderr:"stdout",detach:true}),false)
  ready("all-apps-late-controls","HELP",$late_citizen)
  shell("shell.scene.load",{source:scene_document("all-apps-late-control","all-apps-late-controls")})
  shell("shell.panel.page.set",{edge:"bottom",id:"scene-all-apps-late-control"})
  $late_control=quoin_capture($changed,"late","all-apps-late-control")
  $offset=bytes_len(string_to_bytes(read_file($root .. "/controls-events.jsonl")))
  $go=$late_control.layout.nodes.go
  comp("comp.input.pointer.move",{seat:"human",x:$late_control.layout.surface.x+$go.x+$go.w/2,y:$late_control.layout.surface.y+$go.y+$go.h/2})
  comp("comp.input.pointer.button",{seat:"human",button:"left",action:"click"})
  $deadline=time()+5; $click=nil
  while time() < $deadline
    $fresh=slice(read_file($root .. "/controls-events.jsonl"),$offset)
    if trim($fresh) != "" then
      $click=json_parse(lines(trim($fresh))[0]); break
    end
    sleep(0.05)
  end
  check($click != nil and $click.scene == "all-apps-late-control" and $click.node == "go" and $click.kind == "click","New actual Quoin control did not dispatch native input")
  $late_control=merge($late_control,{click:$click})
  simultaneously_alive()
  retained("late")
  $inventory=rpc("noded","noded.inventory",{})
  $binary_hashes=[]
  for each $name in ["mix","noded","settingsd","compd","editd","term","ced","busviewer","cap","dopus","scene-editor","testkit-screenshot","testkit-input-probe"]
    $binary_hashes=concat($binary_hashes,[{binary:$name,sha256:hash_file($bin .. "/" .. $name,"sha256")}])
  end
  write_file($root .. "/acceptance.json",json_encode({source:trim(run_argv_must(["git","-C",$repo,"rev-parse","HEAD"])),
    source_tree:trim(run_argv_must(["git","-C",$repo,"rev-parse","HEAD^{tree}"])),binary_hashes:$binary_hashes,broker:{pid:$R.bus.pid,url:$R.bus.url},
    compositor:{pid:$R.session.comp_pid,service:$R.session.service,backend:"nested"},native_inventory:$inventory,
    all_six_simultaneous:true,quoin:true,core_set:$manifest.set_id,core_manifest_blake3:$manifest_digest,rounds:$R.rounds,
    new_app:{pid:$late.pid,description:$late_description,frame:$late_frame},new_control:$late_control,
    output_scale:$scale_receipts,
    hardware:false,percentiles:false,exact_frame_participants:["term","busviewer","cap","dopus"],
    palette_boundary_participants:["ced","scene-editor"],quoin_palette_layout:true}))
  $R.ok=true
catch $message
  print("FAIL simultaneous settings: " .. $message)
finally
  for each $child in $R.children
    try check($pty.stop_child($child),"Owned child survived teardown") catch $error
      $R.ok=false; print("FAIL owned teardown: " .. $error)
    end
  end
  if $R.session != nil then
    try
      $n.stop($R.session)
      for each $child in $R.session.pids $h.stop($child) end
    catch $error $R.ok=false; print("FAIL session teardown: " .. $error) end
  end
  if $R.bus != nil then
    try $h.stop($R.bus.pid) catch $error $R.ok=false; print("FAIL broker teardown: " .. $error) end
  end
  $n.finish_run($R.run,$R.ok)
end
if not $R.ok then exit(1) end
print("PASS simultaneous six-app+Quoin shared authority, complete core resources, retained products, distinct native frame/palette evidence and late app/control; nested evidence only")
