#!/usr/bin/env mix
-- version: 0.3.0
-- comp_region_select_gate.mix — acceptance gate for comp.region.select and
-- comp.region.cancel: it starts a PRIVATE nested compd on nested_host_lib's
-- headless weston host.
--
-- usage: mix tests/desktop/comp_region_select_gate.mix [--bin PATH]
--        --config-file PATH [--env NAME=VALUE ...] [--software] [--keep-log]
--
-- WHAT IT PROVES. comp.region.select is an interactive rubber-band selector
-- that must answer a Bus caller with the rectangle a pointer drew. Because compd
-- also exposes comp.input.pointer.{move,button} and comp.input.key, the
-- whole interaction can be driven over ABP with no human hand — which is the
-- point: a verb a human must service is not agent-operable, and this gate is
-- the proof that it is not one.
--
-- The cancellation arms prove the owner-scoped comp.region.cancel on the
-- real instance path: an identified selection is cancelled through the
-- ordinary finish (its original select reply answers cancelled and echoes
-- the identity), a repeated cancel is already_finished, a delayed old
-- cancel never stops a newer selection, a cancel-before-select retires the
-- delayed select, a stale compositor instance is refused without mutating
-- owner state, and an unrelated owner or a newer generation never cancels
-- the active run. Legacy identity-less selections keep their old shape and
-- are covered by the original arms.
--
-- The closing arms prove the select-side fence and the effects the ordinary
-- finish path must have, with the real testkit probes (never an inference
-- from the busy window): a stale SELECT is refused before any reservation
-- and the live identity still admits — no resurrection after a restart; a
-- screencopy shows the overlay drawn while the run holds the seat and gone
-- after the cancelled reply (the clean-frame rule); a real test client
-- window's keyboard focus is displaced during the run and restored by the
-- cancel; and a session lock beginning mid-run ends the selection `locked`
-- with the identity echoed, leaving the region idle, the next generation
-- admissible and the locked generation retired.
--
-- HOW IT DRIVES A BLOCKING VERB. `send` is a blocking RPC, so the selection
-- cannot be started and driven from one script. Each arm spawns a SELECTOR
-- process (mix -c) that issues comp.region.select and writes its reply to a
-- file; the gate then drives the pointer and reads the file back. A selector
-- that never writes its file is a FAILURE, not a pass — an absent answer and a
-- correct answer must never look alike.
--
-- THE FAIL ARM HAS BEEN WATCHED. Against a compositor WITHOUT the verb, every
-- arm reports `unknown verb` and the gate exits 1. Run it against a build
-- without the verb once before trusting a green: a gate nobody has watched
-- fail is not yet a gate, and neither is one nobody has watched pass.

$n = require("nested_host_lib.mix")
$CLEANUP = {ok: false, run: nil}
try
$KIND = "compd"
$BIN = ""
$CONFIG = ""
$ENV = {}
$SOFTWARE = false

$ARGS = args()
$i = 0
while $i < len($ARGS)
  $a = $ARGS[$i]
  if $a == "--bin" and $i + 1 < len($ARGS) then
    $i = $i + 1
    $BIN = $ARGS[$i]
  elif $a == "--config-file" and $i + 1 < len($ARGS) then
    $i = $i + 1
    $CONFIG = $ARGS[$i]
  elif $a == "--env" and $i + 1 < len($ARGS) and contains($ARGS[$i + 1], "=") then
    $i = $i + 1
    $kv = split_once($ARGS[$i], "=")
    $ENV[$kv[0]] = $kv[1]
  elif $a == "--software" then
    $SOFTWARE = true
  elif $a == "--keep-log" then
    -- Accepted for compatibility; failed runs always keep their evidence.
    print("  --keep-log: artefacts are kept only on failure or abort")
  else
    print("comp_region_select_gate: unknown argument: " .. $a)
    print("usage: comp_region_select_gate.mix [--bin PATH] --config-file PATH [--env NAME=VALUE ...] [--software] [--keep-log]")
    exit(2)
  end
  $i = $i + 1
end

$bin = $n.require_binary("compd", $BIN, ["/opt/compd/bin"])
$CLEANUP.run = $n.new_run("/tmp/" .. $KIND .. "-region-" .. to_string(pid()))
$SESSION = $n.start({bin: $bin, tag: "region", run: $CLEANUP.run, config: $CONFIG, env: $ENV, software: $SOFTWARE})
if not $n.wait_ready($SESSION, 30) then
  print("  ERROR: nested " .. $KIND .. " did not answer " .. $SESSION["service"] .. ".comp.ping (log " .. $SESSION["log"] .. ")")
  $n.stop($SESSION)
  exit(1)
end
$COMP = $SESSION["service"]
$DIR = $SESSION["runtime"] .. "/region-gate"

-- The testkit probes the focus, overlay and lock arms drive: built with the
-- compd under test, so the one beside its binary wins over an installed
-- copy (a probe can predate the flags a gate needs).
$PROBE_DIRS = [dirname($bin)]
if not contains($PROBE_DIRS, "/opt/compd/bin") then
  push($PROBE_DIRS, "/opt/compd/bin")
end
$SSD = $n.binary("testkit-ssd-client", "", $PROBE_DIRS)
$SHOT = $n.binary("testkit-screenshot", "", $PROBE_DIRS)
$LOCK = $n.binary("testkit-lock-client", "", $PROBE_DIRS)
if $SSD == "" or $SHOT == "" or $LOCK == "" then
  print("  REFUSE: arms 13-15 need the testkit probes (testkit-ssd-client, testkit-screenshot, testkit-lock-client) beside " .. $bin .. " or in /opt/compd/bin")
  $n.stop($SESSION)
  exit(2)
end
$CENV = $n.client_env($SESSION, {})

$FAILURES = []

fn note($msg)
  print("  " .. $msg)
  return 0
end

fn fail($arm, $why)
  print("  FAIL [" .. $arm .. "] " .. $why)
  return 0
end

fn rpc($verb, $payload, $timeout)
  send $COMP $verb body=json_encode($payload) timeout=$timeout
  if $rc != 0 then return {ok: false, rc: $rc, body: to_string($result)} end
  $parsed = nil
  try
    $parsed = json_parse(to_string($result))
  catch $e
    $parsed = nil
  end
  return {ok: true, rc: 0, body: to_string($result), value: $parsed}
end

-- Start a selection in its own process. Returns the path its reply lands in.
fn start_selector($tag, $payload)
  $path = $DIR .. "/" .. $tag .. ".json"
  try
    remove($path)
  catch $e
    $ignored = 0
  end
  -- The target goes through a VARIABLE, never inline: a bare `send comp-rs ...`
  -- parses the hyphen as subtraction ("cannot use 'comp' as number"), so any
  -- hyphenated service name -- which is every nested dev instance -- breaks a
  -- literal send. Same reason the verb is bound rather than written inline.
  -- RETRY ON BUSY. A selection holds its run open past its own reply, until the
  -- overlay's removal is evidenced, and refuses `busy` for that window -- so a
  -- caller that selects again immediately is legitimately refused. Probing for
  -- readiness beforehand cannot fix this, because the probe is itself a
  -- selection and re-arms the same window; the only correct shape is what a real
  -- caller must do, which is retry. The gate does it here so every arm measures
  -- the verb rather than the gap between arms.
  $src = "$t = " .. json_encode($COMP) .. "\n" ..
    "$v = \"comp.region.select\"\n" ..
    "$n = 0\n" ..
    "while $n < 20\n" ..
    "  send $t $v body=" .. json_encode(json_encode($payload)) .. " timeout=90\n" ..
    "  if $rc == 0 then\n" ..
    "    break\n" ..
    "  end\n" ..
    "  if not contains(to_string($result), \"busy\") then\n" ..
    "    break\n" ..
    "  end\n" ..
    "  sleep(0.4)\n" ..
    "  $n = $n + 1\n" ..
    "end\n" ..
    -- $result comes back DECODED (a map), not as a JSON string, so the first
    -- cut's to_string($result) wrote Mix's map rendering -- `{status: selected,
    -- ...}`, unquoted keys -- which json_parse then refused, failing every arm
    -- against a verb that was answering correctly. Nest the value and let
    -- json_encode do it properly.
    "write_file(" .. json_encode($path) .. ", json_encode({rc: $rc, body: $result}))\n"
  $script = $DIR .. "/" .. $tag .. ".mix"
  write_file($script, $src)
  spawn(["/opt/mixos/bin/mix", $script], {detach: false})
  return $path
end

-- Wait for a selector's reply file. nil = it never answered, which is a
-- failure in every arm: no arm of this gate treats silence as success.
fn await_selector($path, $deadline_s)
  $deadline = time() + $deadline_s
  while time() < $deadline
    if is_file($path) then
      sleep(0.1)
      try
        $raw = json_parse(read_file($path))
        -- body is a nested object for a structured reply and a plain string for
        -- an error body; accept either rather than assuming one.
        $inner = nil
        if type($raw.body) == "map" then
          $inner = $raw.body
        else
          try
            $inner = json_parse(to_string($raw.body))
          catch $e2
            $inner = nil
          end
        end
        return {rc: $raw.rc, body: to_string($raw.body), value: $inner}
      catch $e
        return nil
      end
    end
    sleep(0.1)
  end
  return nil
end

-- The real contracts, read from port.rs rather than assumed (the first cut of
-- this gate invented `comp.input.pointer.teleport` and a `pressed` boolean;
-- neither exists). Absolute motion is pointer.move with x/y -- `corners: false`
-- keeps a drag to a screen edge from arming a hot corner mid-gate. Press and
-- release are the `action` field; omitting it means BOTH, i.e. a full click,
-- which would collapse a drag into a single click at the start point.
fn point($x, $y)
  return rpc("comp.input.pointer.move", {seat: "human", x: $x, y: $y, corners: false}, 5)
end

fn button($btn, $action)
  return rpc("comp.input.pointer.button", {seat: "human", button: $btn, action: $action}, 5)
end

fn key($name, $action)
  return rpc("comp.input.key", {seat: "human", key: $name, action: $action}, 5)
end

-- Drag from (x1,y1) to (x2,y2) with an intermediate move, so the arm proves a
-- real drag and not a single click that happens to carry two coordinates.
fn drag($x1, $y1, $x2, $y2)
  point($x1, $y1)
  sleep(0.1)
  button("left", "press")
  sleep(0.1)
  point(($x1 + $x2) / 2, ($y1 + $y2) / 2)
  sleep(0.1)
  point($x2, $y2)
  sleep(0.1)
  button("left", "release")
  return 0
end

-- A selection's REPLY goes out as soon as the result is decided, but the run is
-- held open until the overlay's removal is evidenced (or the cleanup budget
-- expires), and `busy` is refused for that whole window. So back-to-back
-- selections -- reply, immediately select again -- legitimately see `busy`, and
-- a caller must tolerate it. Settle before each arm that expects admission, so
-- the gate measures the verb rather than its own impatience. A 1 ms selection is
-- the cheapest liveness probe: admitted means it answers `timeout`.
fn settle($deadline_s)
  $deadline = time() + $deadline_s
  while time() < $deadline
    $r = rpc("comp.region.select", {timeout_ms: 1}, 10)
    if $r.ok then
      return true
    end
    sleep(0.3)
  end
  return false
end

-- A PPM (P6) as {w, h, off, bytes} (testkit-screenshot's header "P6\n<w> <h>\n255\n").
fn load_ppm($path)
  $b = read_file_bytes($path)
  $head = bytes_to_string(slice($b, 0, 32), {lossy: true})
  $m = re_find($head, "^P6\\s+(\\d+)\\s+(\\d+)\\s+255\\s")
  if len($m) == 0 then
    return nil
  end
  return {w: to_number($m[0].groups[0]), h: to_number($m[0].groups[1]), off: $m[0].end, bytes: $b}
end

-- One pixel of a loaded PPM as [r, g, b].
fn pixel($ppm, $x, $y)
  $at = $ppm.off + ($y * $ppm.w + $x) * 3
  return [$ppm.bytes[$at], $ppm.bytes[$at + 1], $ppm.bytes[$at + 2]]
end

-- The largest per-channel difference between two pixels.
fn channel_gap($a, $b)
  $gap = 0
  for each $c in [0, 1, 2]
    $d = abs($a[$c] - $b[$c])
    if $d > $gap then
      $gap = $d
    end
  end
  return $gap
end

mkdir($DIR, {parents: true})

print("gate: comp.region.select (driven over ABP, no human hand)")
print("  compd service: " .. $COMP)

-- The ACTUAL compositor run instance, read from comp.info: the cancellation
-- identity must name the process the selection went to, never a made-up
-- test constant (a restart changes this value, which is exactly the fence
-- the stale-instance arm exercises).
$info = rpc("comp.info", {}, 10)
if not $info.ok or $info.value == nil or $info.value.instance == nil then
  print("  REFUSE: cannot read the compositor instance from comp.info (" .. $info.body .. ")")
  $n.stop($SESSION)
  exit(2)
end
$INSTANCE = $info.value.instance
note("compositor instance: " .. $INSTANCE)

-- ── arm 0: the verb exists ───────────────────────────────────────────────
-- Asked FIRST and separately: every later arm's failure is ambiguous if the
-- verb is simply absent, and "unknown verb" must never be reported as a
-- selection that went wrong.
-- A compositor without the verb answers:
--   rc=10  {error: unknown_verb, error_code: unknown_verb}
-- Matched on that exact token, not a loose "unknown": every later arm drives
-- SYNTHETIC POINTER INPUT, so a probe that fails to recognise the refusal would
-- start dragging on a live desktop. The narrow match is the safety interlock.
$probe = rpc("comp.region.select", {timeout_ms: 1000}, 15)
if not $probe.ok then
  if contains($probe.body, "unknown_verb") then
    print("  REFUSE: this compositor has no comp.region.select (" .. $probe.body .. ")")
    print("          the gate cannot test a verb that is not there")
    $n.stop($SESSION)
    exit(2)
  end
end
note("arm 0: verb present")

-- ── arm 1: a forward drag returns that rectangle ─────────────────────────
settle(10)
$p1 = start_selector("forward", {timeout_ms: 20000})
sleep(1.0)
drag(400, 300, 700, 500)
$r1 = await_selector($p1, 25)
if $r1 == nil then
  push($FAILURES, "forward")
  fail("forward", "the selector never wrote a reply")
elif $r1.value == nil then
  push($FAILURES, "forward")
  fail("forward", "reply was not JSON: " .. $r1.body)
elif to_string($r1.value.status) != "selected" then
  push($FAILURES, "forward")
  fail("forward", "status=" .. to_string($r1.value.status) .. " body=" .. $r1.body)
else
  $g = $r1.value.region
  if $g.width < 250 or $g.width > 350 or $g.height < 150 or $g.height > 250 then
    push($FAILURES, "forward")
    fail("forward", "rectangle is not the drag: " .. json_encode($g))
  else
    note("arm 1 forward drag: " .. json_encode($g))
  end
end

-- ── arm 2: a REVERSE drag returns the same rectangle ─────────────────────
-- Dragging up-left must normalise; a raw x2-x1 would go negative here.
settle(10)
$p2 = start_selector("reverse", {timeout_ms: 20000})
sleep(1.0)
drag(700, 500, 400, 300)
$r2 = await_selector($p2, 25)
if $r2 == nil or $r2.value == nil then
  push($FAILURES, "reverse")
  fail("reverse", "no usable reply")
elif to_string($r2.value.status) != "selected" then
  push($FAILURES, "reverse")
  fail("reverse", "status=" .. to_string($r2.value.status))
else
  $g2 = $r2.value.region
  if $g2.width < 250 or $g2.width > 350 or $g2.height < 150 or $g2.height > 250 then
    push($FAILURES, "reverse")
    fail("reverse", "reverse drag did not normalise: " .. json_encode($g2))
  else
    note("arm 2 reverse drag normalised: " .. json_encode($g2))
  end
end

-- ── arm 3: Escape cancels ────────────────────────────────────────────────
settle(10)
$p3 = start_selector("escape", {timeout_ms: 20000})
sleep(1.0)
point(500, 400)
sleep(0.1)
button("left", "press")
sleep(0.2)
key("Escape", "press")
sleep(0.1)
key("Escape", "release")
-- The drag's own button is still down; release it so the arm cannot pass by
-- leaving held state behind for the next one.
button("left", "release")
$r3 = await_selector($p3, 25)
if $r3 == nil or $r3.value == nil then
  push($FAILURES, "escape")
  fail("escape", "no usable reply")
elif to_string($r3.value.status) != "cancelled" then
  push($FAILURES, "escape")
  fail("escape", "status=" .. to_string($r3.value.status) .. " (expected cancelled)")
else
  note("arm 3 escape cancelled, reason=" .. to_string($r3.value.reason))
end

-- ── arm 4: a second caller is refused, not queued ────────────────────────
$p4 = start_selector("holder", {timeout_ms: 8000})
sleep(1.0)
$second = rpc("comp.region.select", {timeout_ms: 5000}, 15)
if $second.ok then
  push($FAILURES, "busy")
  fail("busy", "a second concurrent selection was ACCEPTED: " .. $second.body)
elif not contains(lower($second.body), "busy") then
  push($FAILURES, "busy")
  fail("busy", "refused but not as busy: " .. $second.body)
else
  note("arm 4 second caller refused busy")
end
-- let the holder time out rather than leaving a grab behind
$r4 = await_selector($p4, 25)
if $r4 == nil then
  push($FAILURES, "busy-release")
  fail("busy-release", "the holding selector never answered — a grab may be leaked")
end

-- ── arm 5: timeout answers, and the grab is released ─────────────────────
settle(10)
$p5 = start_selector("timeout", {timeout_ms: 3000})
$r5 = await_selector($p5, 25)
if $r5 == nil or $r5.value == nil then
  push($FAILURES, "timeout")
  fail("timeout", "no usable reply")
elif to_string($r5.value.status) != "timeout" then
  push($FAILURES, "timeout")
  fail("timeout", "status=" .. to_string($r5.value.status) .. " (expected timeout)")
else
  note("arm 5 timeout answered cleanly")
end
-- after a timeout the next selection must be accepted, or the grab leaked
settle(10)
$p6 = start_selector("after-timeout", {timeout_ms: 8000})
sleep(1.0)
drag(300, 200, 500, 360)
$r6 = await_selector($p6, 25)
if $r6 == nil or $r6.value == nil or to_string($r6.value.status) != "selected" then
  push($FAILURES, "after-timeout")
  fail("after-timeout", "a selection after a timeout did not succeed — grab leaked?")
else
  note("arm 6 selection after timeout still works")
end

-- ── arm 7: an identified selection is cancelled natively, its original
-- reply echoes the identity, and a repeat cancel is already_finished ─────
settle(10)
$OWN = "a3f9c2d1-4e7b-4a1c-9d8e-5f6b7c8d9e0f"
$s7 = {instance: $INSTANCE, owner: $OWN, generation: 1}
$p7 = start_selector("native-cancel", {timeout_ms: 20000, selection: $s7})
sleep(1.0)
$c7 = rpc("comp.region.cancel", {selection: $s7}, 10)
if not $c7.ok then
  push($FAILURES, "native-cancel")
  fail("native-cancel", "cancel refused: " .. $c7.body)
elif to_string($c7.value.status) != "cancelled" then
  push($FAILURES, "native-cancel")
  fail("native-cancel", "cancel status=" .. to_string($c7.value.status) .. " body=" .. $c7.body)
else
  note("arm 7 native cancel acknowledged: " .. to_string($c7.value.status))
end
-- The original long select then completes with the existing cancelled shape
-- plus its selection identity — never silence, never a second shape.
$r7 = await_selector($p7, 25)
if $r7 == nil or $r7.value == nil then
  push($FAILURES, "native-cancel")
  fail("native-cancel", "the selector never answered after cancel")
elif to_string($r7.value.status) != "cancelled" then
  push($FAILURES, "native-cancel")
  fail("native-cancel", "select status=" .. to_string($r7.value.status) .. " body=" .. $r7.body)
elif to_string($r7.value.selection.owner) != $OWN or $r7.value.selection.generation != 1 then
  push($FAILURES, "native-cancel")
  fail("native-cancel", "select reply did not echo the identity: " .. $r7.body)
else
  note("arm 7 original select answered cancelled with its selection echoed")
end
$c7b = rpc("comp.region.cancel", {selection: $s7}, 10)
if not $c7b.ok or to_string($c7b.value.status) != "already_finished" then
  push($FAILURES, "native-cancel")
  fail("native-cancel", "repeat cancel status=" .. to_string($c7b.value.status) .. " body=" .. $c7b.body)
else
  note("arm 7 repeat cancel answered already_finished")
end

-- ── arm 8: a delayed old cancel never stops a newer selection ───────────
-- The same owner moves to generation 2 (the Cap rule: a new capture bumps
-- the generation). A replayed cancel for generation 1 must not stop it.
settle(10)
$s8 = {instance: $INSTANCE, owner: $OWN, generation: 2}
$p8 = start_selector("reorder", {timeout_ms: 20000, selection: $s8})
sleep(1.0)
$c8 = rpc("comp.region.cancel", {selection: {instance: $INSTANCE, owner: $OWN, generation: 1}}, 10)
if not $c8.ok or to_string($c8.value.status) == "cancelled" then
  push($FAILURES, "reorder")
  fail("reorder", "the replayed old cancel answered: " .. $c8.body)
end
drag(300, 200, 500, 360)
$r8 = await_selector($p8, 25)
if $r8 == nil or $r8.value == nil or to_string($r8.value.status) != "selected" then
  push($FAILURES, "reorder")
  fail("reorder", "the newer selection did not complete: " .. to_string($r8.body))
else
  note("arm 8 delayed old cancel left the newer selection alone")
end

-- ── arm 9: a cancel that arrives before its select retires it ───────────
-- A reordered mesh delivery must never resurrect: the delayed select is
-- refused retired_selection, not started as an abandoned overlay.
settle(10)
$OWN9 = "7d2e8b4f-4a3c-4d9e-8c1a-6f5b9e2d7a4c"
$s9 = {instance: $INSTANCE, owner: $OWN9, generation: 1}
$c9 = rpc("comp.region.cancel", {selection: $s9}, 10)
if not $c9.ok or to_string($c9.value.status) != "retired" then
  push($FAILURES, "pre-cancel")
  fail("pre-cancel", "cancel-before-select did not retire: " .. $c9.body)
end
$r9 = rpc("comp.region.select", {timeout_ms: 5000, selection: $s9}, 15)
if $r9.ok then
  push($FAILURES, "pre-cancel")
  fail("pre-cancel", "the retired selection was ACCEPTED: " .. $r9.body)
elif not contains($r9.body, "retired_selection") then
  push($FAILURES, "pre-cancel")
  fail("pre-cancel", "refused but not as retired_selection: " .. $r9.body)
else
  note("arm 9 cancel-before-select retired the delayed select")
end

-- ── arm 10: a stale compositor instance is refused and mutates nothing ──
-- The refusal must not retire the generation: the same identity still
-- admits on the real instance (it times out, which proves admission).
settle(10)
$OWN10 = "c5b7e3a1-4f2d-4b6e-9a8c-3d7f1a5b9e2c"
$stale = rpc("comp.region.cancel", {selection: {instance: "not-this-compositor", owner: $OWN10, generation: 1}}, 10)
if $stale.ok or not contains($stale.body, "stale_instance") then
  push($FAILURES, "stale")
  fail("stale", "a foreign instance was not refused stale_instance: " .. $stale.body)
end
$p10 = start_selector("stale", {timeout_ms: 2000, selection: {instance: $INSTANCE, owner: $OWN10, generation: 1}})
$r10 = await_selector($p10, 25)
if $r10 == nil or $r10.value == nil or to_string($r10.value.status) != "timeout" then
  push($FAILURES, "stale")
  fail("stale", "the stale refusal retired the generation anyway: " .. to_string($r10.body))
else
  note("arm 10 stale instance refused without mutating owner state")
end

-- ── arm 11: an unrelated owner or a newer generation never cancels the
-- active selection ───────────────────────────────────────────────────────
settle(10)
$OWN11 = "1f4a9d2e-4b7c-4a3e-8d9b-6e2c7f5a8b3d"
$p11 = start_selector("untouched", {timeout_ms: 20000, selection: {instance: $INSTANCE, owner: $OWN11, generation: 1}})
sleep(1.0)
$other = rpc("comp.region.cancel", {selection: {instance: $INSTANCE, owner: "2b5c8e3f-4d9a-4f1e-9c7d-8a3e6f2b4c5d", generation: 1}}, 10)
$newer = rpc("comp.region.cancel", {selection: {instance: $INSTANCE, owner: $OWN11, generation: 2}}, 10)
if not $other.ok or to_string($other.value.status) == "cancelled" then
  push($FAILURES, "untouched")
  fail("untouched", "an unrelated owner cancelled the run: " .. $other.body)
end
if not $newer.ok or to_string($newer.value.status) == "cancelled" then
  push($FAILURES, "untouched")
  fail("untouched", "a newer generation cancelled the older run: " .. $newer.body)
end
drag(400, 300, 700, 500)
$r11 = await_selector($p11, 25)
if $r11 == nil or $r11.value == nil or to_string($r11.value.status) != "selected" then
  push($FAILURES, "untouched")
  fail("untouched", "the active selection did not complete: " .. to_string($r11.body))
else
  note("arm 11 unrelated/newer cancels left the active selection running")
end

-- ── arm 12: a stale select is refused before any reservation, and the
-- live identity still admits ───────────────────────────────────────────
-- The select side of the instance fence, symmetric with arm 10's cancel:
-- the refusal is immediate, and it must not have reserved the owner
-- generation — the same identity on the real instance then admits (it
-- times out, which proves admission).
settle(10)
$OWN12 = "9b4e7c2d-4f1a-4c8e-8d6b-3e5a7f9c1b2d"
$stale_sel = rpc("comp.region.select", {timeout_ms: 2000, selection: {instance: "not-this-compositor", owner: $OWN12, generation: 1}}, 15)
if $stale_sel.ok then
  push($FAILURES, "stale-select")
  fail("stale-select", "a foreign instance was ACCEPTED: " .. $stale_sel.body)
elif not contains($stale_sel.body, "stale_instance") then
  push($FAILURES, "stale-select")
  fail("stale-select", "refused but not as stale_instance: " .. $stale_sel.body)
end
$p12 = start_selector("stale-select", {timeout_ms: 2000, selection: {instance: $INSTANCE, owner: $OWN12, generation: 1}})
$r12 = await_selector($p12, 25)
if $r12 == nil then
  push($FAILURES, "stale-select")
  fail("stale-select", "the live identity never answered")
elif $r12.value == nil then
  push($FAILURES, "stale-select")
  fail("stale-select", "reply was not JSON: " .. $r12.body)
elif to_string($r12.value.status) != "timeout" then
  push($FAILURES, "stale-select")
  fail("stale-select", "the stale refusal reserved the generation anyway: " .. $r12.body)
else
  note("arm 12 stale select refused without reserving the owner generation")
end

-- ── arm 13: the overlay is drawn while the run holds the seat and gone
-- after the cancelled reply (the clean-frame rule) ─────────────────────
-- A real screencopy (testkit-screenshot, the probe nested_smoke uses), not
-- an inference from the busy window: the armed run draws a full-output
-- outline, so the output's top-left pixel is outline blue during the run
-- and the plain background after the cancel. The cancelled reply does not
-- wait for the clean frame (only a selected reply does), so the after-shot
-- is retaken until the overlay leaves the presented frame.
settle(10)
$OWN13 = "2c8f4a1d-4e6b-4d9a-8f3c-7b5e1d9a2f4c"
$p13 = start_selector("overlay", {timeout_ms: 20000, selection: {instance: $INSTANCE, owner: $OWN13, generation: 1}})
sleep(1.0)
point(600, 400)
sleep(0.3)
$shot_during = run_argv([$SHOT, $DIR .. "/overlay-during.ppm", "--region", "0,0,4,4"], {env: $CENV, timeout: 20})
$c13 = rpc("comp.region.cancel", {selection: {instance: $INSTANCE, owner: $OWN13, generation: 1}}, 10)
$r13 = await_selector($p13, 25)
if not $c13.ok then
  push($FAILURES, "overlay")
  fail("overlay", "cancel refused: " .. $c13.body)
elif to_string($c13.value.status) != "cancelled" then
  push($FAILURES, "overlay")
  fail("overlay", "cancel status=" .. to_string($c13.value.status) .. " body=" .. $c13.body)
elif $r13 == nil then
  push($FAILURES, "overlay")
  fail("overlay", "the selector never answered")
elif $r13.value == nil then
  push($FAILURES, "overlay")
  fail("overlay", "reply was not JSON: " .. $r13.body)
elif to_string($r13.value.status) != "cancelled" then
  push($FAILURES, "overlay")
  fail("overlay", "select status=" .. to_string($r13.value.status) .. " body=" .. $r13.body)
end
$pd = nil
if $shot_during.exit_code == 0 and is_file($DIR .. "/overlay-during.ppm") then
  $pd = load_ppm($DIR .. "/overlay-during.ppm")
end
if $pd == nil then
  push($FAILURES, "overlay")
  fail("overlay", "the during screencopy failed: exit " .. to_string($shot_during.exit_code) .. " " .. trim($shot_during.stderr))
else
  -- The cancelled reply does not wait for the clean frame (only a selected
  -- reply does), so the after-shot is retaken until the overlay is gone
  -- from the presented frame; a run whose overlay never clears fails.
  $pa = nil
  $tries = 0
  while $pa == nil and $tries < 10
    $shot_after = run_argv([$SHOT, $DIR .. "/overlay-after.ppm", "--region", "0,0,4,4"], {env: $CENV, timeout: 20})
    if $shot_after.exit_code == 0 and is_file($DIR .. "/overlay-after.ppm") then
      $pa = load_ppm($DIR .. "/overlay-after.ppm")
    end
    if $pa != nil and channel_gap(pixel($pd, 1, 1), pixel($pa, 1, 1)) > 30 then
      break
    end
    $pa = nil
    sleep(0.4)
    $tries = $tries + 1
  end
  if $pa == nil then
    push($FAILURES, "overlay")
    fail("overlay", "the overlay never left the screencopy after the cancelled reply: exit " .. to_string($shot_after.exit_code) .. " " .. trim($shot_after.stderr))
  else
    $d_edge = pixel($pd, 1, 1)
    $a_edge = pixel($pa, 1, 1)
    $a_mid = pixel($pa, floor($pa.w / 2), floor($pa.h / 2))
    if channel_gap($d_edge, $a_edge) <= 30 then
      push($FAILURES, "overlay")
      fail("overlay", "the overlay was not in the during screencopy: during " .. json_encode($d_edge) .. " vs after " .. json_encode($a_edge))
    elif channel_gap($a_edge, $a_mid) > 8 then
      push($FAILURES, "overlay")
      fail("overlay", "the overlay outlived the cancelled reply (clean-frame rule): after edge " .. json_encode($a_edge) .. " vs background " .. json_encode($a_mid))
    else
      note("arm 13 overlay drawn during the run " .. json_encode($d_edge) .. ", gone after the reply " .. json_encode($a_edge))
    end
  end
end

-- ── arm 14: a cancel restores a real client window's keyboard focus ────
-- A real test client window (testkit-ssd-client) holds the keyboard;
-- beginning the run displaces it (the seat belongs to the selection); the
-- cancel restores it through the ordinary finish path.
settle(10)
$OWN14 = "5a1c8e3b-4d7f-4b2e-9c6a-8f4d2e7b1a3c"
$ssd_log = $DIR .. "/ssd-client.log"
$ssd = spawn([$SSD, "--size", "300x200", "--colour", "c06060"], {env: $CENV, stdout: {file: $ssd_log}, stderr: "stdout", detach: true})
$win = nil
$tries = 0
while $win == nil and $tries < 40
  $rows = rpc("comp.windows.list", {}, 10)
  if $rows.ok and $rows.value != nil and $rows.value.windows != nil then
    for each $row in $rows.value.windows
      if $row.app_id == "testkit-ssd-client" then
        $win = $row
      end
    end
  end
  if $win == nil then
    sleep(0.25)
    $tries = $tries + 1
  end
end
if $win == nil then
  push($FAILURES, "focus")
  fail("focus", "the ssd test client never mapped a window: " .. trim(read_file($ssd_log) ?? ""))
else
  $focus = rpc("comp.window.focus", {id: $win.id, generation: $win.generation}, 10)
  $kb = nil
  $tries = 0
  while $kb != $win.id and $tries < 20
    $fkb = rpc("comp.props.get", {path: "focus.keyboard"}, 10)
    $kb = if $fkb.ok then $fkb.value else nil end
    if $kb != $win.id then
      sleep(0.25)
      $tries = $tries + 1
    end
  end
  if $kb != $win.id then
    push($FAILURES, "focus")
    fail("focus", "the client window never took the keyboard: focus.keyboard=" .. to_string($kb) .. " (focus rc " .. to_string($focus.rc) .. ")")
  else
    $p14 = start_selector("focus", {timeout_ms: 20000, selection: {instance: $INSTANCE, owner: $OWN14, generation: 1}})
    sleep(1.0)
    $dur = rpc("comp.props.get", {path: "focus.keyboard"}, 10)
    $c14 = rpc("comp.region.cancel", {selection: {instance: $INSTANCE, owner: $OWN14, generation: 1}}, 10)
    $r14 = await_selector($p14, 25)
    $restored = nil
    $tries = 0
    while $restored != $win.id and $tries < 20
      $fkb = rpc("comp.props.get", {path: "focus.keyboard"}, 10)
      $restored = if $fkb.ok then $fkb.value else nil end
      if $restored != $win.id then
        sleep(0.25)
        $tries = $tries + 1
      end
    end
    if $dur.ok and $dur.value == $win.id then
      push($FAILURES, "focus")
      fail("focus", "the run left the client's keyboard focus in place")
    elif not $c14.ok then
      push($FAILURES, "focus")
      fail("focus", "cancel refused: " .. $c14.body)
    elif to_string($c14.value.status) != "cancelled" then
      push($FAILURES, "focus")
      fail("focus", "cancel status=" .. to_string($c14.value.status) .. " body=" .. $c14.body)
    elif $r14 == nil then
      push($FAILURES, "focus")
      fail("focus", "the selector never answered")
    elif $r14.value == nil then
      push($FAILURES, "focus")
      fail("focus", "reply was not JSON: " .. $r14.body)
    elif to_string($r14.value.status) != "cancelled" then
      push($FAILURES, "focus")
      fail("focus", "select status=" .. to_string($r14.value.status) .. " body=" .. $r14.body)
    elif $restored != $win.id then
      push($FAILURES, "focus")
      fail("focus", "focus was not restored to the client after the cancel: " .. to_string($restored))
    else
      note("arm 14 focus displaced during the run, restored to the client after cancel")
    end
  end
end
if $ssd != nil and process_alive($ssd) then
  kill($ssd, 15)
end

-- ── arm 15: a session lock mid-run ends the selection `locked`, the
-- identity is echoed, and the state cleans up ──────────────────────────
settle(10)
$OWN15 = "6f2d9a4c-4e8b-4c3f-9d7b-9a5e3f8c2b4d"
$p15 = start_selector("locked", {timeout_ms: 20000, selection: {instance: $INSTANCE, owner: $OWN15, generation: 1}})
sleep(1.0)
$lock_log = $DIR .. "/lock-client.log"
$lock = spawn([$LOCK, "--hold", "30"], {env: $CENV, stdout: {file: $lock_log}, stderr: "stdout", detach: true})
$phase = ""
$tries = 0
while $phase != "locked" and $tries < 40
  $sl = rpc("comp.props.get", {path: "focus.session_lock"}, 10)
  $phase = if $sl.ok then to_string($sl.value ?? "") else "" end
  if $phase != "locked" then
    sleep(0.25)
    $tries = $tries + 1
  end
end
$r15 = await_selector($p15, 25)
if $phase != "locked" then
  push($FAILURES, "locked")
  fail("locked", "the session lock never engaged: " .. trim(read_file($lock_log) ?? ""))
elif $r15 == nil or $r15.value == nil then
  push($FAILURES, "locked")
  fail("locked", "the selector never answered under the lock")
elif not contains($r15.body, "locked") then
  push($FAILURES, "locked")
  fail("locked", "the locked run did not answer locked: " .. $r15.body)
elif $r15.value.selection == nil or to_string($r15.value.selection.owner) != $OWN15 then
  push($FAILURES, "locked")
  fail("locked", "the locked reply did not echo the identity: " .. $r15.body)
else
  note("arm 15 mid-run lock ended the selection locked with its identity echoed")
end
-- Unlock and prove the state cleaned up: the region is idle again, a newer
-- generation admits, and the locked generation stays retired.
if $lock != nil and process_alive($lock) then
  kill($lock, 10)
end
$phase = "locked"
$tries = 0
while $phase != "none" and $tries < 40
  $sl = rpc("comp.props.get", {path: "focus.session_lock"}, 10)
  $phase = if $sl.ok then to_string($sl.value ?? "") else "" end
  if $phase != "none" then
    sleep(0.25)
    $tries = $tries + 1
  end
end
if $lock != nil and process_alive($lock) then
  kill($lock, 15)
end
if $phase != "none" then
  push($FAILURES, "locked")
  fail("locked", "SIGUSR1 did not unlock: " .. $phase)
else
  if not settle(10) then
    push($FAILURES, "locked")
    fail("locked", "the region did not return to idle after the locked run")
  end
  $admit = rpc("comp.region.select", {timeout_ms: 1000, selection: {instance: $INSTANCE, owner: $OWN15, generation: 2}}, 15)
  if not $admit.ok then
    push($FAILURES, "locked")
    fail("locked", "a newer generation did not admit after the locked run: " .. $admit.body)
  elif to_string($admit.value.status) != "timeout" then
    push($FAILURES, "locked")
    fail("locked", "a newer generation did not admit after the locked run: " .. $admit.body)
  end
  $retired = rpc("comp.region.select", {timeout_ms: 1000, selection: {instance: $INSTANCE, owner: $OWN15, generation: 1}}, 15)
  if $retired.ok or not contains($retired.body, "retired_selection") then
    push($FAILURES, "locked")
    fail("locked", "the locked run's generation was not left retired: " .. $retired.body)
  end
  note("arm 15 state cleaned up: idle, generation 2 admitted, generation 1 retired")
end

$n.stop($SESSION)
print("")
if len($FAILURES) == 0 then
  print("=== REGION SELECT GATE [" .. $KIND .. "]: GREEN — 15 arms, every one answered ===")
  $CLEANUP.ok = true
  exit(0)
end
print("=== REGION SELECT GATE [" .. $KIND .. "]: FAILED — " .. join($FAILURES, ", ") .. " ===")
exit(1)
finally
  $n.finish_run($CLEANUP.run, $CLEANUP.ok)
end
