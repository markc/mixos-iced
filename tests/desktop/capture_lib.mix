-- version: 0.1.0
-- Bounded binary P6 inspection for native desktop acceptance gates.
fn ppm($path)
  $bytes = read_file_bytes($path)
  $lines = 0
  $end = nil
  for $at = 0 to min(127,len($bytes)-1)
    if $bytes[$at] == 10 then
      $lines = $lines + 1
      if $lines == 3 then $end=$at+1; break end
    end
  end
  if $end == nil then raise("CAPTURE","Missing P6 header") end
  $match = re_find(bytes_to_string(slice($bytes,0,$end)),"^P6\\s+(\\d+)\\s+(\\d+)\\s+255\\s")
  if len($match) != 1 then raise("CAPTURE","Not a P6 screenshot") end
  $w = to_number($match[0].groups[0])
  $h = to_number($match[0].groups[1])
  if $match[0].end != $end or len($bytes) != $end+$w*$h*3 then raise("CAPTURE","Truncated P6") end
  return {bytes:$bytes,w:$w,h:$h,off:$end}
end
fn pixel($image,$x,$y)
  $x = floor($x)
  $y = floor($y)
  if $x < 0 or $y < 0 or $x >= $image.w or $y >= $image.h then raise("CAPTURE","Pixel outside screenshot") end
  $at = $image.off+($y*$image.w+$x)*3
  return slice($image.bytes,$at,$at+3)
end
fn srgb($linear)
  return round(255 * (if $linear <= 0.0031308 then $linear*12.92 else 1.055*pow($linear,1/2.4)-0.055 end))
end
