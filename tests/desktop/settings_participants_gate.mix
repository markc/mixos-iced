-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.3.0
-- One real owned broker/session, six simultaneous native apps plus Quoin.
-- Four exact acceptance frame/layout stamps; Ced/Scene Editor/Quoin capture
-- palette/boundary evidence remains explicitly different. No KMS claim.
if len(args()) < 2 or len(args()) > 4 then raise("ARGS","REPO BUILD_BIN_DIR [ACTUAL_OUTPUT_SCALE [compact]]") end
$repo=args()[0]; $bin=args()[1]; $mix=$bin .. "/mix"
$compact_mode=len(args()) == 4 and args()[3] == "compact"
if len(args()) == 4 and not $compact_mode then raise("ARGS","Unknown native layout mode") end
$requested_scale=if len(args()) >= 3 then to_number(args()[2]) else 1.25 end
if $compact_mode then
  if $requested_scale != 2.5 then raise("ARGS","Compact layout requires actual output scale 2.5") end
elif $requested_scale != 1 and $requested_scale != 1.25 and $requested_scale != 1.5 then
  raise("ARGS","Supported measured output scale: 1, 1.25 or 1.5")
end
export MIXOS_TEST_MIX=$mix
export COMPD_KEEP_RUN="1"
$n=require("nested_host_lib.mix")
$h=require("settings_host_lib.mix")
$f=require("settings_fixture_lib.mix")
$recovery=require("settings_recovery_lib.mix")
$product=require("settings_apps_lib.mix")
$pty=require("pty_host_lib.mix")
$pixels=require("capture_lib.mix")
$all=require("settings_all_apps_lib.mix")
$participants=require("settings_participants_lib.mix")
$failure=require("settings_failure_lib.mix")
$binding={instance:"fixture",profile:"default"}
$R={run:nil,bus:nil,session:nil,children:[],owners:[],ok:false,serial:0,ced_tab:nil,ced_state:nil,scene_state:nil,rounds:[]}
fn check($condition,$message) return $all.check($condition,$message) end
for each $name in ["mix","noded","settingsd","compd","editd","term","ced","busviewer","cap","dopus","scene-editor","testkit-screenshot","testkit-input-probe"]
  check(is_file($bin .. "/" .. $name),"Missing candidate " .. $name)
end
$pty.check_support()
fn rpc($service,$verb,$body)
  return $h.rpc($mix,$R.bus,$R.run.path,$service,$verb,$body)
end
fn comp($verb,$body) return rpc($R.session.service,$verb,$body) end
fn shell($verb,$body) return rpc("shell",$verb,$body) end
fn own($pid,$privileged)
  $R.children=concat($R.children,[{pid:$pid,privileged_launcher:$privileged}])
  return $pid
end
fn ready($service,$verb,$pid)
  $deadline=time()+15
  while time() < $deadline
    check(process_alive($pid),"Owned " .. $service .. " exited")
    $r=$h.call($mix,$R.bus,$R.run.path,$service,$verb,{})
    if $r.rc == 0 then return $r.result end
    sleep(0.05)
  end
  raise("READY",$service .. " did not register")
end
fn env_for($home)
  for each $dir in ["config","state","cache","data"]
    mkdir($home .. "/" .. $dir,{parents:true})
  end
  return merge($h.bus_env($R.bus,$R.run.path),{HOME:$home,MIXOS_APP_HOME:$home,
    XDG_CONFIG_HOME:$home .. "/config",XDG_STATE_HOME:$home .. "/state",
    XDG_CACHE_HOME:$home .. "/cache",XDG_DATA_HOME:$home .. "/data",
    XDG_DATA_DIRS:$R.run.path .. "/core",MIXOS_SHARE:$R.run.path .. "/core",
    MIXOS_SETTINGS_INSTANCE:"fixture",MIXOS_SETTINGS_PROFILE:"default",
    LIBGL_ALWAYS_SOFTWARE:"1",TERM_NOTIFY:"0",WGPU_BACKEND:"gl",
    SCENES_SERVICE:"scenes",SCENE_HOST:"shell"})
end
fn apply($changes,$label)
  $old=rpc("settingsd","settings.get",{binding:$binding}).snapshot
  $issued=time()
  $accepted=rpc("settingsd","settings.apply",{binding:$binding,expected_incarnation:$old.incarnation,
    expected_revision:$old.revision,operation_id:"all-apps-" .. $label,changes:$changes,reset:[]})
  write_file($R.run.path .. "/authority-apply-" .. $label .. ".json",json_encode($accepted))
  $snapshot=rpc("settingsd","settings.get",{binding:$binding}).snapshot
  check($snapshot.incarnation == $old.incarnation and $snapshot.revision != $old.revision,"Batch did not advance authority")
  return {snapshot:$snapshot,issued:$issued,accept_reply_observed:time(),reply:$accepted,operation_id:"all-apps-" .. $label}
end
fn launch($name,$label,$fixture)
  $R.serial=$R.serial+1
  $home=$R.run.path .. "/home-" .. $name .. "-" .. $label
  $ctx={mix:$mix,bus:$R.bus,bus_root:$R.run.path,root:$R.run.path .. "/owner-" .. $name .. "-" .. $label,
    service:if $name == "term" then "term" else $name .. "-" .. $label end}
  mkdir($ctx.root,{parents:true})
  $identity={run:"all-apps-" .. to_string(pid()),instance:$R.serial}
  $extra=env_for($home)
  if $fixture then $extra=merge($extra,{MIXOS_ACCEPTANCE_RUN:$identity.run,MIXOS_ACCEPTANCE_INSTANCE:to_string($identity.instance)}) end
  $env=$n.client_env($R.session,$extra)
  $argv=if $name == "term" then $pty.launch_argv($bin,$env)
    elif $name == "ced" then [$bin .. "/ced","--service",$ctx.service,$R.run.path .. "/document.txt"]
    elif $name == "dopus" then [$bin .. "/dopus","--service",$ctx.service,"--noded-url",$R.bus.url,"--",$R.run.path .. "/left",$R.run.path .. "/right"]
    elif $name == "cap" then [$bin .. "/cap","--service",$ctx.service,"--comp",$R.session.service,$R.run.path .. "/source.png"]
    elif $name == "scene-editor" then [$bin .. "/scene-editor","--service",$ctx.service,"--comp",$R.session.service,"mixos-scene-editor:installed/calendar"]
    else [$bin .. "/busviewer","--service",$ctx.service,"--comp",$R.session.service] end
  $launcher=own(spawn($argv,{env:$env,stdout:{file:$ctx.root .. "/app.log"},stderr:"stdout",detach:true}),$name == "term")
  comp("comp.window.wait",{match:{app_id:"dev.mixos." .. $name},until:"mapped",timeout_ms:15000})
  $deadline=time()+10; $row=nil
  while time() < $deadline
    $rows=filter(comp("comp.windows.list",{}).windows,fn($w)=$w.app_id == "dev.mixos." .. $name and ($name == "term" or $w.pid == $launcher))
    if len($rows) == 1 then
      $row=comp("comp.window.wait",{match:{id:$rows[0].id,generation:$rows[0].generation},until:"presented",timeout_ms:5000}).window
      if $row != nil then break end
    end
    sleep(0.05)
  end
  check($row != nil and $row.pid != nil and ($name == "term" or $row.pid == $launcher),"Wrong actual launched owner")
  if $name == "term" then own($row.pid,false) end
  $app={name:$name,pid:$row.pid,launcher:$launcher,window:{id:$row.id,generation:$row.generation},
    context:$ctx,identity:$identity,settings_context:"app:" .. $name,fixture:$fixture,work_root:$R.run.path,
    version:toml_parse(read_file($repo .. "/apps/" .. $name .. "/Cargo.toml")).package.version,
    desktop:{mix:$mix,bus:$R.bus,root:$R.run.path,service:$R.session.service}}
  $R.owners=concat($R.owners,[$app])
  return $app
end
fn owner($name)
  return filter($R.owners,fn($o)=$o.name == $name)[0]
end
fn descriptions($batch,$label)
  $receipts=[]
  for each $app in $R.owners
    $description=$all.current($app.context,$app.pid,$batch.snapshot,$binding,$app.settings_context,15)
    write_file($app.context.root .. "/description-" .. $label .. ".json",json_encode($description))
    $all.canonical($description,$app,$batch.snapshot,$binding,$manifest,$manifest_digest)
    $observed=time()
    $receipts=concat($receipts,[{name:$app.name,pid:$app.pid,service:$app.context.service,
      current:$description.settings.current,applied:$description.settings.applied,
      resources:$description.resources,observation_upper_bound_ms:($observed-$batch.issued)*1000,
      latency_kind:"authority call issued to sequential current/applied observation upper bound"}])
  end
  check(time()-$batch.issued < 180,"Shared authority observation exceeded bounded 180-second phase")
  return $receipts
end
fn simultaneously_alive()
  $windows=comp("comp.windows.list",{}).windows
  for each $app in $R.owners
    check(process_alive($app.pid),"Concurrent owner exited: " .. $app.name)
    if $app.name != "quoin" then
      check(len(filter($windows,fn($w)=$w.id == $app.window.id and $w.generation == $app.window.generation and $w.pid == $app.pid)) == 1,"Concurrent window replaced: " .. $app.name)
    end
  end
  return $windows
end
fn participant_presentations($batch,$label)
  $records=[]
  write_file($R.run.path .. "/authority-describe-" .. $label .. ".json",json_encode(rpc("settingsd","settings.describe",{})))
  write_file($R.run.path .. "/authority-get-" .. $label .. ".json",json_encode(rpc("settingsd","settings.get",{binding:$binding})))
  write_file($R.run.path .. "/native-inventory-" .. $label .. ".json",json_encode(rpc("noded","noded.inventory",{})))
  write_file($R.run.path .. "/native-services-" .. $label .. ".json",json_encode(rpc("noded","noded.list",{})))
  write_file($R.run.path .. "/native-incarnations-" .. $label .. ".json",json_encode(rpc("noded","noded.props.get",{path:"services.incarnations"})))
  write_file($R.run.path .. "/native-topics-" .. $label .. ".json",json_encode(rpc("noded","topic.list",{})))
  for each $app in $R.owners
    if $app.name != "quoin" then comp("comp.window.focus",$app.window) end
    $live=shell("app.describe",{}).participants
    write_file($R.run.path .. "/participant-live-" .. $label .. "-" .. $app.name .. ".json",json_encode($live))
    $matches=filter($live.participants,fn($row)=$row.service == $app.context.service and $row.pid == $app.pid
      and ($app.name != "quoin" or $row.key == $app.context.service .. "/all-apps-control")
      and $row.state != "hidden" and $row.state != "closed")
    check(len($matches) == 1,"Actual single visible participant not available: " .. $app.name)
    $key=$matches[0].key
    write_file($R.run.path .. "/participant-owner-" .. $label .. "-" .. $app.name .. ".json",json_encode($f.rpc($app.context,"app.describe",{})))
    $receipt=shell("app.participants.wait",{operation_id:$batch.operation_id,services:[$app.context.service],keys:[$key],until:"presented",timeout_ms:3000})
    write_file($R.run.path .. "/participant-" .. $label .. "-" .. $app.name .. ".json",json_encode($receipt))
    $record=$participants.exact_presented($receipt,$batch.operation_id,$app.context.service,$key,$app.pid,$h.identity($batch.snapshot))
    $records=concat($records,[$record])
  end
  return {records:$records,population:to_string(len($records)) .. " distinct live participants for one changed operation",
    environment:"owned nested compositor; all owners concurrent; sequential native reveal after authority change",
    applied:$participants.quantiles(map(filter($records,fn($row)=$row.accepted_to_applied_ns != nil),fn($row)=$row.accepted_to_applied_ns)),
    presented:$participants.quantiles(map(filter($records,fn($row)=$row.accepted_to_presented_ns != nil),fn($row)=$row.accepted_to_presented_ns))}
end
fn compact_windows($area,$size)
  $compact_rows=[]
  $compact_windows=comp("comp.windows.list",{}).windows
  for each $compact_owner in filter($R.owners,fn($candidate)=$candidate.name != "quoin")
    $compact_matches=filter($compact_windows,fn($candidate)=$candidate.id == $compact_owner.window.id and $candidate.generation == $compact_owner.window.generation and $candidate.pid == $compact_owner.pid)
    check(len($compact_matches) == 1,"Compact native owner was replaced")
    $compact_window=$compact_matches[0]
    check($compact_window.width == $size.width and $compact_window.height == $size.height,"Actual compact client geometry differs from requested size")
    check($compact_window.visible and not $compact_window.minimized and not $compact_window.maximized,"Compact native owner must remain normally visible")
    check($compact_window.width > 0 and $compact_window.height > 0 and $compact_window.x >= $area.x and $compact_window.y >= $area.y and $compact_window.x+$compact_window.width <= $area.x+$area.width and $compact_window.y+$compact_window.height <= $area.y+$area.height,"Compact native window is clipped outside usable output")
    for each $compact_prior in $compact_rows
      check($compact_window.x+$compact_window.width <= $compact_prior.x or $compact_prior.x+$compact_prior.width <= $compact_window.x or $compact_window.y+$compact_window.height <= $compact_prior.y or $compact_prior.y+$compact_prior.height <= $compact_window.y,"Compact native windows overlap")
    end
    $compact_rows=concat($compact_rows,[$compact_window])
  end
  check(len($compact_rows) == 6,"Compact proof requires all six native windows")
  for each $compact_other in $compact_windows
    if not $compact_other.visible or $compact_other.minimized or any($compact_rows,fn($candidate)=$candidate.id == $compact_other.id and $candidate.generation == $compact_other.generation) then continue end
    for each $compact_row in $compact_rows
      check($compact_other.x+$compact_other.width <= $compact_row.x or $compact_row.x+$compact_row.width <= $compact_other.x or $compact_other.y+$compact_other.height <= $compact_row.y or $compact_row.y+$compact_row.height <= $compact_other.y,"Unmeasured window overlaps compact population")
    end
  end
  return $compact_rows
end
fn compact_desktop()
  $compact_output_rows=comp("comp.props.get",{path:"outputs"})
  check(len(keys($compact_output_rows)) == 1,"Compact proof requires one native output")
  $compact_output=$compact_output_rows[keys($compact_output_rows)[0]]
  check($compact_output.scale == 2.5 and $compact_output.width == 1536 and $compact_output.height == 864,"Actual compact logical output or scale differs")
  $compact_area=$compact_output.usable
  $compact_layouts=[]
  for each $compact_size in [{width:420,height:240},{width:458,height:346}]
    $compact_index=0
    for each $compact_app in filter($R.owners,fn($candidate)=$candidate.name != "quoin")
      $compact_column=$compact_index-floor($compact_index/3)*3
      $compact_row_index=floor($compact_index/3)
      comp("comp.window.focus",$compact_app.window)
      $compact_placed=comp("comp.window.place",merge($compact_app.window,{x:$compact_area.x+40+$compact_column*($compact_size.width+40),y:$compact_area.y+40+$compact_row_index*($compact_size.height+40),width:$compact_size.width,height:$compact_size.height}))
      check(deep_eq($compact_placed.requested,$compact_size),"Production native size hints clamped compact request")
      check(comp("comp.window.wait",{match:$compact_app.window,until:"size",width:$compact_size.width,height:$compact_size.height,timeout_ms:3000}).window != nil,"Actual compact client did not commit requested size")
      $compact_index=$compact_index+1
    end
    $compact_before=compact_windows($compact_area,$compact_size)
    $compact_live=shell("app.describe",{}).participants.participants
    $compact_keys=[]; $compact_services=[]; $compact_selected=[]
    for each $compact_participant_owner in $R.owners
      $compact_participant_rows=filter($compact_live,fn($candidate)=$candidate.service == $compact_participant_owner.context.service and $candidate.pid == $compact_participant_owner.pid and ($compact_participant_owner.name != "quoin" or $candidate.key == $compact_participant_owner.context.service .. "/all-apps-control") and not contains(["hidden","minimised","closed","inactive_session"],$candidate.state))
      check(len($compact_participant_rows) == 1,"Actual unique visible compact participant missing")
      check(deep_eq($compact_participant_rows[0].native_window,if $compact_participant_owner.name == "quoin" then nil else $compact_participant_owner.window end),"Compact participant belongs to a different native window")
      $compact_keys=concat($compact_keys,[$compact_participant_rows[0].key])
      $compact_services=concat($compact_services,[$compact_participant_owner.context.service])
      $compact_selected=concat($compact_selected,[{owner:$compact_participant_owner,key:$compact_participant_rows[0].key,row:$compact_participant_rows[0]}])
    end
    check(len(unique($compact_keys)) == 7,"Complete distinct compact participant population required")
    $compact_label="compact-" .. to_string($compact_size.width) .. "x" .. to_string($compact_size.height)
    -- No focus, resize, raise or sequential reveal after this real render change.
    $compact_current=rpc("settingsd","settings.get",{binding:$binding}).snapshot
    $compact_batch=apply({"ui.text_scale":1.25,"appearance.mode":if $compact_current.desktop.appearance.mode == "dark" then "light" else "dark" end},$compact_label)
    $compact_wait_path=$R.run.path .. "/participant-" .. $compact_label .. ".log"
    $compact_wait_child=own($h.call_async($mix,$R.bus,$R.run.path,"shell","app.participants.wait",{operation_id:$compact_batch.operation_id,services:$compact_services,keys:$compact_keys,until:"presented",timeout_ms:20000},$compact_wait_path,25),false)
    $compact_wait_deadline=time()+30
    while process_alive($compact_wait_child) and time() < $compact_wait_deadline sleep(0.05) end
    check(not process_alive($compact_wait_child),"Compact native wait child exceeded outer budget")
    $compact_wait_reply=$h.collect($compact_wait_path,$compact_wait_child)
    check($compact_wait_reply != nil and $compact_wait_reply.rc == 0,"Compact native presentation wait refused")
    $compact_wait=$compact_wait_reply.result
    $compact_frames=[]
    for each $compact_selected_owner in $compact_selected
      $compact_frame=$participants.exact_presented($compact_wait,$compact_batch.operation_id,$compact_selected_owner.owner.context.service,$compact_selected_owner.key,$compact_selected_owner.owner.pid,$h.identity($compact_batch.snapshot))
      for each $compact_fence in ["pid","connection_generation","registration_incarnation","surface_incarnation","native_window","frame_owner"]
        check(deep_eq($compact_frame[$compact_fence],$compact_selected_owner.row[$compact_fence]),"Compact presented frame replaced its selected owner fence: " .. $compact_fence)
      end
      $compact_frames=concat($compact_frames,[$compact_frame])
    end
    $compact_descriptions=descriptions($compact_batch,$compact_label)
    for each $compact_actual_owner in $R.owners
      check($compact_batch.snapshot.effective[$compact_actual_owner.settings_context].ui.text_scale == 1.25,"Compact owner did not receive real prepared text scale")
    end
    $compact_after=compact_windows($compact_area,$compact_size)
    $compact_geometry_before=map($compact_before,fn($candidate)={id:$candidate.id,generation:$candidate.generation,pid:$candidate.pid,x:$candidate.x,y:$candidate.y,width:$candidate.width,height:$candidate.height})
    $compact_geometry_after=map($compact_after,fn($candidate)={id:$candidate.id,generation:$candidate.generation,pid:$candidate.pid,x:$candidate.x,y:$candidate.y,width:$candidate.width,height:$candidate.height})
    check(deep_eq($compact_geometry_before,$compact_geometry_after),"Native geometry changed during compact presentation proof")
    $compact_capture=$R.run.path .. "/" .. $compact_label .. ".ppm"
    run_argv_must([$bin .. "/testkit-screenshot",$compact_capture],{timeout:10,env:$n.client_env($R.session,{})})
    $compact_pixels=$pixels.ppm($compact_capture)
    check($compact_pixels.w == 3840 and $compact_pixels.h == 2160,"Actual compact output screenshot differs from scaled mode")
    $compact_layouts=concat($compact_layouts,[{size:$compact_size,visible_before:$compact_before,visible_after:$compact_after,selected:$compact_selected,batch:$compact_batch,wait:$compact_wait,frames:$compact_frames,owners:$compact_descriptions,capture:{path:$compact_capture,sha256:hash_file($compact_capture,"sha256"),width:$compact_pixels.w,height:$compact_pixels.h}}])
  end
  $compact_receipt={output:$compact_output,layouts:$compact_layouts,environment:"owned native Wayland clients in nested software compositor",physical:false,kms:false,accepted_input:false}
  write_file($R.run.path .. "/compact-desktop.json",json_encode($compact_receipt))
  return $compact_receipt
end
fn preparation_failure_recovery()
  $healthy=rpc("settingsd","settings.get",{binding:$binding}).snapshot
  $before=shell("app.describe",{}).participants
  $keys=[]; $owners={}; $retained={}; $services=[]
  for each $app in $R.owners
    $rows=filter($before.participants,fn($row)=$row.service == $app.context.service and $row.pid == $app.pid and $row.state != "closed" and ($app.name != "quoin" or $row.key == $app.context.service .. "/all-apps-control"))
    check(len($rows) == 1,"Failure wait needs one exact admitted owner")
    $admitted_row=$rows[0]; push($keys,$admitted_row.key); push($services,$app.context.service)
    $owners[$admitted_row.key]={pid:$admitted_row.pid,connection_generation:$admitted_row.connection_generation,registration_incarnation:$admitted_row.registration_incarnation,surface_incarnation:$admitted_row.surface_incarnation,native_window:$admitted_row.native_window,frame_owner:$admitted_row.frame_owner}
    $retained[$app.context.service]=$f.rpc($app.context,"app.describe",{})
    $all.canonical($retained[$app.context.service],$app,$healthy,$binding,$manifest,$manifest_digest)
  end
  check(len($keys) == 7 and len(unique($keys)) == 7,"Seven genuine failure owners required")
  $bad=apply({"appearance.resources":{schema:1,set_id:"native-absent-resource",manifest_blake3:$manifest_digest}},"preparation-failed")
  $failure_out=$R.run.path .. "/preparation-failure-wait.log"
  $failure_child=own($h.call_async($mix,$R.bus,$R.run.path,"shell","app.participants.wait",{operation_id:$bad.operation_id,services:$services,keys:$keys,owners:$owners,until:"preparation_failed",timeout_ms:20000},$failure_out,25),false)
  $failure_deadline=time()+30
  while process_alive($failure_child) and time() < $failure_deadline sleep(0.05) end
  check(not process_alive($failure_child),"Native failure wait child exceeded outer budget")
  $failure_reply=$h.collect($failure_out,$failure_child)
  check($failure_reply != nil and $failure_reply.rc == 0,"Native failure wait failed")
  $wait=$failure_reply.result
  check($wait.until == "preparation_failed" and not $wait.deadline_elapsed,"Genuine seven-owner preparation failure did not arrive")
  $failure_descriptions=[]
  for each $app in $R.owners
    $actual=$f.rpc($app.context,"app.describe",{})
    $old=$retained[$app.context.service]
    $failed_evidence=$actual.settings.preparation_failure
    $failed_rows=filter($wait.observations.participants,fn($observed)=$observed.service == $app.context.service and contains($keys,$observed.key))
    check(len($failed_rows) == 1 and deep_eq($failed_rows[0].preparation_failure,$failed_evidence),"Selected participant and owner describe report different consumer failures")
    check($actual.pid == $app.pid and $failed_evidence != nil and deep_eq($failed_evidence.identity,$h.identity($bad.snapshot)) and deep_eq($actual.settings.current,$failed_evidence.identity),"Failure belongs to another authority/owner")
    check($failed_evidence.generation == $actual.settings.generation and deep_eq($failed_evidence.fault,$actual.settings.fault),"Typed failure is not the consumer's actual fault")
    check(deep_eq($actual.settings.applied,$old.settings.applied) and deep_eq($actual.resources,$old.resources),"Failed preparation changed last-good installed resources")
    push($failure_descriptions,{service:$app.context.service,before:$old,failed:$actual})
  end
  retained("preparation-failed")
  write_file($R.run.path .. "/preparation-failure-observed.json",json_encode({before:$before,owners:$owners,failed:$bad,wait:$wait,descriptions:$failure_descriptions,hardware:false,recovery_verified:false}))
  -- Restoring identical render input honestly advances applied evidence
  -- without a UI swap or presented frame. Request a real visible text-scale
  -- change with the valid binding when this gate requires fresh presentation.
  $restored_scale=if $healthy.desktop.ui.text_scale < 2.5 then $healthy.desktop.ui.text_scale+0.1 else $healthy.desktop.ui.text_scale-0.1 end
  $good=apply({"appearance.resources":{schema:1,set_id:$manifest.set_id,manifest_blake3:$manifest_digest},"ui.text_scale":$restored_scale},"preparation-recovered")
  for each $app in $R.owners
    check($good.snapshot.effective[$app.settings_context].ui.text_scale != $healthy.effective[$app.settings_context].ui.text_scale,"Recovery must change every selected owner's actual render input")
  end
  $recovered_frames=participant_presentations($good,"preparation-recovered")
  for each $app in $R.owners
    $actual=$f.rpc($app.context,"app.describe",{})
    check($actual.settings.preparation_failure == nil and $actual.settings.fault == nil and deep_eq($actual.settings.applied,$h.identity($good.snapshot)),"Recovery retained stale failure or unapplied authority")
  end
  retained("preparation-recovered")
  $receipt={before:$before,owners:$owners,failed:$bad,wait:$wait,descriptions:$failure_descriptions,recovered:$good,frames:$recovered_frames,hardware:false}
  write_file($R.run.path .. "/preparation-failure-recovery.json",json_encode($receipt))
  return $receipt
end
fn native_states()
  $receipts=[]
  $serial=0
  for each $app in $R.owners
    if $app.name != "quoin" then
      for each $state in ["hidden","minimised"]
        $serial=$serial+1
        if $state == "hidden" then comp("comp.window.send_to_workspace",merge($app.window,{index:2,follow:false}))
        else comp("comp.window.minimize",$app.window) end
        $batch=apply({"ui.text_scale":1.0+$serial*0.01},"participant-" .. $app.name .. "-" .. $state)
        $receipt=shell("app.participants.wait",{operation_id:$batch.operation_id,services:[$app.context.service],timeout_ms:3000})
        check(not $receipt.deadline_elapsed,"Native nonvisible owner failed to accept changed operation")
        $rows=filter($receipt.observations.participants,fn($row)=$row.service == $app.context.service and $row.pid == $app.pid)
        check(len($rows) == 1 and $rows[0].state == $state and $rows[0].phase != "presented" and $rows[0].presentation == nil,"Hidden/minimised buffer supplied false presentation")
        $key=$rows[0].key
        if $state == "hidden" then comp("comp.window.send_to_workspace",merge($app.window,{index:1,follow:false}))
        else comp("comp.window.restore",$app.window) end
        comp("comp.window.focus",$app.window)
        $fresh=shell("app.participants.wait",{operation_id:$batch.operation_id,services:[$app.context.service],keys:[$key],until:"presented",timeout_ms:3000})
        $participants.exact_presented($fresh,$batch.operation_id,$app.context.service,$key,$app.pid,$h.identity($batch.snapshot))
        $receipts=concat($receipts,[{app:$app.name,state:$state,pending:$receipt,resumed:$fresh}])
      end
    end
  end
  $term=owner("term")
  comp("comp.window.focus",$term.window)
  $description=$f.rpc($term.context,"app.describe",{})
  $identity=$term.identity
  $reference=$failure.hold($term.context,$identity,"term","participant-deadline")
  $batch=apply({"ui.text_scale":1.37},"participant-deadline")
  $reached=$f.fixture($term.context,"barrier.wait",$reference)
  check($reached.state == "reached","Actual preparation barrier did not hold")
  $deadline=shell("app.participants.wait",{operation_id:$batch.operation_id,services:[$term.context.service],until:"presented",timeout_ms:1000})
  $rows=filter($deadline.observations.participants,fn($row)=$row.service == $term.context.service)
  check($deadline.deadline_elapsed and len($rows) == 1 and $rows[0].state == "nonresponsive","Real held owner did not receive bounded nonresponsive receipt")
  check($f.fixture($term.context,"barrier.release",$reference).state == "released","Actual held owner failed release")
  $fresh=shell("app.participants.wait",{operation_id:$batch.operation_id,services:[$term.context.service],keys:[$rows[0].key],until:"presented",timeout_ms:3000})
  $participants.exact_presented($fresh,$batch.operation_id,$term.context.service,$rows[0].key,$term.pid,$h.identity($batch.snapshot))
  return {visibility:$receipts,held_deadline:$deadline,released:$fresh,
    inactive_session:{status:"hardware witness required",reason:"nested gate cannot manufacture a physical VT inactive/active transition"}}
end
fn native_idle()
  $trace=$R.run.path .. "/frame-trace.log"
  check(is_file($trace),"Actual compositor frame trace is missing")
  $offset=bytes_len(string_to_bytes(read_file($trace)))
  $batch=apply({"ui.text_scale":1.39},"participant-idle-calibration")
  $calibration=participant_presentations($batch,"idle-calibration")
  sleep(0.5)
  $calibrated=$participants.trace_counts(slice(read_file($trace),$offset))
  check($calibrated.submitted > 0,"Native trace could not see calibrated changed-operation frames")
  $offset=bytes_len(string_to_bytes(read_file($trace)))
  sleep(1.5)
  $baseline=$participants.trace_counts(slice(read_file($trace),$offset))
  $offset=bytes_len(string_to_bytes(read_file($trace)))
  for each $app in $R.owners
    $f.rpc($app.context,"app.describe",{})
  end
  $keys=map($calibration.records,fn($row)=$row.key)
  $services=map($R.owners,fn($app)=$app.context.service)
  $same=shell("app.participants.wait",{operation_id:$batch.operation_id,services:$services,keys:$keys,until:"presented",timeout_ms:3000})
  check(not $same.deadline_elapsed,"Pure observation lost current operation presentation")
  sleep(1.5)
  $observed=$participants.trace_counts(slice(read_file($trace),$offset))
  check($observed.observer_only_submitted == 0,"Pure participant observations requested compositor-only redraws")
  return {actual_output_scale:$output.scale,calibration:$calibration,calibration_trace:$calibrated,
    baseline:{seconds:1.5,trace:$baseline},observation:{seconds:1.5,trace:$observed,receipt:$same},
    guard:"no submitted frames with only Bus/Publish reasons; actual product/native timer frames reported separately",
    output_change:{status:"separate native acceptance",contract:"comp.output.scale",
      gate:"settings_all_apps_gate.mix --output-scale",
      reason:"live output mutations are checked separately from this pure observation idle interval"}}
end
fn native_samples()
  $runs=[]; $series={}; $batch_applied=[]; $batch_presented=[]
  for $index=1 to 20
    $mode=if floor($index/2)*2 == $index then "light" else "dark" end
    $batch=apply({"appearance.mode":$mode},"participant-sample-" .. to_string($index))
    $sample=participant_presentations($batch,"sample-" .. to_string($index))
    for each $record in $sample.records
      check(type($record.accepted_to_applied_ns) == "number" and type($record.accepted_to_presented_ns) == "number","Original comparable native timing unavailable for " .. $record.service)
      $prior=$series[$record.service] ?? {applied:[],presented:[]}
      $series[$record.service]={applied:concat($prior.applied,[$record.accepted_to_applied_ns]),presented:concat($prior.presented,[$record.accepted_to_presented_ns])}
    end
    $batch_applied=concat($batch_applied,[max(map($sample.records,fn($row)=$row.accepted_to_applied_ns))])
    $batch_presented=concat($batch_presented,[max(map($sample.records,fn($row)=$row.accepted_to_presented_ns))])
    $runs=concat($runs,[$sample])
  end
  $quantiles={}
  for each $service in keys($series)
    $quantiles[$service]={accepted_to_applied:$participants.quantiles($series[$service].applied),accepted_to_presented:$participants.quantiles($series[$service].presented)}
  end
  retained("measured-samples")
  return {runs:$runs,per_service:$quantiles,resident_resources:true,
    complete_batch:{accepted_to_applied:$participants.quantiles($batch_applied),accepted_to_presented:$participants.quantiles($batch_presented),
      estimator:"maximum actual comparable owner interval per changed operation; twenty complete seven-owner batches"},
    exclusions:[{claim:"simultaneous responsive visible broadcast p95",reason:"each native application is focused sequentially after authority acceptance; reveal latency remains included in samples"}],
    environment:"recorded owned nested software renderer, actual fractional output, all seven owners concurrent, sequential native reveal",
    reference_hardware:false,broadcast_only_p95_claimed:false,target_p95_ns:100000000,
    target_disposition:"measured values only; reference hardware and simultaneous visible broadcast release target remain separate acceptance"}
end
fn observe_frames($label)
  $receipts=[]
  for each $app in $R.owners
    if $app.fixture then
      comp("comp.window.focus",$app.window)
      $description=$f.rpc($app.context,"app.describe",{})
      $frame=$recovery.observe($app.context,$app.identity,$description,$label)
      $receipts=concat($receipts,[{name:$app.name,pid:$app.pid,kind:"exact native target/stamp presentation and actual root layout",frame:$frame}])
    end
  end
  return $receipts
end
fn capture_palette($app,$snapshot,$label,$width,$sample_x)
  -- A known real magenta client is raised first, then the owned client. Its
  -- pixels just outside the new width fence this stage's configure/buffer.
  comp("comp.window.focus",$background_window)
  comp("comp.window.focus",$app.window)
  comp("comp.window.place",merge($app.window,{x:0,y:0,width:$width,height:600}))
  check(comp("comp.window.wait",{match:$app.window,until:"size",width:$width,height:600,timeout_ms:5000}).window != nil,"Client width did not commit")
  $path=$app.context.root .. "/palette-" .. $label .. ".ppm"
  $wanted=$snapshot.effective[$app.settings_context].design.pairs.base.rendered_surface
  $deadline=time()+8
  $receipt=nil
  while time() < $deadline
    run_argv_must([$bin .. "/testkit-screenshot",$path],{timeout:10,env:$n.client_env($R.session,{})})
    $image=$pixels.ppm($path)
    -- The actual Ced scrollbar occupies the rightmost pixels. Sample the
    -- document base clear of it; the 32-pixel width step still puts this
    -- point beyond the previous buffer, so stale pixels cannot pass.
    $inside=$pixels.pixel($image,round(($width-16)*$output.scale),round(400*$output.scale))
    $outside=$pixels.pixel($image,round(($width+2)*$output.scale),round(400*$output.scale))
    $sample=$pixels.pixel($image,round($sample_x*$output.scale),round(400*$output.scale))
    $matches=abs($outside[0]-255) <= 3 and $outside[1] <= 3 and abs($outside[2]-255) <= 3
    for $channel=0 to 2
      if abs($inside[$channel]-$pixels.srgb($wanted[$channel])) > 8 or abs($sample[$channel]-$pixels.srgb($wanted[$channel])) > 8 then $matches=false end
    end
    if $matches then $receipt={kind:"native palette plus distinct configure/buffer boundary",path:$path,width:$width,palette:$sample,inside:$inside,outside:$outside}; break end
    sleep(0.05)
  end
  check($receipt != nil,"Native palette/boundary did not settle: " .. $app.name)
  check(deep_eq($f.rpc($app.context,"app.describe",{}).settings.applied,$h.identity($snapshot)),"Authority changed during native capture")
  write_file($app.context.root .. "/palette-" .. $label .. ".json",json_encode($receipt))
  return $receipt
end
fn quoin_capture($snapshot,$label,$scene)
  $layout=shell("shell.scene.layout",{scene:$scene})
  check($layout.visible and $layout.nodes.go != nil,"Actual Quoin button missing")
  $token=nil
  for each $candidate in $snapshot.effective.desktop.design.buttons
    if $candidate.variant == "primary" and $candidate.size == "md" and $candidate.interaction == "resting" and not $candidate.focus_visible then $token=$candidate end
  end
  check($token != nil and $token.pair.surface[3] == 1,"No opaque primary token")
  $path=$R.run.path .. "/quoin-" .. $label .. ".ppm"
  $deadline=time()+8; $receipt=nil
  while time() < $deadline
    $layout=shell("shell.scene.layout",{scene:$scene})
    run_argv_must([$bin .. "/testkit-screenshot",$path],{timeout:10,env:$n.client_env($R.session,{})})
    $image=$pixels.ppm($path)
    $go=$layout.nodes.go
    $sample=$pixels.pixel($image,round(($layout.surface.x+$go.x+8)*$output.scale),round(($layout.surface.y+$go.y+8)*$output.scale))
    $matches=true
    for $channel=0 to 2
      if abs($sample[$channel]-$pixels.srgb($token.pair.surface[$channel])) > 8 then $matches=false end
    end
    if $matches then $receipt={kind:"actual Quoin layout and native primary palette",layout:$layout,path:$path,palette:$sample}; break end
    sleep(0.05)
  end
  check($receipt != nil,"Quoin palette did not match common authority")
  check(deep_eq(shell("app.describe",{}).settings.applied,$h.identity($snapshot)),"Quoin changed during capture")
  return $receipt
end
fn scene_document($name,$citizen)
  return "---\nscene: 1\nname: " .. $name .. "\ncitizen: " .. $citizen .. "\nwindow: {\"kind\":\"edge\",\"edge\":\"bottom\",\"h\":72}\n---\n```mix\nroot: {widget: \"row\", padding: 4, fill: true, children: [\"go\"]}\ngo: {widget: \"button\", label: \"Go\", tone: \"primary\", width: 160, on_click: \"go\"}\n```\n"
end
fn retained($label)
  for each $app in $R.owners
    if $app.fixture and $app.product != nil then $product.product_retained($app,$app.product,$label) end
  end
  $ced=owner("ced")
  $after=$f.rpc($ced.context,"ced.state",{tab:$R.ced_tab,text:true})
  check($R.ced_state.buffer == $after.buffer and $R.ced_state.rev == $after.rev and
    $R.ced_state.text == $after.text and deep_eq($R.ced_state.selection,$after.selection),"Ced text/caret changed")
  $editor=owner("scene-editor")
  $after=$f.rpc($editor.context,"scene-editor.info",{})
  check(deep_eq($R.scene_state.selection,$after.selection) and $after.ui.dialog == "confirm" and
    deep_eq($R.scene_state.ui.confirmation,$after.ui.confirmation),"True Scene Editor selection/confirmation changed")
  write_file($R.run.path .. "/product-special-" .. $label .. ".json",json_encode({ced:$f.rpc($ced.context,"ced.state",{tab:$R.ced_tab,text:true}),scene_editor:$after}))
end
try
  $R.run=$n.new_run("/var/tmp/settings-all-apps")
  $root=$R.run.path
  mkdir($root .. "/core",{parents:true})
  run_argv_must([$mix,$repo .. "/share/assets/install.mix","--root",$root .. "/core/assets","--manifest",$repo .. "/share/assets/core.conf.mix"],{timeout:300,max_output:2000000})
  run_argv_must([$mix,$repo .. "/share/assets/install.mix","--root",$root .. "/core/assets","--manifest",$repo .. "/share/assets/core.conf.mix","--verify"],{timeout:30})
  $manifest=load_data($repo .. "/share/assets/core.conf.mix")
  $manifest_digest=hash_file($root .. "/core/assets/current/manifest.conf.mix","blake3")
  check($manifest_digest == hash_file($repo .. "/share/assets/core.conf.mix","blake3"),"Installed core manifest differs")
  $R.bus=$n.private_bus({dir:$root,name:"settings-all-apps",noded:$bin .. "/noded"})
  run_argv_must([$bin .. "/settingsd","seed","--allow-create","--instance","fixture","--root",$root .. "/profile"],{timeout:30})
  $authority=own(spawn([$bin .. "/settingsd","serve","--instance","fixture","--root",$root .. "/profile"],{env:env_for($root .. "/authority-home"),stdout:{file:$root .. "/settingsd.log"},stderr:"stdout",detach:true}),false)
  ready("settingsd","settings.describe",$authority)
  -- Explicit resource bindings require declared families; packaged-default
  -- remapping deliberately applies only when the resource reference is absent.
  $design=load_data($repo .. "/libs/design/src/defaults/revision-1.theme.conf.mix")
  $fixture_type_records=$design.design.v1.typography.records
  $roles={ui:"sans",ui_display:"display",small:"sans",mono:"mono",terminal:"mono"}
  for each $fixture_type_record in keys($fixture_type_records)
    $role=if $roles[$fixture_type_record] != nil then $roles[$fixture_type_record] else "ui" end
    $fixture_type_records[$fixture_type_record]=merge($fixture_type_records[$fixture_type_record],{family:$manifest.font_families[$role],fallbacks:[]})
  end
  $typography=merge($design.design.v1.typography,{records:$fixture_type_records})
  $v1=merge($design.design.v1,{typography:$typography})
  $design=merge($design,{typography:merge($design.typography,{family:$manifest.font_families.ui}),design:merge($design.design,{v1:$v1})})
  $light=apply({"appearance.source":data_encode($design),"appearance.resources":{schema:1,set_id:$manifest.set_id,manifest_blake3:$manifest_digest},"appearance.mode":"light","ui.text_scale":1.0,"ui.density":1.0,"shell.panels.bottom":{edge:"bottom",mode:"overlay",thickness:72}},"initial-light")
  mkdir($root .. "/cfg",{parents:true})
  write_file($root .. "/cfg/settings.json",read_file($repo .. "/tests/desktop/smoke-settings.json"))
  write_file($root .. "/cfg/preferences.json",json_encode({scene_host:true,scene_service:"all-apps-fallback",decorations_ssd:false}))
  $R.session=$n.start({bin:$bin .. "/compd",tag:"all-apps",run:$R.run,config:$root .. "/cfg/settings.json",
    host_renderer:"pixman",software:true,scale:$requested_scale,max_secs:900,
    width:(if $compact_mode then 1536 else 1280 end)*$requested_scale,height:(if $compact_mode then 864 else 800 end)*$requested_scale,
    env:merge(env_for($root .. "/compositor-home"),{COMPD_FRAME_TRACE:"1",COMPD_FRAME_TRACE_FILE:$root .. "/frame-trace.log",COMPD_FRAME_TRACE_LIMIT:"1000000"})})
  check($n.wait_ready($R.session,30),"Owned compositor did not register")
  ready("shell","shell.info",$R.session.comp_pid)
  check(shell("shell.info",{}).service == "shell","Real Quoin host failed canonical registration")
  comp("comp.props.set",{path:"input.host.passthrough",value:false})
  $outputs=comp("comp.props.get",{path:"outputs"})
  check(len(keys($outputs)) == 1,"Expected one owned output")
  $output=$outputs[keys($outputs)[0]]
  check($output.scale == $requested_scale,"Actual compositor output scale differs from requested fractional scale")
  check($output.width >= 1100 and $output.height >= 700,"Palette boundary proof needs 1100x700 output")
  $R.owners=concat($R.owners,[{name:"quoin",pid:$R.session.comp_pid,settings_context:"desktop",fixture:false,
    version:toml_parse(read_file($repo .. "/services/compd/Cargo.toml")).package.version,
    context:{mix:$mix,bus:$R.bus,bus_root:$root,root:$root,service:"shell"}}])
  $edit=own(spawn([$bin .. "/editd","serve"],{env:env_for($root .. "/edit-home"),stdout:{file:$root .. "/editd.log"},stderr:"stdout",detach:true}),false)
  ready("edit","edit.ping",$edit)
  mkdir($root .. "/scenes",{parents:true})
  $scenes=own(spawn([$mix,"--serve",$repo .. "/services/compd/scripts/scenes.mix","--name","scenes"],
    {env:merge(env_for($root .. "/scenes-home"),{SCENES_DIR:$root .. "/scenes",SCENES_TEMPLATES:$repo .. "/share/scenes",SCENES_LIB:$repo .. "/share/scenes/lib",SCENE_HOST:"shell",SCENES_FIRST_RUN:"0",SCENES_EDITOR_APP:"1",SCENE_EDITOR_SERVICE:"scene-editor-main"}),stdout:{file:$root .. "/scenes.log"},stderr:"stdout",detach:true}),false)
  ready("scenes","scenes.list",$scenes)
  check(rpc("scenes","scenes.install",{template:"calendar",enable:false}).installed,"Real calendar did not install")
  write_file($root .. "/controls.mix","on go\n append_file(" .. json_encode($root .. "/controls-events.jsonl") .. ",json_encode($event.args) .. \"\\n\")\n reply(\"ok\")\nend\n")
  write_file($root .. "/controls-events.jsonl","")
  $citizen=own(spawn([$mix,"--serve",$root .. "/controls.mix","--name","all-apps-controls"],{env:env_for($root .. "/controls-home"),stdout:{file:$root .. "/controls.log"},stderr:"stdout",detach:true}),false)
  ready("all-apps-controls","HELP",$citizen)
  shell("shell.scene.load",{source:scene_document("all-apps-control","all-apps-controls")})
  $deadline=time()+10
  $panel=nil
  while time() < $deadline
    $panel=shell("shell.panel.state",{edge:"bottom"})
    if $panel.mode == "pinned" and $panel.settings != nil and $panel.settings.presented_px == 72 then break end
    $panel=nil
    sleep(0.05)
  end
  check($panel != nil,"Settings-owned bottom panel did not become pinned")
  shell("shell.panel.page.set",{edge:"bottom",id:"scene-all-apps-control"})
  for each $dir in ["left","right"] mkdir($root .. "/" .. $dir,{parents:true}) end
  write_file($root .. "/left/owned-file.txt","simultaneous native file\n")
  write_file($root .. "/document.txt","simultaneous native Ced text\n")
  copy($repo .. "/share/brand/favicons/white-on-black/icon-512.png",$root .. "/source.png")
  for each $name in ["term","busviewer","cap","dopus","ced","scene-editor"]
    $app=launch($name,"main",contains(["term","busviewer","cap","dopus"],$name))
    $all.current($app.context,$app.pid,$light.snapshot,$binding,$app.settings_context,15)
    if $app.fixture then
      $state=$product.prepare_product($app)
      $updated=merge($app,{product:$state})
      $R.owners=map($R.owners,fn($o)=if $o.pid == $app.pid then $updated else $o end)
    end
  end
  $ced=owner("ced")
  $tabs=$f.rpc($ced.context,"ced.tabs",{}).tabs
  check(len($tabs) == 1,"Ced document not opened exactly once")
  $R.ced_tab=$tabs[0].tab
  $f.rpc($ced.context,"ced.wait",{tab:$R.ced_tab,phase:"live",timeout_ms:10000})
  $f.rpc($ced.context,"ced.select",{tab:$R.ced_tab,anchor:5,head:5})
  $R.ced_state=$f.rpc($ced.context,"ced.state",{tab:$R.ced_tab,text:true})
  $editor=owner("scene-editor")
  $f.rpc($editor.context,"scene-editor.show",{view:"installed",scene:"calendar"})
  $deadline=time()+15; $selected=nil
  while time() < $deadline
    $selected=$f.rpc($editor.context,"scene-editor.info",{})
    if not $selected.busy and $selected.snapshot != nil and $selected.snapshot.host_problem == nil and $selected.selection.scene == "calendar" and $selected.selection.view == "installed" then break end
    $selected=nil; sleep(0.05)
  end
  check($selected != nil,"True Scene Editor calendar selection unavailable")
  if $compact_mode then compact_desktop() end
  comp("comp.window.focus",$editor.window)
  for each $key in ["F10","Right","Right","End","Return"] comp("comp.input.key",{seat:"human",window:$editor.window,key:$key}) end
  $deadline=time()+5; $confirm=nil
  while time() < $deadline
    $confirm=$f.rpc($editor.context,"scene-editor.info",{})
    if $confirm.ui.dialog == "confirm" and $confirm.ui.confirmation != nil then break end
    $confirm=nil; sleep(0.05)
  end
  check($confirm != nil and $confirm.ui.confirmation.action.action == "remove" and $confirm.ui.confirmation.selection.scene == "calendar","Actual frozen remove confirmation missing")
  $R.scene_state=$confirm
  $probe=own(spawn([$bin .. "/testkit-input-probe","--app-id","dev.mixos.AllAppsBoundary","--size",to_string($output.width) .. "x" .. to_string($output.height-72),"--seconds","900","--colour","ff00ff"],{env:$n.client_env($R.session,{}),stdout:{file:$root .. "/boundary.log"},stderr:"stdout",detach:true}),false)
  $row=comp("comp.window.wait",{match:{app_id:"dev.mixos.AllAppsBoundary"},until:"presented",timeout_ms:5000}).window
  $background_window={id:$row.id,generation:$row.generation}
  comp("comp.window.place",merge($background_window,{x:0,y:0,width:$output.width,height:$output.height-72}))
  $batches=[$light]
  for each $round in [{label:"light",changes:nil},{label:"dark-scaled",changes:{"appearance.mode":"dark","ui.text_scale":1.25,"ui.density":1.2}},{label:"light-dense",changes:{"appearance.mode":"light","ui.text_scale":1.1,"ui.density":0.9}}]
    $batch=if $round.changes == nil then $light else apply($round.changes,$round.label) end
    $descriptions=descriptions($batch,$round.label)
    simultaneously_alive()
    retained($round.label)
    $frames=observe_frames($round.label)
    $width=1000+len($R.rounds)*32
    $ced_palette=capture_palette($ced,$batch.snapshot,$round.label,$width,200)
    $editor_palette=capture_palette($editor,$batch.snapshot,$round.label,$width+1,5)
    $quoin_palette=quoin_capture($batch.snapshot,$round.label,"all-apps-control")
    $participant_receipts=if $round.changes == nil then {unavailable:"initial authority operation preceded owner bootstrap"} else participant_presentations($batch,$round.label) end
    $R.rounds=concat($R.rounds,[{label:$round.label,identity:$h.identity($batch.snapshot),owners:$descriptions,frames:$frames,
      ced:$ced_palette,scene_editor:$editor_palette,quoin:$quoin_palette,participants:$participant_receipts,
      observation_upper_bound_ms:(time()-$batch.issued)*1000,latency_kind:"sequential observation and capture upper bound; no percentiles"}])
  end
  $participant_states=native_states()
  $participant_idle=native_idle()
  write_file($root .. "/participants-native-idle.json",json_encode($participant_idle))
  $participant_samples=native_samples()
  $preparation_failure=preparation_failure_recovery()
  write_file($root .. "/participants-native-samples.json",json_encode($participant_samples))
  -- A newly created app/control resolves the changed authority while all
  -- original citizens remain alive and retain their genuine product state.
  $late=launch("busviewer","late",true)
  $changed=rpc("settingsd","settings.get",{binding:$binding}).snapshot
  $late_description=$all.current($late.context,$late.pid,$changed,$binding,$late.settings_context,15)
  write_file($late.context.root .. "/description-late.json",json_encode($late_description))
  $all.canonical($late_description,$late,$changed,$binding,$manifest,$manifest_digest)
  comp("comp.window.focus",$late.window)
  $late_frame=$recovery.observe($late.context,$late.identity,$late_description,"late")
  $late_citizen=own(spawn([$mix,"--serve",$root .. "/controls.mix","--name","all-apps-late-controls"],{env:env_for($root .. "/late-controls-home"),stdout:{file:$root .. "/late-controls.log"},stderr:"stdout",detach:true}),false)
  ready("all-apps-late-controls","HELP",$late_citizen)
  shell("shell.scene.load",{source:scene_document("all-apps-late-control","all-apps-late-controls")})
  shell("shell.panel.page.set",{edge:"bottom",id:"scene-all-apps-late-control"})
  $late_control=quoin_capture($changed,"late","all-apps-late-control")
  $offset=bytes_len(string_to_bytes(read_file($root .. "/controls-events.jsonl")))
  $go=$late_control.layout.nodes.go
  comp("comp.input.pointer.move",{seat:"human",x:$late_control.layout.surface.x+$go.x+$go.w/2,y:$late_control.layout.surface.y+$go.y+$go.h/2})
  comp("comp.input.pointer.button",{seat:"human",button:"left",action:"click"})
  $deadline=time()+5; $click=nil
  while time() < $deadline
    $fresh=slice(read_file($root .. "/controls-events.jsonl"),$offset)
    if trim($fresh) != "" then
      $click=json_parse(lines(trim($fresh))[0]); break
    end
    sleep(0.05)
  end
  check($click != nil and $click.scene == "all-apps-late-control" and $click.node == "go" and $click.kind == "click","New actual Quoin control did not dispatch native input")
  $late_control=merge($late_control,{click:$click})
  simultaneously_alive()
  retained("late")
  $quoin=owner("quoin")
  $quoin_key=$quoin.context.service .. "/all-apps-control"
  $quoin_batch=apply({"ui.text_scale":1.41},"participant-quoin-hidden")
  $quoin_hidden=shell("app.participants.wait",{operation_id:$quoin_batch.operation_id,services:[$quoin.context.service],keys:[$quoin_key],timeout_ms:3000})
  $hidden_rows=filter($quoin_hidden.observations.participants,fn($row)=$row.key == $quoin_key)
  check(not $quoin_hidden.deadline_elapsed and len($hidden_rows) == 1 and $hidden_rows[0].state == "hidden" and $hidden_rows[0].presentation == nil,"Hidden native Quoin scene supplied false presentation")
  shell("shell.panel.page.set",{edge:"bottom",id:"scene-all-apps-control"})
  $quoin_revealed=shell("app.participants.wait",{operation_id:$quoin_batch.operation_id,services:[$quoin.context.service],keys:[$quoin_key],until:"presented",timeout_ms:3000})
  $participants.exact_presented($quoin_revealed,$quoin_batch.operation_id,$quoin.context.service,$quoin_key,$quoin.pid,$h.identity($quoin_batch.snapshot))
  shell("shell.scene.unload",{scene:"all-apps-late-control"})
  $quoin_closed=shell("app.participants.wait",{operation_id:$quoin_batch.operation_id,services:[$quoin.context.service],keys:[$quoin.context.service .. "/all-apps-late-control"],until:"closed",timeout_ms:3000})
  check(not $quoin_closed.deadline_elapsed,"Unloaded native Quoin scene failed retirement")
  $late_rows=filter(shell("app.describe",{}).participants.participants,fn($row)=$row.service == $late.context.service and $row.pid == $late.pid)
  write_file($root .. "/participant-recreate-old.json",json_encode($late_rows))
  check(len($late_rows) == 1,"Late native owner did not join participant registry")
  comp("comp.window.close",merge($late.window,{force:false}))
  $closed=shell("app.participants.wait",{operation_id:"all-apps-participant-deadline",services:[$late.context.service],keys:[$late_rows[0].key],until:"closed",timeout_ms:3000})
  write_file($root .. "/participant-recreate-closed.json",json_encode($closed))
  $closed_rows=filter($closed.observations.participants,fn($row)=$row.key == $late_rows[0].key)
  check(not $closed.deadline_elapsed and len($closed_rows) == 1 and $closed_rows[0].state == "closed" and $closed_rows[0].presentation == nil,"Closed native owner retained a live presentation")
  $retired_deadline=time()+5
  while process_alive($late.pid) and time() < $retired_deadline sleep(0.05) end
  check(not process_alive($late.pid),"Native closed owner did not finish process and broker retirement before recreation")
  $R.owners=filter($R.owners,fn($app)=$app.pid != $late.pid)
  $replacement=launch("busviewer","late",true)
  $replacement_description=$all.current($replacement.context,$replacement.pid,$quoin_batch.snapshot,$binding,$replacement.settings_context,15)
  write_file($root .. "/participant-recreate-description.json",json_encode($replacement_description))
  $all.canonical($replacement_description,$replacement,$quoin_batch.snapshot,$binding,$manifest,$manifest_digest)
  comp("comp.window.focus",$replacement.window)
  $replacement_receipt=shell("app.participants.wait",{operation_id:$quoin_batch.operation_id,services:[$replacement.context.service],keys:[$replacement.context.service],until:"presented",timeout_ms:3000})
  write_file($root .. "/participant-recreate-new.json",json_encode($replacement_receipt))
  $replacement_rows=filter($replacement_receipt.observations.participants,fn($row)=$row.service == $replacement.context.service and $row.pid == $replacement.pid and $row.state != "closed")
  check(len($replacement_rows) == 1 and $replacement_rows[0].pid != $late_rows[0].pid
    and $replacement_rows[0].registration_incarnation != $late_rows[0].registration_incarnation
    and $replacement_rows[0].surface_incarnation != $late_rows[0].surface_incarnation
    and $replacement_rows[0].native_window != nil and $late_rows[0].native_window != nil
    and not deep_eq($replacement_rows[0].native_window,$late_rows[0].native_window),"Recreated same-service native owner reused retired scoped identity")
  $participants.exact_presented($replacement_receipt,$quoin_batch.operation_id,$replacement.context.service,$replacement_rows[0].key,$replacement.pid,$h.identity($quoin_batch.snapshot))
  $broker_before=shell("app.describe",{}).participants
  $R.bus=$n.restart_private_bus(merge($R.bus,{restart_record:"restart.json"}))
  $reconnected=[]
  for each $app in $R.owners
    $reconnected=concat($reconnected,[merge($app,{context:merge($app.context,{bus:$R.bus})})])
  end
  $R.owners=$reconnected
  ready("shell","app.describe",$quoin.pid)
  ready("settingsd","settings.describe",$authority)
  $broker_batch=apply({"appearance.mode":"dark"},"participant-broker-replacement")
  $broker_after=participant_presentations($broker_batch,"broker-replacement")
  for each $row in $broker_after.records
    $prior=filter($broker_before.participants,fn($old)=$old.key == $row.key and $old.pid == $row.pid)
    check(len($prior) == 1 and $row.registration_incarnation != $prior[0].registration_incarnation and $row.connection_generation > $prior[0].connection_generation,"Broker replacement reused retired participant registration or generation")
    check($row.frame_owner == $prior[0].frame_owner and deep_eq($row.native_window,$prior[0].native_window),"Broker replacement recreated actual native participant")
  end
  $inventory=rpc("noded","noded.inventory",{})
  $binary_hashes=[]
  for each $name in ["mix","noded","settingsd","compd","editd","term","ced","busviewer","cap","dopus","scene-editor","testkit-screenshot","testkit-input-probe"]
    $binary_hashes=concat($binary_hashes,[{binary:$name,sha256:hash_file($bin .. "/" .. $name,"sha256")}])
  end
  write_file($root .. "/acceptance.json",json_encode({source:trim(run_argv_must(["git","-C",$repo,"rev-parse","HEAD"])),
    source_tree:trim(run_argv_must(["git","-C",$repo,"rev-parse","HEAD^{tree}"])),binary_hashes:$binary_hashes,broker:{pid:$R.bus.pid,url:$R.bus.url},
    compositor:{pid:$R.session.comp_pid,service:$R.session.service,backend:"nested"},native_inventory:$inventory,
    all_six_simultaneous:true,quoin:true,core_set:$manifest.set_id,core_manifest_blake3:$manifest_digest,rounds:$R.rounds,participant_states:$participant_states,participant_idle:$participant_idle,participant_samples:$participant_samples,
    new_app:{pid:$late.pid,description:$late_description,frame:$late_frame,closed:$closed,recreated:$replacement_receipt},new_control:$late_control,
    quoin_lifecycle:{hidden:$quoin_hidden,revealed:$quoin_revealed,retired:$quoin_closed},
    broker_replacement:{before:$broker_before,after:$broker_after},preparation_failure:$preparation_failure,
    hardware:false,actual_output_scale:$output.scale,quantile_population:"actual monotonic durations across current operation participants; small measured sample count explicit",exact_frame_participants:["term","busviewer","cap","dopus"],
    palette_boundary_participants:["ced","scene-editor"],quoin_palette_layout:true}))
  $R.ok=true
catch $message
  print("FAIL simultaneous settings: " .. $message)
finally
  if $R.bus != nil and is_file($R.bus.dir .. "/restart.json") then
    try
      $replacement=json_parse(read_file($R.bus.dir .. "/restart.json"))
      check($replacement.dir == $R.bus.dir and $replacement.node == $R.bus.node and $replacement.port == $R.bus.port,"Broker restart ledger belongs to another owner")
      $h.stop($replacement.pid)
    catch $error $R.ok=false; print("FAIL replacement broker teardown: " .. $error) end
  end
  for each $child in $R.children
    try check($pty.stop_child($child),"Owned child survived teardown") catch $error
      $R.ok=false; print("FAIL owned teardown: " .. $error)
    end
  end
  if $R.session != nil then
    try
      $n.stop($R.session)
      for each $child in $R.session.pids $h.stop($child) end
    catch $error $R.ok=false; print("FAIL session teardown: " .. $error) end
  end
  if $R.bus != nil then
    try $h.stop($R.bus.pid) catch $error $R.ok=false; print("FAIL broker teardown: " .. $error) end
  end
  $n.finish_run($R.run,$R.ok)
end
if not $R.ok then exit(1) end
print("PASS simultaneous six-app+Quoin shared authority, complete core resources, retained products, distinct native frame/palette evidence and late app/control; nested evidence only")
