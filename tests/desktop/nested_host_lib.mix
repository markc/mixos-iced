-- nested_host_lib.mix — start, drive and stop a PRIVATE nested compd on its
-- version: 0.2.2
-- own headless weston host.
--
--   $n = require("nested_host_lib.mix")   -- from a script beside it
--
-- Rather than nesting in a live desktop session, it brings its own host, as
-- nested_smoke does, so a build worker with no desktop can run every gate.
-- Everything is private to one run directory: the host, the compositor's
-- socket, its Bus service name, its MIXOS_ETC, MIXOS_VAR and MIXOS_RUN.
-- Nothing touches a live desktop.
--
-- Binaries: mix and noded are looked up in /opt/mixos/bin; compd and the
-- testkit probes in /opt/compd/bin (a gate's --bin names a build instead).
--
--   start({bin, tag, config, env, max_secs})
--   wait_ready(session, seconds)   ping the session's own Bus service
--   call(service, verb, map)       one Bus request, structured refusal kept
--   stop(session)                  tear down what start() created
--   new_run(prefix)                create and record a fresh scratch directory
--   finish_run(record|nil, ok)     remove owned scratch only after a full PASS
--   require_binary(name, override, dirs)
--   log_has / await_log            read what a child process wrote
--   private_bus({dir, name, noded?, fixed_port?, listen_ip?, peers?, mesh_open?})
--                                  one owned broker; returns a self-contained
--                                  ownership record for restart_private_bus
--   private_bus_pair({dir, noded?, run_token?})
--                                  two owned loopback brokers with a native
--                                  roster-mode mesh; no global env touched
--   restart_private_bus(record)    restart that broker at its exact endpoint

-- Return the ownership record explicitly: required modules capture state for
-- reads, so a module-global registry would not persist between helper calls.
-- mktemp's exclusive creation avoids reusing an earlier run's evidence.
fn new_run($prefix)
  $path = trim(run_argv_must(["mktemp", "-d", "--", $prefix .. ".XXXXXX"]))
  -- Name it immediately, so even an interrupted setup leaves a breadcrumb.
  print("run artefacts: " .. $path)
  -- The first broker can precede start(). BUS-013 needs user-traversable
  -- ancestors at bind time; only this newly and exclusively owned root is
  -- widened, while private contents stay in their protected children.
  print(run_argv_must(["chmod", "0711", $path]))
  return {path: $path, owner_pid: pid(), identity: stat($path, {follow_symlinks: false})}
end

-- The gate keeps new_run()'s record BEFORE calling start(), so aborted setup
-- can still finish it. nil means no directory was created. Call from finally
-- with ok=false until all checks AND process teardown have completed; logs
-- belong inside this directory, never loose files in /tmp.
fn finish_run($run, $ok)
  if $run == nil then return end
  if type($run) != "map" or $run.owner_pid != pid() or $run.identity == nil then
    raise("RUN_NOT_OWNED", "refusing to clean a directory without this run's ownership record")
  end
  $path = $run.path
  -- COMPD_KEEP_RUN=1 keeps a passing run's artefacts (screenshots, logs) on purpose.
  if not $ok or env("COMPD_KEEP_RUN", "") != "" then
    print("kept run artefacts: " .. $path)
    return
  end
  try
    if exists($path, {follow_symlinks: false}) then
      $now = stat($path, {follow_symlinks: false})
      $owned = $run.identity
      if not $now.is_dir or $now.is_symlink or $now.dev != $owned.dev or $now.ino != $owned.ino then
        raise("RUN_CHANGED", "run directory identity changed: " .. $path)
      end
      remove_dir($path)
    end
  catch $error
    print("cleanup failed; kept run artefacts: " .. $path .. " (" .. $error .. ")")
    raise("RUN_CLEANUP", "could not remove passing run artefacts: " .. $path)
  end
end

-- A binary for a gate: the caller's --flag, else the first of `dirs` that
-- has it. A gate runs what is installed unless the caller names a build.
fn binary($name, $override, $dirs)
  if $override != nil and $override != "" then
    if not is_file($override) then
      print("  ERROR: no such binary: " .. $override)
      exit(2)
    end
    return $override
  end
  for each $dir in $dirs ?? ["/opt/compd/bin"]
    $p = $dir .. "/" .. $name
    if is_file($p) then
      return $p
    end
  end
  return ""
end

fn require_binary($name, $override, $dirs)
  $p = binary($name, $override, $dirs)
  if $p == "" then
    print("  ERROR: no " .. $name .. " — pass its path, or install it into one of " ..
      json_encode($dirs ?? ["/opt/compd/bin"]))
    exit(2)
  end
  return $p
end

-- Where a gate's testkit probes (testkit-input-probe,
-- testkit-presentation-probe) are looked for: beside the compd `bin` a gate
-- was given, then /opt/compd/bin. A probe is built with the compd it tests,
-- so the one beside a named build wins over an installed copy (which can
-- predate the flags a gate needs).
fn probe_dirs($bin)
  $dirs = []
  if $bin != nil and $bin != "" then
    push($dirs, dirname($bin))
  end
  if not contains($dirs, "/opt/compd/bin") then
    push($dirs, "/opt/compd/bin")
  end
  return $dirs
end

-- A probe's `--version` line, or why there is none (a probe that predates
-- the version flag refuses it as an unknown argument).
fn probe_version($path)
  $r = run_argv([$path, "--version"], {timeout: 5})
  $out = trim($r.stdout)
  if $r.exit_code == 0 and $out != "" then
    return split($out, "\n")[0]
  end
  $err = trim($r.stderr .. " " .. $r.stdout)
  if $err == "" then
    $err = "exit " .. to_string($r.exit_code)
  end
  return "unversioned (" .. split($err, "\n")[0] .. ")"
end

-- require_binary for a probe over probe_dirs, printing which one was used
-- and its version.
fn require_probe($name, $override, $bin)
  $p = require_binary($name, $override, probe_dirs($bin))
  print("  probe " .. $name .. ": " .. $p .. " — " .. probe_version($p))
  return $p
end

-- One Bus request. The body travels as JSON, which keeps a structured
-- refusal whole; a child `mix` keeps `$rc` / `$result` out of the caller's
-- globals (a send in a fn would clobber them). Returns {rc, result}: rc 0 on
-- success, >= 10 for a peer refusal, -9 when the child itself failed.
fn call($service, $verb, $args)
  $body = json_encode($args)
  $script = "$b = " .. json_encode($body) .. "\nsend " .. json_encode($service) ..
    " " .. $verb .. " body=$b timeout=30\nprint($rc)\nprint(json_encode($result))\n"
  $mix = env("MIXOS_TEST_MIX", "/opt/mixos/bin/mix")
  $r = run_argv([$mix, "-c", $script], {timeout: 60})
  $lines = split(trim($r.stdout), "\n")
  if len($lines) < 2 then
    return {rc: -9, result: trim($r.stdout .. " " .. $r.stderr)}
  end
  $result = json_parse(join(slice($lines, 1), "\n"))
  -- A refusal body can arrive as its JSON text; decode it so callers read
  -- the fields either way.
  if type($result) == "string" and starts_with($result, "{") then
    $result = json_parse($result)
  end
  return {rc: to_number(trim($lines[0])), result: $result}
end

-- The broker URL compd dials: the one this script's own `send` reaches
-- (MIXOS_NODED_URL, else the node config's wg_ip and noded.port).
fn noded_url()
  $set = env("MIXOS_NODED_URL", "")
  if $set != "" then
    return $set
  end
  for each $path in [env("HOME", "") .. "/.config/mixos/node.conf.mix", "/etc/mixos/node.conf.mix"]
    if is_file($path) then
      $c = load_data($path)
      $host = $c.wg_ip ?? ""
      if $host == "" then
        $host = "127.0.0.1"
      end
      $port = 4200
      if $c.noded != nil and $c.noded.port != nil then
        $port = $c.noded.port
      end
      return "ws://" .. $host .. ":" .. to_string($port) .. "/ws"
    end
  end
  return "ws://127.0.0.1:4200/ws"
end

fn _alive($p)
  return $p != nil and exists("/proc/" .. to_string($p))
end

-- The broker record's explicit per-operation environment. Every helper below
-- selects its broker THIS way; nothing reads the exports private_bus() sets,
-- which another broker start may have replaced by now.
fn _bus_env($broker)
  return {MIXOS_NODED_URL:$broker.url,COSMIX_NODED_URL:$broker.url,
    MIXOS_NODE_CONFIG:$broker.conf,COSMIX_NODE_CONFIG:$broker.conf,
    MIXOS_RUN:$broker.dir .. "/run",MIXOS_ETC:$broker.dir .. "/etc",MIXOS_VAR:$broker.dir .. "/var",
    HOME:$broker.dir .. "/home",MIXOS_BROKER_ACCOUNT:$broker.account}
end

-- One Bus request against an EXPLICIT broker record: the child mix gets the
-- record's own env, so no exported or inherited broker address can leak in.
fn _call_at($broker, $service, $verb, $args)
  $body = json_encode($args)
  $script = "$b = " .. json_encode($body) .. "\nsend " .. json_encode($service) ..
    " " .. $verb .. " body=$b timeout=30\nprint($rc)\nprint(json_encode($result))\n"
  $mix = env("MIXOS_TEST_MIX", "/opt/mixos/bin/mix")
  $r = run_argv([$mix, "-c", $script], {timeout: 60, env: _bus_env($broker)})
  $lines = split(trim($r.stdout), "\n")
  if len($lines) < 2 then
    return {rc: -9, result: trim($r.stdout .. " " .. $r.stderr)}
  end
  $result = json_parse(join(slice($lines, 1), "\n"))
  -- A refusal body can arrive as its JSON text; decode it so callers read
  -- the fields either way.
  if type($result) == "string" and starts_with($result, "{") then
    $result = json_parse($result)
  end
  return {rc: to_number(trim($lines[0])), result: $result}
end

-- Exact-ownership readiness: noded.info must name this node AND the spawned
-- PID. Any other answer (a generic pong from an unrelated broker on this
-- port, or a malformed body) is rejected, never accepted as readiness.
fn _broker_ready($name, $pid, $broker)
  for $ready = 1 to 60
    if not process_alive($pid) then return false end
    $info = _call_at($broker, "noded", "noded.info", {})
    if $info.rc == 0 then
      if type($info.result) != "map" or $info.result.noded == nil then return false end
      return $info.result.node == $name and $info.result.noded.pid == $pid and process_alive($pid)
    end
    sleep(0.25)
  end
  return false
end

-- Write the owned node config (and the owned mesh roster when there is one)
-- and return the exact serve argv. A mesh roster is an explicit isolated
-- test configuration: Unverified etc-roster-fallback routing, never a
-- signed/Verified trust root.
fn _write_owned_config($spec)
  $endpoint = $spec.dir .. "/run/noded/bus.sock"
  $noded_cfg = {port: $spec.port, admission: "off", unix_socket: $endpoint}
  if $spec.mesh_open != nil then $noded_cfg["mesh_open"] = $spec.mesh_open end
  write_file($spec.conf, json_encode({node: $spec.name, wg_ip: $spec.wg_ip,
    mesh: $spec.name .. ".invalid", noded: $noded_cfg}))
  $serve = [$spec.noded, "serve", "--listen", $spec.listen_ip .. ":" .. to_string($spec.port),
    "--node", $spec.name, "--no-monitor", "--no-log"]
  if len($spec.peers) > 0 then
    write_file($spec.mesh_conf, json_encode({node_name: $spec.name, peers: $spec.peers}))
    push($serve, "--mesh-config")
    push($serve, $spec.mesh_conf)
  end
  return $serve
end

-- Spawn one owned broker from a complete spec and return its record. The
-- record is self-contained (root, endpoint, mesh path, listen IP, peer
-- list, fixed port, exact executable and the captured spawn env), so a
-- later restart never re-reads globals or exports.
fn _spawn_owned($spec, $serve)
  $p = spawn($serve, {clear_env:true, env: {PATH:$spec.path_env, USER:$spec.user_env,
    HOME:$spec.dir .. "/home", MIXOS_ETC:$spec.dir .. "/etc", MIXOS_VAR:$spec.dir .. "/var",
    MIXOS_RUN:$spec.dir .. "/run", MIXOS_NODE_CONFIG:$spec.conf},
    stdout: {file: $spec.log}, stderr: "stdout", detach: true})
  $mesh_conf = ""
  if len($spec.peers) > 0 then $mesh_conf = $spec.mesh_conf end
  return {pid:$p, conf:$spec.conf, url:"ws://" .. $spec.listen_ip .. ":" .. to_string($spec.port) .. "/ws",
    port:$spec.port, log:$spec.log, node:$spec.name, dir:$spec.dir,
    endpoint:$spec.dir .. "/run/noded/bus.sock", mesh_conf:$mesh_conf,
    listen_ip:$spec.listen_ip, peers:$spec.peers, fixed_port:$spec.fixed_port,
    mesh_open:$spec.mesh_open, wg_ip:$spec.wg_ip, exe:$spec.noded,
    path_env:$spec.path_env, user_env:$spec.user_env, account:$spec.account}
end

-- Bounded stop + reap of one owned child. Raises rather than leaving an
-- unreaped listener behind for the next attempt.
fn _retire_owned($pid)
  if $pid == nil or not _alive($pid) then return end
  $k = kill($pid, 15)
  for $wait = 1 to 40
    if not process_alive($pid) then return end
    sleep(0.05)
  end
  $k = kill($pid, 9)
  for $wait = 1 to 40
    if not process_alive($pid) then return end
    sleep(0.05)
  end
  raise("BROKER", "Owned child " .. to_string($pid) .. " did not retire")
end

-- A private broker for a gate whose citizens have FIXED Bus names (editd
-- registers `edit`, which a host's own editd may hold). Starts noded
-- (/opt/mixos/bin, or `noded: PATH`) on a random loopback port with
-- admission off, then EXPORTS MIXOS_NODE_CONFIG and MIXOS_NODED_URL into
-- this process, so everything started afterwards (start()'s compositor,
-- call()'s child mix, the gate's clients) talks to it. Call it before
-- start(); stop_bus() at the end.
--
--   private_bus({dir: PATH, name: "desk-gate", noded: PATH?,
--                fixed_port: N?, listen_ip: "127.0.0.1"?, peers: [...]?,
--                mesh_open: BOOL?})
--
-- fixed_port rebinds that exact port on every attempt: a bind/ownership
-- failure fails this start, it never silently moves to another port.
-- listen_ip is the explicit loopback bind (default 127.0.0.1). peers is a
-- roster of {name, mesh_ip, noded_port} written to an owned mesh.conf.mix
-- and passed with --mesh-config (Unverified etc-roster-fallback routing;
-- no signed trust root is created or implied). mesh_open is written into
-- the owned node config explicitly when given.
--
-- Returns an owned broker record {pid, conf, url, port, log, node, dir,
-- endpoint, mesh_conf, listen_ip, peers, fixed_port, mesh_open, wg_ip, exe,
-- path_env, user_env, account}, or exits 2 when it never answers.
fn private_bus($opts)
  $dir = $opts["dir"]
  $name = $opts["name"] ?? "gate"
  $noded = binary("noded", $opts["noded"] ?? "", ["/opt/mixos/bin"])
  if $noded == "" then
    print("  ERROR: no noded for the private broker (pass --noded PATH, or install it into /opt/mixos/bin)")
    exit(2)
  end
  mkdir($dir, {parents: true})
  -- Native ingress requires traversable socket ancestors. Private data stays
  -- in separate restricted children; never widen an unrelated directory.
  print(run_argv_must(["chmod", "0711", $dir]))
  for each $child in ["etc", "var", "run", "home"]
    mkdir($dir .. "/" .. $child, {parents:true})
  end
  $conf = $dir .. "/node.conf.mix"
  $log = $dir .. "/noded.log"
  export MIXOS_NODE_CONFIG=$conf
  export MIXOS_RUN=$dir .. "/run"
  export MIXOS_BROKER_ACCOUNT=trim(run_argv_must(["id", "-un"]))
  -- The staged runtime still uses the frozen pre-transplant config names.
  -- Both generations must reach this owned broker, never the host broker.
  export COSMIX_NODE_CONFIG=$conf
  $listen_ip = $opts["listen_ip"] ?? "127.0.0.1"
  $peers = $opts["peers"] ?? []
  $spec = {noded:$noded, dir:$dir, name:$name, listen_ip:$listen_ip,
    wg_ip:"", peers:$peers, mesh_open:$opts["mesh_open"],
    conf:$conf, mesh_conf:$dir .. "/mesh.conf.mix", fixed_port:$opts["fixed_port"],
    path_env:env("PATH"), user_env:env("USER"), account:env("MIXOS_BROKER_ACCOUNT")}
  for $attempt = 1 to 10
    -- first_port is an isolated-fixture seam for forcing a bind collision.
    -- With fixed_port every attempt keeps that exact port; a failed bind
    -- then fails this start instead of silently picking another port.
    $port = random(47000,47999)
    if $spec.fixed_port != nil then
      $port = $spec.fixed_port
    elif $attempt == 1 and $opts.first_port != nil then
      $port = $opts.first_port
    end
    $attempt_log = if $attempt == 1 then $log else $dir .. "/noded-" .. to_string($attempt) .. ".log" end
    $b_spec = merge($spec, {port: $port, log: $attempt_log})
    $b = _spawn_owned($b_spec, _write_owned_config($b_spec))
    $url = $b.url
    export MIXOS_NODED_URL=$url
    export COSMIX_NODED_URL=$url
    for $ready = 1 to 60
      if not process_alive($b.pid) then break end
      $info = call("noded","noded.info",{})
      if $info.rc == 0 then
        if $info.result.node == $name and $info.result.noded.pid == $b.pid and process_alive($b.pid) then
          return $b
        end
        -- A generic pong can belong to an unrelated broker on this port.
        break
      end
      sleep(0.25)
    end
    if process_alive($b.pid) then
      $k = kill($b.pid, 15)
      for $stopped = 1 to 40
        if not process_alive($b.pid) then break end
        sleep(0.05)
      end
      if process_alive($b.pid) then raise("BROKER","Owned failed broker did not retire") end
    end
    print("private broker retry after failed ownership/bind check: " .. $attempt_log)
  end
  raise("BROKER","No owned broker after ten bind attempts: " .. $dir)
end

fn stop_bus($bus)
  if $bus != nil and _alive($bus["pid"]) then
    $k = kill($bus["pid"], 15)
  end
end

-- Restart an owned broker AT ITS RECORDED ENDPOINT. Same node, root, port,
-- Unix endpoint, mesh roster and exact executable — every one taken from
-- the record, never from exported or inherited globals. The previous owned
-- process must retire before rebinding; if another process has acquired the
-- recorded port, this restart fails instead of silently moving. Returns a
-- replacement record carrying the new PID.
fn restart_private_bus($broker)
  if ($broker == nil or $broker.pid == nil or $broker.node == nil or $broker.port == nil
    or $broker.listen_ip == nil or $broker.conf == nil or $broker.dir == nil or $broker.exe == nil) then
    raise("BROKER_RESTART", "broker record is incomplete for a same-endpoint restart")
  end
  _retire_owned($broker.pid)
  $argv = [$broker.exe, "serve", "--listen", $broker.listen_ip .. ":" .. to_string($broker.port),
    "--node", $broker.node, "--no-monitor", "--no-log"]
  if $broker.mesh_conf != "" then
    push($argv, "--mesh-config")
    push($argv, $broker.mesh_conf)
  end
  $log = $broker.dir .. "/noded-restart-" .. to_string(pid()) .. "-" .. to_string(random(1000, 9999)) .. ".log"
  $p = spawn($argv, {clear_env:true, env: {PATH:$broker.path_env, USER:$broker.user_env,
    HOME:$broker.dir .. "/home", MIXOS_ETC:$broker.dir .. "/etc", MIXOS_VAR:$broker.dir .. "/var",
    MIXOS_RUN:$broker.dir .. "/run", MIXOS_NODE_CONFIG:$broker.conf},
    stdout: {file: $log}, stderr: "stdout", detach: true})
  $replacement = merge($broker, {pid: $p, log: $log})
  -- Optional owned ledger: publish the spawned PID before readiness, so an
  -- interrupted restart still leaves the outer gate enough information to
  -- retire its child. The filename stays directly under this broker's root.
  if $broker.restart_record != nil then
    $record = $broker.restart_record
    if type($record) != "string" or $record == "" or contains($record,"/") or starts_with($record,"..") then
      _retire_owned($p)
      raise("BROKER_RESTART", "invalid owned restart record filename")
    end
    try
      write_atomic($broker.dir .. "/" .. $record,json_encode($replacement))
    catch $message
      _retire_owned($p)
      raise("BROKER_RESTART", "could not publish owned restart record: " .. $message)
    end
  end
  if not _broker_ready($broker.node, $p, $replacement) then
    _retire_owned($p)
    raise("BROKER_RESTART", "Restarted broker never confirmed ownership at " .. $broker.url)
  end
  return $replacement
end

-- Two owned loopback brokers with a native roster-mode mesh between them:
-- distinct fixed ports, and BOTH complete configs (node + mesh) written
-- BEFORE either broker starts, each roster naming exactly the other node.
-- Readiness is the exact-PID ownership check. On any collision or ownership
-- failure BOTH owned candidate children are stopped and awaited, a fresh
-- port pair is chosen, both files are rewritten, and the attempt budget is
-- spent. Nothing here kills a process it did not spawn, and no global env
-- is exported or read: later operations use the returned records only.
--
--   private_bus_pair({dir: PATH, noded: PATH?, run_token: "abc123"})
--     -> {a: broker, b: broker, endpoint_config: {a: {...}, b: {...}}}
--
-- run_token is sanitised to short node-name characters; node names become
-- fixture-a-<token> / fixture-b-<token>. These identities are owned
-- process/configuration identities, NOT cryptographic source-IP
-- attestations: two loopback brokers do not establish a WireGuard boundary.
fn private_bus_pair($opts)
  $dir = $opts["dir"]
  if $dir == nil then raise("BROKER_PAIR", "pair needs {dir: PATH}") end
  $noded = binary("noded", $opts["noded"] ?? "", ["/opt/mixos/bin"])
  if $noded == "" then
    print("  ERROR: no noded for the private broker pair (pass --noded PATH, or install it into /opt/mixos/bin)")
    exit(2)
  end
  mkdir($dir, {parents: true})
  print(run_argv_must(["chmod", "0711", $dir]))
  $token = _pair_token($opts["run_token"] ?? "")
  $name_a = "fixture-a-" .. $token
  $name_b = "fixture-b-" .. $token
  $account = trim(run_argv_must(["id", "-un"]))
  $common = {noded:$noded, listen_ip:"127.0.0.1", wg_ip:"127.0.0.1", mesh_open:true,
    path_env:env("PATH"), user_env:env("USER"), account:$account}
  $dir_a = $dir .. "/a"
  $dir_b = $dir .. "/b"
  for each $root in [$dir_a, $dir_b]
    mkdir($root, {parents: true})
    print(run_argv_must(["chmod", "0711", $root]))
    for each $child in ["etc", "var", "run", "home"]
      mkdir($root .. "/" .. $child, {parents:true})
    end
  end
  for $attempt = 1 to 5
    $pa = random(47000, 47999)
    $pb = random(47000, 47999)
    while $pb == $pa
      $pb = random(47000, 47999)
    end
    $spec_a = merge($common, {dir:$dir_a, name:$name_a, port:$pa, fixed_port:$pa,
      peers:[{name:$name_b, mesh_ip:"127.0.0.1", noded_port:$pb}],
      conf:$dir_a .. "/node.conf.mix", mesh_conf:$dir_a .. "/mesh.conf.mix",
      log:$dir_a .. "/noded.log"})
    $spec_b = merge($common, {dir:$dir_b, name:$name_b, port:$pb, fixed_port:$pb,
      peers:[{name:$name_a, mesh_ip:"127.0.0.1", noded_port:$pa}],
      conf:$dir_b .. "/node.conf.mix", mesh_conf:$dir_b .. "/mesh.conf.mix",
      log:$dir_b .. "/noded.log"})
    -- Both complete configs exist before either broker starts.
    $serve_a = _write_owned_config($spec_a)
    $serve_b = _write_owned_config($spec_b)
    $a = _spawn_owned($spec_a, $serve_a)
    $b = _spawn_owned($spec_b, $serve_b)
    if _broker_ready($name_a, $a.pid, $a) and _broker_ready($name_b, $b.pid, $b) then
      return {a: $a, b: $b, endpoint_config: {
        a: {node:$name_a, ip:"127.0.0.1", port:$pa, url:$a.url, unix_socket:$a.endpoint,
          conf:$a.conf, mesh_conf:$a.mesh_conf},
        b: {node:$name_b, ip:"127.0.0.1", port:$pb, url:$b.url, unix_socket:$b.endpoint,
          conf:$b.conf, mesh_conf:$b.mesh_conf}}}
    end
    -- A half-started pair must never survive into the next attempt: stop and
    -- await BOTH owned candidate children, whatever each one's state.
    _retire_pair($a.pid, $b.pid)
    print("private broker pair retry after ownership/bind failure: " .. to_string($attempt))
  end
  raise("BROKER_PAIR", "No owned broker pair after five attempts: " .. $dir)
end

-- Pair cleanup stops BOTH owned children even if one refuses to retire.
fn _retire_pair($first, $second)
  $failure = ""
  try
    _retire_owned($first)
  catch $message
    $failure = $failure .. " " .. $message
  end
  try
    _retire_owned($second)
  catch $message
    $failure = $failure .. " " .. $message
  end
  if $failure != "" then raise("BROKER_PAIR", "candidate children did not retire:" .. $failure) end
end

-- Only supported short node-name characters survive, and the pair names stay
-- inside the 31-character service-name limit. The cap is 14, not 21: the
-- mesh bridge registers as `bridge-<node>` (7 extra characters), so
-- "bridge-fixture-a-" (17) + token must also fit in 31.
fn _pair_token($token)
  $allowed = "abcdefghijklmnopqrstuvwxyz0123456789-"
  $out = ""
  $i = 0
  while $i < len($token)
    $ch = lower(slice($token, $i, $i + 1))
    if contains($allowed, $ch) then $out = $out .. $ch end
    $i = $i + 1
  end
  if $out == "" then $out = to_string(pid()) end
  if len($out) > 14 then $out = slice($out, 0, 14) end
  return $out
end

-- GUI clients use the same native/compatibility bus choice as their compositor.
-- Nil environment values remove inherited addresses rather than setting "".
fn client_env($session, $extra)
  $result={XDG_RUNTIME_DIR:$session.runtime, WAYLAND_DISPLAY:$session.socket, DISPLAY:""}
  for each $key in keys($extra ?? {})
    $result[$key]=$extra[$key]
  end
  for each $key in ["DBUS_SESSION_BUS_ADDRESS","DBUS_STARTER_ADDRESS","DBUS_STARTER_BUS_TYPE","DBUS_SYSTEM_BUS_ADDRESS"]
    $result[$key]=nil
  end
  if $session.dbus != "" then $result.DBUS_SESSION_BUS_ADDRESS=$session.dbus end
  return $result
end

-- Start a private nested compd on a private headless weston host.
--
--   start({bin: PATH, tag: "control", config: PATH,
--          run: new_run(PREFIX), env: {NAME: "value"}, width: 1280,
--          height: 800, host_renderer: "gl"})
--
-- The host renders with weston's GL renderer by default. Its pixman renderer
-- offers no linux-dmabuf, so a Vulkan client of the nested compositor finds
-- no present modes; GL gives dmabuf. `host_renderer: "pixman"` keeps the
-- old host for a run that needs it.
--
-- The compositor renders on the GPU unless `software: true` sets
-- LIBGL_ALWAYS_SOFTWARE=1 (a container build worker has no DRM node; a
-- workstation has one). A software compositor cannot import a GPU client's
-- dmabufs, which is how a Vulkan client stalls before its first frame.
--
-- Native runs clear session-bus variables and start no D-Bus server.
-- A compatibility-client gate can explicitly request `dbus: true`.
--
-- Returns {kind, bin, socket, service, runtime, log, host_log, pids}, or
-- exits 2 when the host or the compositor cannot start. `config` is compd's
-- settings file (its COMPOSITOR_ENVIRONMENT). `kind` is always "compd"; it
-- names the run directory and the Bus service.
fn start($opts)
  $kind = "compd"
  $bin = $opts["bin"]
  $tag = $opts["tag"]
  if $bin == nil or $tag == nil then
    print("  ERROR: start() needs {bin, tag}")
    exit(2)
  end
  if $opts["config"] == nil or not is_file($opts["config"]) then
    print("  ERROR: compd needs {config: PATH} (its settings file)")
    exit(2)
  end
  $weston = which("weston")
  if $weston == nil then
    print("  ERROR: weston is required for the headless host (pacman -S weston)")
    exit(2)
  end
  $id = to_string(pid())
  $record = $opts["run"]
  if $record == nil then
    $record = new_run("/tmp/" .. $kind .. "-" .. $tag .. "-" .. $id)
  end
  $run = $record.path
  $socket = "nested-" .. $tag .. "-" .. $id
  -- Bus names are at most 31 characters.
  $service = $kind .. "-" .. $tag .. "-" .. $id
  if len($service) > 31 then
    $service = $kind .. "-" .. $id
  end
  -- The broker's shared native ingress needs traversable ancestors. Keep
  -- the Wayland runtime private in its own child rather than closing the
  -- common run directory after private_bus() has validated it.
  $chmod = run_argv(["chmod", "0711", $run])
  if $chmod.exit_code != 0 then
    print("  ERROR: chmod " .. $run .. ": " .. $chmod.stderr)
    exit(2)
  end
  mkdir($run .. "/etc", {parents: true})
  mkdir($run .. "/var", {parents: true})
  mkdir($run .. "/run", {parents: true})
  $runtime = $run .. "/wayland"
  mkdir($runtime, {parents: true})
  chmod($runtime, 0o700)
  $host_log = $run .. "/weston.log"
  $log = $run .. "/compositor.log"
  $renderer = $opts["host_renderer"] ?? "gl"
  -- A private session bus for this run (dbus-daemon prints its address).
  $dbus_address = ""
  $dbus_pid = nil
  $dbus_daemon = $opts.dbus == true ? which("dbus-daemon") : nil
  if $dbus_daemon != nil and $dbus_daemon != "" then
    $dbus_address = "unix:path=" .. $run .. "/session-bus"
    $dbus_pid = spawn([$dbus_daemon, "--session", "--nofork", "--nopidfile", "--address=" .. $dbus_address],
      {stdout: {file: $run .. "/dbus.log"}, stderr: "stdout", detach: true})
    $t = 0
    while not exists($run .. "/session-bus") and $t < 25
      sleep(0.2)
      $t = $t + 1
    end
    if not exists($run .. "/session-bus") then
      if _alive($dbus_pid) then kill($dbus_pid, 15) end
      raise("COMPAT_BUS_START", "Requested private session bus never appeared: " .. $run .. "/dbus.log")
    end
  elif $opts.dbus == true then
    print("  ERROR: compatibility gate requested D-Bus but dbus-daemon is unavailable")
    exit(2)
  end
  $width = to_string($opts["width"] ?? 1280)
  $height = to_string($opts["height"] ?? 800)
  $hp = spawn([$weston, "--backend=headless", "--renderer=" .. $renderer, "--socket=wl-host",
    "--width=" .. $width, "--height=" .. $height, "--idle-time=0"],
    {env: {XDG_RUNTIME_DIR: $runtime, DBUS_SESSION_BUS_ADDRESS: nil,
      DBUS_STARTER_ADDRESS: nil, DBUS_STARTER_BUS_TYPE: nil, DBUS_SYSTEM_BUS_ADDRESS:nil},
      stdout: {file: $host_log}, stderr: "stdout", detach: true})
  $t = 0
  while not exists($runtime .. "/wl-host") and $t < 50
    sleep(0.2)
    $t = $t + 1
  end
  if not exists($runtime .. "/wl-host") then
    $killed = kill($hp, 15)
    print("  ERROR: the weston host socket never appeared (" .. $host_log .. ")")
    exit(2)
  end
  $cenv = {
    XDG_RUNTIME_DIR: $runtime,
    WAYLAND_DISPLAY: "wl-host",
    WINIT_UNIX_BACKEND: "wayland",
    DISPLAY: "",
    RUST_LOG: "info",
    MIXOS_ETC: $run .. "/etc",
    MIXOS_RUN: $run .. "/run",
    MIXOS_NODED_URL: noded_url(),
    MIXOS_NODE_CONFIG: env("MIXOS_NODE_CONFIG", "/etc/mixos/node.conf.mix"),
    HOME: env("HOME", "/tmp"),
    USER: env("USER", "")
  }
  -- Mesa's Vulkan WSI in FIFO never completes a present to this headless
  -- host, so a Vulkan client draws its first frame and stops: no frame
  -- callback ever fires. Mailbox presents complete. compd itself presents
  -- through EGL and ignores this; it is for the clients. `env` can override.
  $cenv["MESA_VK_WSI_PRESENT_MODE"] = "mailbox"
  if $opts["software"] == true then
    $cenv["LIBGL_ALWAYS_SOFTWARE"] = "1"
  end
  if $dbus_address != "" then
    $cenv["DBUS_SESSION_BUS_ADDRESS"] = $dbus_address
  end
  for each $name in keys($opts["env"] ?? {})
    $cenv[$name] = to_string($opts["env"][$name])
  end
  -- The gate's mode wins over inherited or caller-supplied session buses.
  $cenv["DBUS_SESSION_BUS_ADDRESS"] = $dbus_address != "" ? $dbus_address : nil
  $cenv["DBUS_STARTER_ADDRESS"] = nil
  $cenv["DBUS_STARTER_BUS_TYPE"] = nil
  $cenv["DBUS_SYSTEM_BUS_ADDRESS"] = nil
  -- Persistence must stay private even when the caller supplies an env map.
  $cenv["MIXOS_VAR"] = $run .. "/var"
  $argv = [$bin, "--nested", "--socket", $socket, "--bus-service", $service, "--config-file=" .. $opts["config"]]
  if $opts.scale != nil then push($argv, "--scale=" .. to_string($opts.scale)) end
  if $opts.logical_size != nil then push($argv, "--nested-size=" .. to_string($opts.logical_size.width) .. "x" .. to_string($opts.logical_size.height)) end
  $cp = spawn($argv, {env: $cenv, stdout: {file: $log}, stderr: "stdout", detach: true})
  $pids = [$cp, $hp]
  if $dbus_pid != nil then
    push($pids, $dbus_pid)
  end
  return {kind: $kind, bin: $bin, socket: $socket, service: $service, runtime: $runtime,
          log: $log, host_log: $host_log, pids: $pids, comp_pid: $cp, dbus: $dbus_address, run: $record}
end

-- Until the compositor answers its own Bus port. Bounded: a compositor that
-- never comes up is a failed gate, not a hang.
fn wait_ready($session, $seconds)
  $tries = ($seconds ?? 30) * 2
  $i = 0
  while $i < $tries
    if not _alive($session["comp_pid"]) then
      return false
    end
    if exists($session["runtime"] .. "/" .. $session["socket"]) then
      $p = call($session["service"], "comp.ping", {})
      if $p.rc == 0 then
        return true
      end
    end
    sleep(0.5)
    $i = $i + 1
  end
  return false
end

-- Stop the compositor and its host. The gate calls finish_run() after its
-- final verdict to remove passing artefacts or name retained evidence.
fn stop($session)
  for each $p in $session["pids"]
    if _alive($p) then
      $sent = kill($p, 15)
    end
  end
  sleep(1)
  for each $p in $session["pids"]
    if _alive($p) then
      $sent = kill($p, 9)
    end
  end
  print("teardown: " .. $session["kind"] .. " stopped")
end

-- The lines a child wrote. A missing file is no lines, never an error: a
-- gate reads it while the process is still writing.
fn log_lines($path)
  if not is_file($path) then
    return []
  end
  return split(read_file($path), "\n")
end

fn log_has($path, $needle)
  for each $line in log_lines($path)
    if contains($line, $needle) then
      return true
    end
  end
  return false
end

-- Wait (bounded) for a needle in a log a child process is writing.
fn await_log($path, $needle, $seconds)
  $tries = ($seconds ?? 10) * 4
  $i = 0
  while $i < $tries
    if log_has($path, $needle) then
      return true
    end
    sleep(0.25)
    $i = $i + 1
  end
  return false
end
