-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- Real Ced frames, document retention, cached/embedded cold startup and Bus
-- recovery on an owned desktop. Compositor and app brokers are independent.
-- Usage: mix tests/desktop/ced_settings_gate.mix REPO BUILD_BIN_DIR
if len(args()) != 2 then raise("ARGS","REPO BUILD_BIN_DIR") end
$repo = args()[0]
$bin = args()[1]
$mix = env("MIXOS_TEST_MIX","/opt/mixos/bin/mix")
$n = require("nested_host_lib.mix")
$capture = require("capture_lib.mix")
for each $name in ["compd","settingsd","noded","editd","ced","testkit-screenshot"]
  if not is_file($bin .. "/" .. $name) then raise("SETUP","Missing " .. $name) end
end
$R = {run:nil,a:nil,b:nil,session:nil,children:[],ok:false}
$binding = {instance:"fixture",profile:"default"}
fn check($condition,$message)
  if not $condition then raise("CED_SETTINGS_GATE",$message) end
end
fn bus_env($broker,$directory)
  return {MIXOS_NODED_URL:$broker.url,COSMIX_NODED_URL:$broker.url,
    MIXOS_NODE_CONFIG:$broker.conf,COSMIX_NODE_CONFIG:$broker.conf,
    MIXOS_RUN:$directory .. "/run",MIXOS_ETC:$directory .. "/etc",MIXOS_VAR:$directory .. "/var",
    HOME:$directory .. "/home",MIXOS_BROKER_ACCOUNT:env("MIXOS_BROKER_ACCOUNT")}
end
fn call($broker,$directory,$service,$verb,$body)
  $script = '$body = ' .. json_encode(json_encode($body)) .. "\nsend " .. json_encode($service) ..
    " " .. $verb .. ' body=$body timeout=5' .. "\n" .. 'print($rc)' .. "\n" .. 'print(json_encode($result))' .. "\n"
  $reply = run_argv([$mix,"-c",$script],{timeout:10,env:bus_env($broker,$directory),max_output:2000000})
  $lines = split(trim($reply.stdout),"\n")
  if not $reply.ok or len($lines) < 2 then return {rc:-9,result:trim($reply.stdout .. $reply.stderr)} end
  $body = json_parse(join(slice($lines,1),"\n"))
  if type($body) == "string" and starts_with($body,"{") then $body=json_parse($body) end
  return {rc:to_number($lines[0]),result:$body}
end
fn rpc($broker,$directory,$service,$verb,$body)
  $reply = call($broker,$directory,$service,$verb,$body)
  check($reply.rc == 0,$verb .. ": " .. json_encode($reply))
  return $reply.result
end
fn comp($verb,$body)
  return rpc($R.a,$R.run.path .. "/a",$R.session.service,$verb,$body)
end
fn app($verb,$body)
  return rpc($R.b,$R.run.path .. "/b","ced-settings-gate",$verb,$body)
end
fn stop_process($child)
  if not process_alive($child) then return end
  $sent = kill($child,15)
  for $attempt = 1 to 40
    if not process_alive($child) then return end
    sleep(0.05)
  end
  $sent = kill($child,9)
  for $attempt = 1 to 40
    if not process_alive($child) then return end
    sleep(0.05)
  end
  raise("TEARDOWN","Owned child did not stop")
end
fn await_exit($child,$log)
  for $attempt = 1 to 60
    if not process_alive($child) then
      check(contains(read_file($log),"CED_SHUTDOWN {\"faults\":[]}"),"Shutdown fault or missing receipt: " .. read_file($log))
      return
    end
    sleep(0.05)
  end
  raise("SHUTDOWN","Ced exceeded its shutdown budget: " .. read_file($log))
end
fn wait_service($service,$verb)
  for $attempt = 1 to 60
    $reply = call($R.b,$R.run.path .. "/b",$service,$verb,{})
    if $reply.rc == 0 then return end
    sleep(0.1)
  end
  raise("SETUP","Service did not register: " .. $service)
end
fn start_authorities()
  $directory = $R.run.path .. "/b"
  for each $entry in [{name:"settingsd",argv:["serve","--instance","fixture","--root",$R.run.path .. "/profile"]},
    {name:"editd",argv:["serve"]}]
    $child = spawn(concat([$bin .. "/" .. $entry.name],$entry.argv),
      {env:bus_env($R.b,$directory),stdout:{file:$R.run.path .. "/" .. $entry.name .. ".log"},stderr:"stdout",detach:true})
    $R.children = concat($R.children,[$child])
  end
  wait_service("settingsd","settings.describe")
  wait_service("edit","edit.ping")
end
fn apply($changes,$operation)
  $snapshot = rpc($R.b,$R.run.path .. "/b","settingsd","settings.get",{binding:$binding}).snapshot
  rpc($R.b,$R.run.path .. "/b","settingsd","settings.apply",{binding:$binding,
    expected_incarnation:$snapshot.incarnation,expected_revision:$snapshot.revision,
    operation_id:$operation,changes:$changes,reset:[]})
  return rpc($R.b,$R.run.path .. "/b","settingsd","settings.get",{binding:$binding}).snapshot
end
fn identity($snapshot)
  return {incarnation:$snapshot.incarnation,revision:$snapshot.revision,
    design_revision:$snapshot.design_revision,source_digest:$snapshot.source_digest}
end
fn await_current($snapshot,$window,$budget)
  $last = nil
  $deadline = time()+$budget
  while time() < $deadline
    $reply = call($R.b,$R.run.path .. "/b","ced-settings-gate","app.describe",{})
    if $reply.rc == 0 then
      $last = $reply.result
      if ($last.settings != nil and $last.settings.kind == "current" and
        deep_eq($last.settings.applied,identity($snapshot)) and
        deep_eq($last.settings_cache.persisted,$last.settings.applied)) then
        $mapped = comp("comp.window.wait",{match:$window,until:"presented",timeout_ms:5000}).window
        check($mapped != nil and $mapped.id == $window.id and $mapped.generation == $window.generation,"Ced window replaced")
        return $last
      end
    end
    sleep(0.1)
  end
  raise("ACTIVATION","Current applied/cache identity did not settle: " .. json_encode($last))
end
fn launch($home,$label,$paths)
  $log = $R.run.path .. "/ced-" .. $label .. ".log"
  $extra = merge(bus_env($R.b,$R.run.path .. "/b"),{MIXOS_APP_HOME:$home,
    MIXOS_SETTINGS_INSTANCE:"fixture",MIXOS_SETTINGS_PROFILE:"default",LIBGL_ALWAYS_SOFTWARE:"1"})
  $at = time()
  $child = spawn(concat([$bin .. "/ced","--service","ced-settings-gate"],$paths),
    {env:$n.client_env($R.session,$extra),stdout:{file:$log},stderr:"stdout",detach:true})
  $R.children = concat($R.children,[$child])
  return {pid:$child,log:$log,at:$at}
end
fn presented($launch,$budget)
  $row = comp("comp.window.wait",{match:{app_id:"dev.mixos.ced"},until:"presented",timeout_ms:5000}).window
  $elapsed = (time()-$launch.at)*1000
  check($row != nil,"Ced did not present")
  check($row.pid == $launch.pid,"Presented window belongs to another process")
  check($elapsed <= $budget,"First map took " .. to_string($elapsed) .. "ms, budget " .. to_string($budget))
  print("Ced first map " .. to_string($elapsed) .. "ms " .. $launch.log)
  return {id:$row.id,generation:$row.generation}
end
fn place($window)
  comp("comp.window.place",merge($window,{x:0,y:0,width:1000,height:600}))
  $row = comp("comp.window.wait",{match:$window,until:"size",width:1000,height:600,timeout_ms:5000}).window
  check($row != nil,"Ced placement did not commit")
end
fn capture($label,$window,$snapshot)
  place($window)
  $before = if $snapshot != nil then app("app.describe",{}).settings.applied else nil end
  $path = $R.run.path .. "/" .. $label .. ".ppm"
  print(run_argv_must([$bin .. "/testkit-screenshot",$path],{timeout:30,
    env:$n.client_env($R.session,bus_env($R.a,$R.run.path .. "/a"))}))
  $image = $capture.ppm($path)
  $pixel = $capture.pixel($image,200,400)
  if $snapshot != nil then
    $surface = $snapshot.effective["app:ced"].design.pairs.base.rendered_surface
    for $channel = 0 to 2
      check(abs($pixel[$channel]-$capture.srgb($surface[$channel])) <= 8,"Ced palette pixel did not match applied authority")
    end
    check(deep_eq($before,app("app.describe",{}).settings.applied),"Appearance changed during capture")
  end
  print("captured Ced " .. $label .. " " .. json_encode($pixel))
  return $pixel
end
fn fallback($launch,$kind)
  for $attempt = 1 to 60
    for each $line in split(read_file($launch.log),"\n")
      if starts_with($line,"CED_SETTINGS ") then
        $event = json_parse(slice($line,len("CED_SETTINGS ")))
        if $event.evidence.kind == $kind then
          check(not $event.evidence.confirmed,"Fallback fabricated authority confirmation")
          check($event.elapsed_ms <= 1000,"Fallback exceeded bootstrap budget")
          return $event
        end
      end
    end
    sleep(0.05)
  end
  raise("FALLBACK","Missing " .. $kind .. " appearance: " .. read_file($launch.log))
end
try
  $R.run = $n.new_run("/var/tmp/ced-settings")
  $root = $R.run.path
  $R.a = $n.private_bus({dir:$root .. "/a",name:"ced-desktop",noded:$bin .. "/noded"})
  mkdir($root .. "/cfg",{parents:true})
  write_file($root .. "/cfg/settings.json",read_file($repo .. "/tests/desktop/smoke-settings.json"))
  write_file($root .. "/cfg/preferences.json",json_encode({scene_host:false,decorations_ssd:false}))
  $R.session = $n.start({bin:$bin .. "/compd",tag:"ced-settings",run:$R.run,
    config:$root .. "/cfg/settings.json",host_renderer:"pixman",software:true,scale:1})
  check($n.wait_ready($R.session,30),"Private compositor failed")
  $R.b = $n.private_bus({dir:$root .. "/b",name:"ced-settings",noded:$bin .. "/noded",first_port:$R.a.port})
  check($R.b.port != $R.a.port,"Broker bind collision was not recovered")
  print(run_argv_must([$bin .. "/settingsd","seed","--allow-create","--instance","fixture","--root",$root .. "/profile"],{timeout:30}))
  start_authorities()
  $light = apply({"appearance.mode":"light"},"ced-gui-light")
  $document = $root .. "/document.txt"
  write_file($document,"native settings editor\n")
  $home = $root .. "/ced-home"
  $online = launch($home,"online",[$document])
  $window = presented($online,5000)
  await_current($light,$window,10)
  $tabs = app("ced.tabs",{}).tabs
  check(len($tabs) == 1,"Launch document not opened exactly once")
  $tab = $tabs[0].tab
  app("ced.wait",{tab:$tab,phase:"live",timeout_ms:5000})
  app("ced.select",{tab:$tab,anchor:5,head:5})
  $before = app("ced.state",{tab:$tab,text:true})
  $light_pixel = capture("online-light",$window,$light)
  $dark = apply({"appearance.mode":"dark","ui.text_scale":1.25},"ced-gui-dark")
  await_current($dark,$window,10)
  $dark_pixel = capture("online-dark",$window,$dark)
  $after = app("ced.state",{tab:$tab,text:true})
  check($before.buffer == $after.buffer and $before.rev == $after.rev and $before.text == $after.text and
    deep_eq($before.selection,$after.selection),"Appearance activation changed document/caret")
  check(not deep_eq($light_pixel,$dark_pixel),"Light/dark did not repaint Ced")
  $quit = app("app.quit",{})
  check($quit.quitting,"Quit reply lost before socket closed")
  await_exit($online.pid,$online.log)
  $session_file = $home .. "/state/session.json"
  check(is_file($session_file),"Owned session did not persist")
  $session_before = read_file($session_file)
  -- Keep compositor A alive while all services on app broker B stop.
  for each $child in $R.children
    if process_alive($child) then stop_process($child) end
  end
  stop_process($R.b.pid)
  $offline = launch($home,"cached",[])
  $cached_window = presented($offline,1000)
  fallback($offline,"cached")
  $cached_pixel = capture("offline-cached",$cached_window,nil)
  check(deep_eq($cached_pixel,$dark_pixel),"Cached GUI lost authority palette")
  comp("comp.window.focus",$cached_window)
  comp("comp.input.key",{seat:"human",key:"n",modifiers:["ctrl"]})
  -- Deliberately exceed broker retained-publisher expiry, without polling in
  -- the application. The same supervisor and same window must recover.
  $outage_until = time()+65
  while time() < $outage_until
    check(process_alive($offline.pid),"Offline Ced window exited")
    sleep(min(1,$outage_until-time()))
  end
  check(read_file($session_file) == $session_before,"Offline GUI overwrote unowned session")
  $broker = spawn([$bin .. "/noded","serve","--listen","127.0.0.1:" .. to_string($R.b.port),"--node","ced-settings","--no-monitor","--no-log"],
    {env:bus_env($R.b,$root .. "/b"),stdout:{file:$root .. "/b/noded-restarted.log"},stderr:"stdout",detach:true})
  $R.b.pid=$broker
  wait_service("noded","noded.ping")
  $broker_identity = rpc($R.b,$root .. "/b","noded","noded.info",{})
  check(process_alive($broker) and $broker_identity.node == "ced-settings" and
    $broker_identity.noded.pid == $broker,"Restart answered through a different broker")
  start_authorities()
  $restarted = rpc($R.b,$root .. "/b","settingsd","settings.get",{binding:$binding}).snapshot
  -- The existing Bus supervisor caps full-jitter reconnect backoff at 30s.
  -- A ten-second wait falsely rejects a healthy long-outage recovery.
  await_current($restarted,$cached_window,45)
  capture("recovered-current",$cached_window,$restarted)
  $recovered_tabs = app("ced.tabs",{}).tabs
  check(len($recovered_tabs) == 2,"Offline new-file intent was not deferred and restored exactly once")
  for each $row in $recovered_tabs
    app("ced.wait",{tab:$row.tab,phase:"live",timeout_ms:5000})
  end
  -- An initial registration collision forwards argv on native ABP, exits,
  -- and cannot write the second instance's unowned session file.
  $collision_home = $root .. "/collision-home"
  mkdir($collision_home .. "/state",{parents:true})
  $collision_session = "{\"version\":1,\"active\":null,\"tabs\":[],\"recent\":[\"collision-preserve\"]}\n"
  write_file($collision_home .. "/state/session.json",$collision_session)
  $forwarded = $root .. "/forwarded.txt"
  write_file($forwarded,"forwarded launch\n")
  $collision = launch($collision_home,"collision",[$forwarded])
  await_exit($collision.pid,$collision.log)
  check(read_file($collision_home .. "/state/session.json") == $collision_session,"Initial collision overwrote its unowned session")
  $forwarded_tabs = app("ced.tabs",{}).tabs
  $matches = filter($forwarded_tabs,fn($row) = $row.path == $forwarded)
  check(len($matches) == 1,"Initial collision did not forward launch path exactly once")
  check(app("app.quit",{}).quitting,"Recovery quit reply lost")
  await_exit($offline.pid,$offline.log)
  -- Missing and corrupt caches use embedded appearance and never acquire
  -- ownership while the broker is absent. Closing still drains promptly.
  for each $child in $R.children
    if process_alive($child) then stop_process($child) end
  end
  stop_process($R.b.pid)
  for each $case in ["missing","corrupt"]
    $case_home = if $case == "corrupt" then $home else $root .. "/fresh-home" end
    mkdir($case_home .. "/state",{parents:true})
    $sentinel = "{\"version\":1,\"active\":null,\"tabs\":[],\"recent\":[\"preserve-me\"]}\n"
    write_file($case_home .. "/state/session.json",$sentinel)
    if $case == "corrupt" then
      $files = glob($case_home .. "/cache/settings/*.json")
      check(len($files) == 1,"Expected one bound settings cache")
      write_file($files[0],"{broken cache")
    end
    $launch = launch($case_home,$case,[])
    $window = presented($launch,1000)
    $event = fallback($launch,"embedded")
    if $case == "corrupt" then check(len($event.fallback_diagnostics) > 0,"Corrupt cache lacked diagnostic") end
    capture("offline-" .. $case,$window,nil)
    comp("comp.window.close",$window)
    await_exit($launch.pid,$launch.log)
    check(read_file($case_home .. "/state/session.json") == $sentinel,"Unowned close overwrote session")
  end
  write_file($root .. "/acceptance.json",json_encode({current:true,cached:true,embedded:true,
    document_retained:true,caret_retained:true,outage_seconds:65,same_window:true,
    offline_session_preserved:true,shutdown_receipts:true,broker_a:$R.a.url,broker_b:$R.b.url}))
  print("PASS Ced native settings: captured authority/cache/embedded frames, matching cache receipts, document/caret retained, >60s cold outage recovery on same window, bounded shutdown")
  $R.ok=true
catch $message
  print("FAIL " .. $message)
  if $R.run != nil then
    for each $log in glob($R.run.path .. "/*.log")
      print(run_argv(["tail","-n","20",$log],{max_output:16000}).stdout)
    end
  end
finally
  for each $child in $R.children
    if process_alive($child) then stop_process($child) end
  end
  if $R.session != nil then $n.stop($R.session) end
  if $R.a != nil then stop_process($R.a.pid) end
  if $R.b != nil then stop_process($R.b.pid) end
  $n.finish_run($R.run,$R.ok)
end
if not $R.ok then exit(1) end
