if len(args()) < 2 or len(args()) > 3 then raise("ARGS","REPO BUILD_BIN_DIR [pixman|gl]") end
$renderer = len(args()) == 3 ? args()[2] : "pixman"
$probe = require("native_probe_lib.mix")
$probe.run_probe(args()[0],args()[1],"native-frame-iced-recovery-probe",
  "ICED_RECOVERY PASS before_commit=true failures=1 unchanged_view=true failed_success_suppressed=true exact_retry=true",$renderer)
print("PASS actual Iced pre-commit and nine-failure capacity recovery on owned Weston/compd: " .. $renderer)
