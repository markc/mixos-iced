-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- Native settings -> Quoin reservation -> real xdg configure -> captured pixels
-- and stationary human pointer, wholly within an owned nested desktop.
-- Usage: mix tests/desktop/settings_geometry_gate.mix REPO BUILD_BIN_DIR [--ced]
if len(args()) < 2 or len(args()) > 3 or (len(args()) == 3 and args()[2] != "--ced") then raise("ARGS","REPO BUILD_BIN_DIR [--ced]") end
$joint = len(args()) == 3
$repo = args()[0]
$bin = args()[1]
$n = require("nested_host_lib.mix")
$capture = require("capture_lib.mix")
$mix = env("MIXOS_TEST_MIX","/opt/mixos/bin/mix")
for each $name in concat(["compd","settingsd","noded","testkit-input-probe","testkit-screenshot"],if $joint then ["ced","editd"] else [] end)
  if not is_file($bin .. "/" .. $name) then raise("SETUP","Missing " .. $name) end
end
$R = {run:nil,bus:nil,session:nil,children:[],ok:false}
fn require_ok($reply, $what)
  if $reply.rc != 0 then raise("GATE",$what .. ": " .. json_encode($reply)) end
  return $reply.result
end
fn comp($verb,$body)
  return require_ok($n.call($R.session.service,$verb,$body),$verb)
end
fn shell($verb,$body)
  return require_ok($n.call($shell,$verb,$body),$verb)
end
fn apply($changes,$operation)
  $current = require_ok($n.call("settingsd","settings.get",{binding:$binding}),"settings.get").snapshot
  $result = require_ok($n.call("settingsd","settings.apply",{binding:$binding,
    expected_incarnation:$current.incarnation,expected_revision:$current.revision,
    operation_id:$operation,changes:$changes,reset:[]}),"settings.apply")
  $accepted = require_ok($n.call("settingsd","settings.get",{binding:$binding}),"settings.get").snapshot
  if $accepted.incarnation != $current.incarnation or $accepted.revision == $current.revision then
    raise("REVISION","Batch did not advance the bound authority")
  end
  print("accepted " .. $accepted.revision .. " " .. $operation)
  return $accepted
end
fn await_panel($mode,$thickness,$reserved,$revision)
  $last = nil
  for $attempt = 1 to 100
    $last = shell("shell.panel.state",{edge:"bottom"})
    $evidence = shell("shell.props.get",{path:"settings"})
    if ($last.mode == $mode and $last.settings != nil and
      $last.settings.requested_px == $thickness and $last.settings.fitted_px == $thickness and
      $last.settings.presented_px == $thickness and $last.settings.reserved_px == $reserved and
      $evidence.applied != nil and $evidence.applied.revision == $revision and
      $evidence.applied.incarnation == $incarnation and $evidence.kind == "current") then
      return $last
    end
    sleep(0.1)
  end
  raise("PANEL","Panel/settings activation did not settle: " .. json_encode($last))
end
fn await_layout($thickness)
  $last = nil
  for $attempt = 1 to 60
    $last = shell("shell.scene.layout",{scene:"settings-geometry"})
    if ($last.visible and abs($last.surface.h - $thickness) < 0.1 and
      abs($last.surface.y - ($height - $thickness)) < 0.1) then return $last end
    sleep(0.1)
  end
  raise("LAYOUT","Scene placement did not settle: " .. json_encode($last))
end
fn wait_size($w,$h,$offset)
  comp("comp.window.wait",{match:$window,until:"size",width:$w,height:$h,timeout_ms:5000})
  await_new($probe_log,$offset,"PROBE configure " .. to_string($w) .. " " .. to_string($h))
  $truth = comp("compd.truth",{})
  $slot = $truth.slots[to_string($window.id)]
  if $slot == nil or not deep_eq($slot.decided,[$w,$h]) then raise("SLOT",json_encode($slot)) end
  return $truth
end
fn ppm($path)
  return $capture.ppm($path)
end
fn client_pixel($ppm,$x,$y)
  $x = floor($x)
  $y = floor($y)
  if $x < 0 or $y < 0 or $x >= $ppm.w or $y >= $ppm.h then raise("CAPTURE","Pixel outside screenshot") end
  $at = $ppm.off + ($y*$ppm.w + $x)*3
  return $ppm.bytes[$at] >= 247 and $ppm.bytes[$at+1] <= 8 and $ppm.bytes[$at+2] >= 247
end
fn capture($label,$layout,$client_y,$vacated_y,$accepted,$interaction)
  $before = shell("shell.props.get",{path:"settings"})
  $path = $R.run.path .. "/" .. $label .. ".ppm"
  print(run_argv_must([$bin .. "/testkit-screenshot",$path],{timeout:30,env:$n.client_env($R.session,{})}))
  $image = ppm($path)
  if $image.w != $width or $image.h != $height then raise("CAPTURE","Unexpected capture scale") end
  $button = $layout.nodes.go
  $cell = nil
  for each $candidate in $accepted.effective.desktop.design.buttons
    if ($candidate.variant == "primary" and $candidate.size == "md" and
      $candidate.interaction == $interaction and not $candidate.focus_visible) then $cell=$candidate; break end
  end
  if $cell == nil or $cell.pair.surface[3] != 1 then raise("SETUP","Expected an opaque canonical primary button cell") end
  if not client_pixel($image,$width/2,100) or not client_pixel($image,$width/2,$client_y) then
    raise("CAPTURE","Client missing above the work-area boundary in " .. $label)
  end
  if client_pixel($image,$layout.surface.x+$button.x+8,$layout.surface.y+$button.y+8) then
    raise("CAPTURE","Expected rendered scene button in " .. $label)
  end
  $button_at = $image.off + (floor($layout.surface.y+$button.y+8)*$image.w + floor($layout.surface.x+$button.x+8))*3
  for $channel = 0 to 2
    $linear = $cell.pair.surface[$channel]
    $srgb = if $linear <= 0.0031308 then $linear*12.92 else 1.055*pow($linear,1/2.4)-0.055 end
    $expected = round($srgb*255)
    if abs($image.bytes[$button_at+$channel]-$expected) > 8 then
      raise("APPEARANCE","Canonical " .. $interaction .. " button channel " .. to_string($channel) .. " expected " .. to_string($expected) .. " actual " .. to_string($image.bytes[$button_at+$channel]) .. " in " .. $label)
    end
  end
  $page_at = $image.off + (floor($layout.surface.y+10)*$image.w + $image.w-20)*3
  for $channel = 0 to 2
    if abs($image.bytes[$page_at+$channel]-[18,52,86][$channel]) > 8 then
      raise("CAPTURE","Owned scene background absent in " .. $label)
    end
  end
  if $vacated_y != nil and not client_pixel($image,$width/2,$vacated_y) then
    raise("DAMAGE","Vacated panel strip retained stale pixels")
  end
  $after = shell("shell.props.get",{path:"settings"})
  if not deep_eq($before.applied,$after.applied) then raise("CAPTURE","Settings changed during capture") end
  print("captured " .. $label .. " at applied revision " .. $after.applied.revision)
end
fn tail_after($path,$offset)
  return slice(read_file($path),$offset)
end
fn await_new($path,$offset,$needle)
  for $attempt = 1 to 50
    if contains(tail_after($path,$offset),$needle) then return end
    sleep(0.1)
  end
  raise("INPUT","Missing fresh " .. $needle .. " in " .. $path)
end
fn await_point($path,$offset,$x,$y)
  for $attempt = 1 to 50
    for each $event in re_find(tail_after($path,$offset),"PROBE (?:enter|motion) ([0-9.-]+) ([0-9.-]+)")
      if abs(to_number($event.groups[0])-$x) < 0.01 and abs(to_number($event.groups[1])-$y) < 0.01 then return end
    end
    sleep(0.1)
  end
  raise("INPUT","No fresh client point within Wayland fixed-point tolerance")
end
fn ced($verb,$body)
  return require_ok($n.call("ced-settings-geometry",$verb,$body),$verb)
end
fn snapshot_identity($snapshot)
  return {incarnation:$snapshot.incarnation,revision:$snapshot.revision,
    design_revision:$snapshot.design_revision,source_digest:$snapshot.source_digest}
end
fn joint_evidence($accepted)
  $shell_evidence = shell("shell.props.get",{path:"settings"})
  $app_evidence = ced("app.describe",{}).settings
  for each $entry in [{evidence:$shell_evidence,context:"desktop"},{evidence:$app_evidence,context:"app:ced"}]
    if ($entry.evidence == nil or $entry.evidence.kind != "current" or not $entry.evidence.confirmed or
      not deep_eq($entry.evidence.binding,$binding) or $entry.evidence.context != $entry.context or
      not deep_eq($entry.evidence.current,snapshot_identity($accepted)) or
      not deep_eq($entry.evidence.applied,snapshot_identity($accepted))) then return false end
  end
  return true
end
fn await_joint($accepted)
  for $attempt = 1 to 100
    $reply = $n.call("ced-settings-geometry","app.describe",{})
    if $reply.rc == 0 and joint_evidence($accepted) then return end
    sleep(0.1)
  end
  raise("JOINT","Ced and Quoin did not apply the same accepted identity")
end
fn capture_joint($label,$accepted,$layout,$ced_window,$ced_width)
  -- Alternate committed widths so an old buffer cannot satisfy the size fence.
  comp("comp.window.place",merge($ced_window,{x:0,y:0,width:$ced_width,height:600}))
  $row = comp("comp.window.wait",{match:$ced_window,until:"size",width:$ced_width,height:600,timeout_ms:5000}).window
  if $row == nil or $row.id != $ced_window.id or $row.generation != $ced_window.generation then raise("JOINT","Ced placement/identity changed") end
  if not joint_evidence($accepted) then raise("JOINT","Stale evidence before shared frame") end
  $path = $R.run.path .. "/" .. $label .. ".ppm"
  print(run_argv_must([$bin .. "/testkit-screenshot",$path],{timeout:30,env:$n.client_env($R.session,{})}))
  $image = ppm($path)
  $app_pixel = $capture.pixel($image,200,400)
  $base = $accepted.effective["app:ced"].design.pairs.base.rendered_surface
  $cell = nil
  for each $candidate in $accepted.effective.desktop.design.buttons
    if ($candidate.variant == "primary" and $candidate.size == "md" and
      $candidate.interaction == "resting" and not $candidate.focus_visible) then $cell=$candidate; break end
  end
  if $cell == nil or $cell.pair.surface[3] != 1 then raise("JOINT","Missing opaque shell button token") end
  $button = $layout.nodes.go
  if $layout.surface.y+$button.y+8 <= 600 then raise("JOINT","Ced overlaps shell sample") end
  $shell_pixel = $capture.pixel($image,$layout.surface.x+$button.x+8,$layout.surface.y+$button.y+8)
  for $channel = 0 to 2
    if (abs($app_pixel[$channel]-$capture.srgb($base[$channel])) > 8 or
      abs($shell_pixel[$channel]-$capture.srgb($cell.pair.surface[$channel])) > 8) then
      raise("JOINT","Shared frame does not match both applied palettes")
    end
  end
  if not joint_evidence($accepted) then raise("JOINT","Evidence changed during shared frame") end
  print("captured joint " .. $label .. " revision " .. $accepted.revision .. " Ced " .. json_encode($app_pixel) .. " Quoin " .. json_encode($shell_pixel))
end
try
  $R.run = $n.new_run("/tmp/settings-geometry")
  $root = $R.run.path
  $R.bus = $n.private_bus({dir:$root,name:"settings-geometry",noded:$bin .. "/noded"})
  $binding = {instance:"fixture",profile:"default"}
  $store = $root .. "/profile"
  print(run_argv_must([$bin .. "/settingsd","seed","--allow-create","--instance","fixture","--root",$store],{timeout:30}))
  $authority = spawn([$bin .. "/settingsd","serve","--instance","fixture","--root",$store],
    {stdout:{file:$root .. "/settingsd.log"},stderr:"stdout",detach:true})
  $R.children = concat($R.children,[$authority])
  $ready = false
  for $attempt = 1 to 60
    $reply = $n.call("settingsd","settings.get",{binding:$binding})
    if $reply.rc == 0 then $ready=true; break end
    sleep(0.1)
  end
  if not $ready then raise("SETUP","Authority never registered on owned broker") end
  $initial = apply({"appearance.mode":"light","shell.panels.bottom":{edge:"bottom",mode:"overlay",thickness:52}},"light-overlay-52")
  $incarnation = $initial.incarnation
  mkdir($root .. "/cfg",{parents:true})
  write_file($root .. "/cfg/settings.json",read_file($repo .. "/tests/desktop/smoke-settings.json"))
  write_file($root .. "/cfg/preferences.json",json_encode({scene_host:true,scene_service:"settings-gate-fallback",decorations_ssd:false}))
  $events = $root .. "/events.jsonl"
  write_file($events,"")
  $citizen_file = $root .. "/citizen.mix"
  write_file($citizen_file,"-- owned test citizen\non go\n append_file(" .. json_encode($events) .. ", json_encode($event.args) .. \"\\n\")\n reply(\"ok\")\nend\n")
  $citizen = spawn([$mix,"--serve",$citizen_file,"--name","settings-gate-citizen"],
    {stdout:{file:$root .. "/citizen.log"},stderr:"stdout",detach:true})
  $R.children = concat($R.children,[$citizen])
  $R.session = $n.start({bin:$bin .. "/compd",tag:"settings",run:$R.run,
    config:$root .. "/cfg/settings.json",host_renderer:"pixman",software:true,scale:1,
    env:{HOME:$root .. "/home",MIXOS_SETTINGS_INSTANCE:"fixture",MIXOS_SETTINGS_PROFILE:"default"}})
  if not $n.wait_ready($R.session,30) then raise("SETUP","Compositor never became ready") end
  $shell = nil
  for $attempt = 1 to 60
    $found = re_find(read_file($R.session.log),"scene host: registered as `([^`]+)`")
    if len($found) > 0 then $shell=$found[0].groups[0]; break end
    sleep(0.1)
  end
  if $shell != "shell" and $shell != "settings-gate-fallback" then raise("SETUP","No owned scene service") end
  require_ok($n.call("settings-gate-citizen","HELP",{}),"citizen readiness")
  $document = "---\nscene: 1\nname: settings-geometry\ncitizen: settings-gate-citizen\nwindow: {\"kind\":\"edge\",\"edge\":\"bottom\",\"h\":40}\n---\n```mix\nroot: {widget: \"row\", padding: 4, fill: true, background: \"#123456\", children: [\"go\"]}\ngo: {widget: \"button\", label: \"Go\", tone: \"primary\", width: 160, on_click: \"go\"}\n```\n"
  shell("shell.scene.load",{source:$document})
  $panel = await_panel("pinned",52,0,$initial.revision)
  $outputs = comp("comp.props.get",{path:"outputs"})
  if len(keys($outputs)) != 1 then raise("SETUP","Expected exactly one output") end
  $output = $outputs[keys($outputs)[0]]
  $width = $output.width
  $height = $output.height
  $layout = await_layout(52)
  $probe_log = $root .. "/probe.log"
  $delayed_size = to_string($width) .. "x" .. to_string($height-64)
  $probe = spawn([$bin .. "/testkit-input-probe","--app-id","dev.mixos.SettingsGeometry","--size","320x240","--seconds","180","--colour","ff00ff","--delay-size-commit",$delayed_size .. ":3000"],
    {env:$n.client_env($R.session,{}),stdout:{file:$probe_log},stderr:"stdout",detach:true})
  $R.children = concat($R.children,[$probe])
  $mapped = comp("comp.window.wait",{match:{app_id:"dev.mixos.SettingsGeometry"},until:"presented",timeout_ms:15000})
  $window = {id:$mapped.window.id,generation:$mapped.window.generation}
  $offset = len(read_file($probe_log))
  comp("comp.window.maximize",$window)
  wait_size($width,$height,$offset)
  capture("overlay-52",$layout,$height-55,nil,$initial,"resting")
  comp("comp.props.set",{path:"input.host.passthrough",value:false})
  $x = $layout.surface.x+$layout.nodes.go.x+$layout.nodes.go.w/2
  $y = $layout.surface.y+$layout.nodes.go.y+$layout.nodes.go.h/2-(96-52)
  $offset = len(read_file($probe_log))
  $move = comp("comp.input.pointer.move",{seat:"human",x:$x,y:$y})
  if $move.target == nil or $move.target.id != $window.id then raise("INPUT","Future panel point is not currently on client") end
  await_point($probe_log,$offset,$x,$y)
  $offset = len(read_file($probe_log))
  $changed = apply({"appearance.mode":"dark","shell.panels.bottom":{edge:"bottom",mode:"dock",thickness:96}},"dark-dock-96")
  await_panel("docked",96,96,$changed.revision)
  $layout = await_layout(96)
  $truth = wait_size($width,$height-96,$offset)
  $area = $truth.outputs[keys($truth.outputs)[0]].usable
  if $area.height != $height-96 or $area.y != 0 then raise("WORK_AREA",json_encode($area)) end
  await_new($probe_log,$offset,"PROBE leave")
  $button = $layout.nodes.go
  if ($x <= $layout.surface.x+$button.x or $x >= $layout.surface.x+$button.x+$button.w or
    $y <= $layout.surface.y+$button.y or $y >= $layout.surface.y+$button.y+$button.h) then
    raise("INPUT","Parked pointer no longer lies inside the resized button")
  end
  capture("dark-dock-96",$layout,$height-99,nil,$changed,"hovered")
  $event_offset = len(read_file($events))
  comp("comp.input.pointer.button",{seat:"human",button:"left",action:"click"})
  await_new($events,$event_offset,"\n")
  $click = json_parse(split(tail_after($events,$event_offset),"\n")[0])
  if $click.scene != "settings-geometry" or $click.node != "go" or $click.kind != "click" then
    raise("INPUT","Unexpected citizen click: " .. json_encode($click))
  end
  $offset = len(read_file($probe_log))
  $changed = apply({"shell.panels.bottom.thickness":64},"dock-64")
  await_panel("docked",64,64,$changed.revision)
  $layout = await_layout(64)
  await_new($probe_log,$offset,"PROBE deferred_commit " .. to_string($width) .. " " .. to_string($height-64))
  $held = comp("comp.window.wait",{match:$window,until:"size",width:$width,height:$height-96,timeout_ms:500}).window
  if $held == nil or $held.id != $window.id or $held.generation != $window.generation then
    raise("INPUT","ACK did not retain the original committed client size")
  end
  $delayed_slot = comp("compd.truth",{}).slots[to_string($window.id)]
  if not deep_eq($delayed_slot.decided,[$width,$height-64]) then raise("INPUT","Delayed ACK changed the decided slot") end
  if contains(tail_after($probe_log,$offset),"PROBE enter") then raise("INPUT","ACK without a new buffer fabricated a client enter") end
  $truth = wait_size($width,$height-64,$offset)
  if $truth.outputs[keys($truth.outputs)[0]].usable.height != $height-64 then raise("WORK_AREA","Regrowth did not update usable area") end
  if $y >= $layout.surface.y then raise("INPUT","Parked pointer is not in the vacated client strip") end
  await_new($probe_log,$offset,"PROBE enter")
  await_point($probe_log,$offset,$x,$y)
  capture("dock-64",$layout,$height-67,$height-80,$changed,"resting")
  $after = comp("comp.window.wait",{match:$window,until:"presented",timeout_ms:5000}).window
  if $after.id != $window.id or $after.generation != $window.generation then raise("IDENTITY","Window replaced during activation") end
  if shell("shell.panel.state",{edge:"bottom"}).page != $panel.page then raise("IDENTITY","Scene page replaced during activation") end
  $quiet_offset = len(read_file($probe_log))
  sleep(0.3)
  if len(re_find(tail_after($probe_log,$quiet_offset),"PROBE (?:enter|leave|motion)")) != 0 then
    raise("INPUT","Unchanged frames repeatedly retargeted the stationary pointer")
  end
  if $joint then
    $editd = spawn([$bin .. "/editd","serve"],{stdout:{file:$root .. "/editd.log"},stderr:"stdout",detach:true})
    $R.children = concat($R.children,[$editd])
    $edit_ready = false
    for $attempt = 1 to 60
      if $n.call("edit","edit.ping",{}).rc == 0 then $edit_ready=true; break end
      sleep(0.1)
    end
    if not $edit_ready then raise("JOINT","Owned editd did not register") end
    $file = $root .. "/joint-document.txt"
    write_file($file,"joint native settings editor\n")
    $ced_log = $root .. "/ced.log"
    $ced_pid = spawn([$bin .. "/ced","--service","ced-settings-geometry",$file],
      {env:$n.client_env($R.session,{HOME:$root .. "/home",MIXOS_APP_HOME:$root .. "/ced-home",
        MIXOS_SETTINGS_INSTANCE:"fixture",MIXOS_SETTINGS_PROFILE:"default",LIBGL_ALWAYS_SOFTWARE:"1"}),
        stdout:{file:$ced_log},stderr:"stdout",detach:true})
    $R.children = concat($R.children,[$ced_pid])
    $ced_row = comp("comp.window.wait",{match:{app_id:"dev.mixos.ced"},until:"presented",timeout_ms:5000}).window
    if $ced_row == nil or $ced_row.pid != $ced_pid then raise("JOINT","Ced window ownership missing") end
    $ced_window = {id:$ced_row.id,generation:$ced_row.generation}
    await_joint($changed)
    $tabs = ced("ced.tabs",{}).tabs
    if len($tabs) != 1 then raise("JOINT","Document not opened exactly once") end
    $tab = $tabs[0].tab
    ced("ced.wait",{tab:$tab,phase:"live",timeout_ms:5000})
    ced("ced.select",{tab:$tab,anchor:5,head:5})
    $document_before = ced("ced.state",{tab:$tab,text:true})
    comp("comp.input.pointer.move",{seat:"human",x:$width-1,y:1})
    capture_joint("joint-current-dark",$changed,$layout,$ced_window,1000)
    $heights = []
    for each $stage in [{mode:"light",scale:1.1,thickness:80,width:1002},{mode:"dark",scale:1.25,thickness:96,width:1000}]
      $offset = len(read_file($probe_log))
      $accepted = apply({"appearance.mode":$stage.mode,"ui.text_scale":$stage.scale,
        "shell.panels.bottom":{edge:"bottom",mode:"dock",thickness:$stage.thickness}},"joint-" .. $stage.mode)
      await_panel("docked",$stage.thickness,$stage.thickness,$accepted.revision)
      $joint_layout = await_layout($stage.thickness)
      $truth = wait_size($width,$height-$stage.thickness,$offset)
      if $truth.outputs[keys($truth.outputs)[0]].usable.height != $height-$stage.thickness then raise("JOINT","Joint work area did not converge") end
      await_joint($accepted)
      capture_joint("joint-" .. $stage.mode,$accepted,$joint_layout,$ced_window,$stage.width)
      push($heights,{app:ced("ced.layout",{tab:$tab}).line_height,shell:$joint_layout.nodes.go.h})
      $document_after = ced("ced.state",{tab:$tab,text:true})
      if ($document_before.buffer != $document_after.buffer or $document_before.rev != $document_after.rev or
        $document_before.text != $document_after.text or not deep_eq($document_before.selection,$document_after.selection)) then
        raise("JOINT","Joint appearance changed document identity/text/caret")
      end
      if shell("shell.panel.state",{edge:"bottom"}).page != $panel.page then raise("JOINT","Joint batch replaced shell page") end
    end
    if $heights[1].app <= $heights[0].app or $heights[1].shell <= $heights[0].shell then raise("JOINT","Text-scale layout metrics did not grow in both hosts") end
    if not ced("app.quit",{}).quitting then raise("JOINT","Ced quit reply missing") end
    for $attempt = 1 to 60
      if not process_alive($ced_pid) then break end
      sleep(0.05)
    end
    if process_alive($ced_pid) or not contains(read_file($ced_log),"CED_SHUTDOWN {\"faults\":[]}") then raise("JOINT","Ced shutdown exceeded budget or reported faults") end
    print("PASS joint native settings: one authority, matching identities, shared captured frame, work area, text layout, retained document/caret")
  end
  print("PASS native settings geometry: matching applied revisions, occupied panel reservation, real configure/slot, captured pixels and stationary pointer leave/click/re-entry")
  $R.ok = true
catch $message
  print("FAIL " .. $message)
  if $R.run != nil then
    for each $log in ["compositor.log","settingsd.log","citizen.log","probe.log","weston.log"]
      if is_file($R.run.path .. "/" .. $log) then print(run_argv(["tail","-n","20",$R.run.path .. "/" .. $log],{max_output:12000}).stdout) end
    end
  end
finally
  for each $child in $R.children
    if exists("/proc/" .. to_string($child)) then kill($child,15) end
  end
  if $R.session != nil then $n.stop($R.session) end
  if $R.bus != nil then $n.stop_bus($R.bus) end
  $n.finish_run($R.run,$R.ok)
end
if not $R.ok then exit(1) end
