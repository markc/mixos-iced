-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- Real native verified-resource rejection and stale held authority preparation.
-- Usage: mix tests/desktop/settings_app_resource_stale_gate.mix REPO BUILD_BIN_DIR [APP]
-- Shared four-app resource matrix, sequential real-worker supersession holds.
if len(args()) < 2 or len(args()) > 3 then raise("ARGS","REPO BUILD_BIN_DIR [term|busviewer|cap|dopus]") end
$repo=args()[0]
$bin=args()[1]
$mix=$bin .. "/mix"
export MIXOS_TEST_MIX=$mix
$n=require("nested_host_lib.mix")
$h=require("settings_host_lib.mix")
$f=require("settings_fixture_lib.mix")
$recovery=require("settings_recovery_lib.mix")
$pty=require("pty_host_lib.mix")
$product=require("settings_apps_lib.mix")
$assets=require("settings_asset_fixture_lib.mix")
$failure=require("settings_failure_lib.mix")
$apps=if len(args()) == 3 then [args()[2]] else ["term","busviewer","cap","dopus"] end
for each $name in $apps
  if not contains(["term","busviewer","cap","dopus"],$name) then raise("ARGS","Unknown app " .. $name) end
end
for each $name in concat(["mix","noded","settingsd","compd"],$apps)
  if not is_file($bin .. "/" .. $name) then raise("SETUP","Missing exact candidate " .. $name) end
end
if contains($apps,"term") then $pty.check_support() end
$binding={instance:"fixture",profile:"default"}
$R={run:nil,desktop:nil,bus:nil,session:nil,authority:nil,package:nil,children:[],ok:false,instance:0}
fn check($condition,$message)
  return $recovery.check($condition,$message)
end
fn fixture_context($name,$directory)
  return {mix:$mix,bus:$R.bus,root:$directory,bus_root:$R.run.path .. "/apps",
    service:if $name == "term" then "term" else $name .. "-recovery" end}
end
fn comp($verb,$body)
  return $h.rpc($mix,$R.desktop,$R.run.path .. "/desktop",$R.session.service,$verb,$body)
end
fn authority($verb,$body)
  return $h.rpc($mix,$R.bus,$R.run.path .. "/apps","settingsd",$verb,$body)
end
fn start_authority()
  $log=$R.run.path .. "/settingsd-" .. to_string($R.instance) .. ".log"
  $child=spawn([$bin .. "/settingsd","serve","--instance","fixture","--root",$R.run.path .. "/profile"],
    {env:$h.bus_env($R.bus,$R.run.path .. "/apps"),stdout:{file:$log},stderr:"stdout",detach:true})
  $R.authority=$child
  $R.children=concat($R.children,[{pid:$child,privileged_launcher:false}])
  $deadline=time()+10
  while time() < $deadline
    check(process_alive($child),"Authority exited: " .. read_file($log))
    $reply=$h.call($mix,$R.bus,$R.run.path .. "/apps","settingsd","settings.get",{binding:$binding})
    if $reply.rc == 0 then return $reply.result.snapshot end
    sleep(0.05)
  end
  raise("AUTHORITY","Owned settings authority did not register")
end
fn stop_authority()
  $h.stop($R.authority)
  $deadline=time()+5
  while time() < $deadline
    $reply=$h.call($mix,$R.bus,$R.run.path .. "/apps","settingsd","settings.get",{binding:$binding})
    if $reply.rc != 0 and $reply.rc != -9 then return end
    sleep(0.05)
  end
  raise("AUTHORITY","Absent authority still answered successfully or broker was unavailable")
end
fn launch($name,$home,$label,$budget)
  for each $dir in ["config","state","cache"]
    mkdir($home .. "/" .. $dir,{parents:true})
  end
  $R.instance=$R.instance+1
  $identity={run:"recovery-" .. to_string(pid()),instance:$R.instance}
  $ctx=fixture_context($name,$R.run.path .. "/" .. $name .. "-" .. $label)
  mkdir($ctx.root,{parents:true})
  $extra=merge($h.bus_env($R.bus,$R.run.path .. "/apps"),{HOME:$home,MIXOS_APP_HOME:$home,
    XDG_DATA_HOME:$R.package.data_home,XDG_DATA_DIRS:$R.run.path .. "/empty-data",MIXOS_SHARE:$R.run.path .. "/owned-share",
    XDG_CONFIG_HOME:$home .. "/config",XDG_STATE_HOME:$home .. "/state",XDG_CACHE_HOME:$home .. "/cache",
    MIXOS_SETTINGS_INSTANCE:"fixture",MIXOS_SETTINGS_PROFILE:"default",LIBGL_ALWAYS_SOFTWARE:"1",
    TERM_NOTIFY:"0",WGPU_BACKEND:"gl",MIXOS_ACCEPTANCE_RUN:$identity.run,
    MIXOS_ACCEPTANCE_INSTANCE:to_string($identity.instance)})
  $env=$n.client_env($R.session,$extra)
  $argv=if $name == "term" then $pty.launch_argv($bin,$env)
    elif $name == "dopus" then [$bin .. "/dopus","--service",$ctx.service,"--noded-url",$R.bus.url,"--",$R.run.path .. "/left",$R.run.path .. "/right"]
    elif $name == "cap" then [$bin .. "/cap","--service",$ctx.service,"--comp",$R.session.service,$R.run.path .. "/source.png"]
    else [$bin .. "/busviewer","--service",$ctx.service,"--comp",$R.session.service] end
  $at=time()
  $log=$ctx.root .. "/app.log"
  $launcher=spawn($argv,{env:$env,stdout:{file:$log},stderr:"stdout",detach:true})
  $R.children=concat($R.children,[{pid:$launcher,privileged_launcher:$name == "term"}])
  -- First presentation is observed through the independent compositor broker, before
  -- app registration or settings descriptions can hide startup latency.
  $row=comp("comp.window.wait",{match:{app_id:"dev.mixos." .. $name},until:"presented",timeout_ms:5000}).window
  $elapsed=(time()-$at)*1000
  check($row != nil and $row.pid != nil,"No actual presented " .. $name .. " owner")
  if $name != "term" then check($row.pid == $launcher,"Window belongs to a different launched process") end
  check($elapsed <= $budget,$name .. " first presentation exceeded " .. to_string($budget) .. "ms: " .. to_string($elapsed))
  $R.children=concat($R.children,[{pid:$row.pid,privileged_launcher:false}])
  $window={id:$row.id,generation:$row.generation}
  comp("comp.window.focus",$window)
  write_file($ctx.root .. "/startup.json",json_encode({pid:$row.pid,launcher:$launcher,
    window:$window,elapsed_ms:$elapsed,budget_ms:$budget,authority_absent:$label != "prime"}))
  return {name:$name,pid:$row.pid,launcher:$launcher,window:$window,context:$ctx,identity:$identity,log:$log}
end
fn owned_app($app)
  return merge($app,{work_root:$R.run.path,desktop:{mix:$mix,bus:$R.desktop,
    root:$R.run.path .. "/desktop",service:$R.session.service}})
end
fn apply($snapshot,$operation,$changes,$reset)
  authority("settings.apply",{binding:$binding,expected_incarnation:$snapshot.incarnation,
    expected_revision:$snapshot.revision,operation_id:$operation,changes:$changes,reset:$reset})
  return authority("settings.get",{binding:$binding}).snapshot
end
try
  $R.run=$n.new_run("/var/tmp/settings-app-resource-stale")
  $root=$R.run.path
  $R.package=$assets.prepare($repo,$root .. "/fixture-data",$mix)
  mkdir($root .. "/empty-data",{parents:true})
  mkdir($root .. "/owned-share",{parents:true})
  $R.desktop=$n.private_bus({dir:$root .. "/desktop",name:"failure-desktop",noded:$bin .. "/noded"})
  mkdir($root .. "/cfg",{parents:true})
  write_file($root .. "/cfg/settings.json",read_file($repo .. "/tests/desktop/smoke-settings.json"))
  write_file($root .. "/cfg/preferences.json",json_encode({scene_host:false,decorations_ssd:false}))
  $R.session=$n.start({bin:$bin .. "/compd",tag:"resource-stale",run:$R.run,
    config:$root .. "/cfg/settings.json",host_renderer:"pixman",software:true,scale:1,max_secs:900})
  check($n.wait_ready($R.session,30) and $R.session.dbus == "","Owned native compositor unavailable")
  comp("comp.props.set",{path:"input.host.passthrough",value:false})
  $R.bus=$n.private_bus({dir:$root .. "/apps",name:"failure-apps",noded:$bin .. "/noded",first_port:$R.desktop.port})
  check($R.bus.port != $R.desktop.port,"Broker isolation failed")
  print(run_argv_must([$bin .. "/settingsd","seed","--allow-create","--instance","fixture","--root",$root .. "/profile"],{timeout:30}))
  for each $dir in ["left","right"]
    mkdir($root .. "/" .. $dir,{parents:true})
  end
  write_file($root .. "/left/owned-file.txt","native recovery file\n")
  run_argv_must(["cp",$repo .. "/share/brand/favicons/white-on-black/icon-512.png",$root .. "/source.png"])
  $snapshot=start_authority()
  $snapshot=apply($snapshot,"failure-prime",{"appearance.mode":"dark","ui.text_scale":1.0},[])
  $owners=[]
  for each $name in $apps
    $app=owned_app(launch($name,$root .. "/home-" .. $name,"prime",5000))
    $description=$recovery.settled($app.context,$app.pid,"current",$snapshot,20)
    $assets.verified($description,$R.package,$name == "dopus")
    $state=$product.prepare_product($app)
    $frame=$recovery.observe($app.context,$app.identity,$description,"verified-baseline")
    $owners=concat($owners,[{app:$app,description:$description,product:$state,frame:$frame}])
  end
  for each $case in ["missing-set","wrong-digest"]
    $set_id=if $case == "missing-set" then "native-acceptance-absent" else $R.package.set_id end
    check($case != "missing-set" or not exists($R.package.root .. "/sets/" .. $set_id),"Missing set already exists")
    $digest=repeat("0",64)
    check($digest != $R.package.manifest_blake3,"Wrong digest accidentally matches verified package")
    $snapshot=apply($snapshot,$case,{"appearance.resources":{schema:1,set_id:$set_id,manifest_blake3:$digest}},[])
    $diagnostic=if $case == "missing-set" then "requested asset set is unavailable" else "manifest digest" end
    for each $owner in $owners
      $app=$owner.app
      comp("comp.window.focus",$app.window)
      $description=$failure.retained($app.context,$app.pid,$snapshot,$owner.description,$diagnostic,20)
      $failure.installed($app.context,$owner.frame.identity,$description,$owner.frame,$case)
      $product.product_retained($app,$owner.product,$case)
      $assets.verified($description,$R.package,$app.name == "dopus")
    end
    $snapshot=apply($snapshot,$case .. "-restore",{},["appearance.resources"])
    $next=[]
    for each $owner in $owners
      $app=$owner.app
      comp("comp.window.focus",$app.window)
      $description=$recovery.settled($app.context,$app.pid,"current",$snapshot,20)
      $assets.verified($description,$R.package,$app.name == "dopus")
      $frame=$recovery.observe($app.context,$app.identity,$description,$case .. "-restored")
      $recovery.same_owner($owner.frame,$frame,$app.pid,$description)
      $product.product_retained($app,$owner.product,$case .. "-restored")
      $next=concat($next,[merge($owner,{description:$description,frame:$frame})])
    end
    $owners=$next
  end
  -- Holds expire after 10s. Test one real worker at a time; all apps remain
  -- alive on the same authority. No slow screenshot or RPC wait during holds.
  $index=0
  for each $owner in $owners
    $app=$owner.app
    comp("comp.window.focus",$app.window)
    $baseline=$recovery.settled($app.context,$app.pid,"current",$snapshot,20)
    $assets.verified($baseline,$R.package,$app.name == "dopus")
    $before=$recovery.observe($app.context,$app.identity,$baseline,"stale-baseline")
    $reference=$failure.hold($app.context,$before.identity,$app.name,"superseded")
    $armed_at=time()
    $waiting=$f.asynchronous($app.context,"barrier.wait",$reference,"stale-reached",12)
    $R.children=concat($R.children,[{pid:$waiting.pid,privileged_launcher:false}])
    $held=apply($snapshot,$app.name .. "-held",{"ui.text_scale":1.1+$index*0.05},[])
    $reached=$f.collect($waiting,4)
    check($reached.rc == 0 and $reached.result.ok and $reached.result.state == "reached" and
      contains($reached.result.observation,"revision=" .. to_string($held.revision)),"Wrong actual held preparation")
    $held_description=$failure.retained($app.context,$app.pid,$held,$baseline,nil,2)
    $failure.installed($app.context,$before.identity,$held_description,$before,"held-old")
    $snapshot=apply($held,$app.name .. "-winner",{"ui.text_scale":1.2+$index*0.05},[])
    $superseded=$failure.retained($app.context,$app.pid,$snapshot,$baseline,nil,2)
    $failure.installed($app.context,$before.identity,$superseded,$before,"held-superseded")
    $product.product_retained($app,$owner.product,"held-superseded")
    check(time()-$armed_at < 8,"Stale schedule approached barrier automatic expiry")
    check($f.fixture($app.context,"barrier.release",$reference).state == "released","Held old preparation did not release")
    $current=$recovery.settled($app.context,$app.pid,"current",$snapshot,20)
    $assets.verified($current,$R.package,$app.name == "dopus")
    $after=$recovery.observe($app.context,$app.identity,$current,"stale-winner")
    $recovery.same_owner($before,$after,$app.pid,$current)
    check($after.target.stamp.activation_epoch == $before.target.stamp.activation_epoch+1,
      "Superseded candidate installed or winning replacement lacked exact one-activation proof")
    $product.product_retained($app,$owner.product,"stale-winner")
    write_file($app.context.root .. "/acceptance.json",json_encode({app:$app.name,verified_package:$R.package,
      missing_resource_last_good:true,wrong_digest_last_good:true,diagnostics:true,
      superseded_preparation_never_installed:true,baseline_stamp:$before.target.stamp,winner_stamp:$after.target.stamp,
      same_pid:true,same_window:true,product_retained:true,exact_frame:true}))
    $index=$index+1
  end
  for each $owner in $owners
    $product.stop_app($owner.app)
  end
  stop_authority()
  write_file($root .. "/acceptance.json",json_encode({apps:$apps,verified_package:$R.package,
    missing_resource:true,wrong_digest:true,stale_authority_preparation:true,stale_connection_preparation:false,dbus:false}))
  $R.ok=true
catch $message
  print("FAIL native app resource/stale: " .. $message)

finally
  for each $child in $R.children
    try
      check($pty.stop_child($child),"Owned child survived teardown")
    catch $error
      $R.ok=false
      print("FAIL owned child teardown: " .. $error)
    end
  end
  if $R.session != nil then
    try
      $n.stop($R.session)
      for each $child in $R.session.pids
        $h.stop($child)
      end
    catch $error
      $R.ok=false
      print("FAIL native host teardown: " .. $error)
    end
  end
  for each $broker in [$R.bus,$R.desktop]
    if $broker != nil then
      try
        $h.stop($broker.pid)
      catch $error
        $R.ok=false
        print("FAIL broker teardown: " .. $error)
      end
    end
  end
  $n.finish_run($R.run,$R.ok)
end
if not $R.ok then exit(1) end
print("PASS selected-app verified resource rejection and stale held authority preparation; physical VT/GPU and stale connection preparation remain separate acceptance")
