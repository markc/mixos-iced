-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Run on a build worker at the exact runtime checkpoint.
$forbidden = []
for each $package in ["compd", "term", "ced", "dopus", "cap", "mix-shell", "noded", "editd"]
  $argv = ["cargo", "tree", "--locked", "-p", $package, "--prefix", "none", "--format", "{p}"]
  if $package == "compd" then
    $argv = concat($argv, ["--no-default-features", "--features", "backend-all"])
  end
  $r = run_argv($argv, {timeout:600,stderr:"stdout"})
  if not $r.ok then print($r.stdout); exit(1) end
  for each $line in lines($r.stdout)
    $name = split($line, " ")[0]
    if contains(["dbus", "dbus-sys", "libdbus-sys", "mpris", "zbus", "zbus_macros", "ashpd"], $name) then
      push($forbidden, $package .. ": " .. $line)
    end
  end
end
if len($forbidden) != 0 then
  print("D-Bus dependencies remain in the native session profile:\n" .. join($forbidden, "\n"))
  exit(1)
end
print("native session Cargo closure: no D-Bus client or portal dependencies")
