-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.2
-- Verify the bundled, unmodified Material Symbols and their per-file receipt.
-- --record deliberately refreshes the receipt after an upstream import.
$root=dirname(dirname(realpath($0)))
if not deep_eq(args(),[]) and not deep_eq(args(),["--check"]) and not deep_eq(args(),["--record"]) then raise("ARGS","--check or --record required") end
$revision="bd8cb85bd4bad964fe6918f79665bb40c3a8efef"
$names=["notifications","notifications_active","volume_off","volume_up","volume_down","volume_mute","wifi","wifi_off","settings_ethernet","desktop_windows","terminal","edit_note","folder_open","screenshot_monitor","apps"]
$files=[]
for each $name in concat($names,["LICENSE"])
  $relative="material/"+$name+if $name == "LICENSE" then "" else ".svg" end
  $path=$root+"/share/icons/"+$relative
  $url="https://raw.githubusercontent.com/google/material-design-icons/"+$revision+"/"+if $name == "LICENSE" then "LICENSE" else "symbols/web/"+$name+"/materialsymbolsrounded/"+$name+"_24px.svg" end
  if $name != "LICENSE" and not starts_with(trim(read_file($path)),"<svg") then raise("SVG",$relative) end
  push($files,{name:$name,path:$relative,url:$url,sha256:hash_file($path,"sha256"),bytes:stat($path).size})
end
for each $weight in [300,200]
  for each $name in $names
    $relative="material/"+to_string($weight)+"/"+$name+".svg"
    $path=$root+"/share/icons/"+$relative
    $url="https://raw.githubusercontent.com/google/material-design-icons/"+$revision+"/symbols/web/"+$name+"/materialsymbolsrounded/"+$name+"_wght"+to_string($weight)+"_24px.svg"
    if not starts_with(trim(read_file($path)),"<svg") then raise("SVG",$relative) end
    push($files,{name:$name+"-"+to_string($weight),path:$relative,url:$url,sha256:hash_file($path,"sha256"),bytes:stat($path).size})
  end
end
$text="-- Generated by tools/material_icons.mix; do not edit.\n"+data_encode({version:1,revision:$revision,upstream:"https://github.com/google/material-design-icons",licence:"Apache-2.0",files:$files})+"\n"
$manifest=$root+"/share/icons/material.conf.mix"
if contains(args(),"--record") then write_atomic($manifest,$text) elif read_file($manifest) != $text then raise("PROVENANCE","Bundled icons differ from the cleared per-file receipt") end
print("PASS 45 pinned Material Symbols (200, 300 and 400) and their Apache-2.0 licence")
