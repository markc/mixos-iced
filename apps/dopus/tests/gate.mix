-- version: 0.1.0
-- Focused DOpus gates, run on a build worker from the current workspace.
$root=dirname(dirname(dirname(dirname(realpath($0)))))
for $command in [
  ["cargo", "fmt", "-p", "dopus", "-p", "dopus-core", "--", "--check"],
  ["cargo", "test", "--locked", "-p", "dopus", "-p", "dopus-core", "-p", "toolkit"],
  ["cargo", "clippy", "--locked", "-p", "dopus", "-p", "dopus-core", "--all-targets", "--no-deps", "--", "-D", "warnings"],
  ["cargo", "build", "--locked", "-p", "dopus", "--release"]
]
  print(join($command, " "))
  print(run_argv_must($command, {cwd: $root, timeout: 7200, stderr: "stdout"}))
end
