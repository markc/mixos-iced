-- Focused DOpus gates. Run from the repository src directory on a build worker.
for $command in [
  ["cargo", "fmt", "-p", "mixos-dopus", "-p", "mixos-dopus-core", "--", "--check"],
  ["cargo", "test", "-p", "mixos-dopus", "-p", "mixos-dopus-core", "-p", "mixos-iced-widgets"],
  ["cargo", "clippy", "-p", "mixos-dopus", "-p", "mixos-dopus-core", "--all-targets", "--", "-D", "warnings"],
  ["cargo", "build", "-p", "mixos-dopus", "--release"]
]
  print(join($command, " "))
  print(run_argv_must($command, {cwd: "desktop", timeout: 7200, stderr: "stdout"}))
end
